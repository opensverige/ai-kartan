{
  "name": "ai-kartan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tech Embassy – Sveriges öppna AI-karta. Alla som bygger AI i Sverige, med källa och datum på varje uppgift.",
  "license": "AGPL-3.0-only",
  "homepage": "https://karta.opensverige.se",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/kopiera-maplibre-worker.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/kopiera-maplibre-worker.mjs",
    "build": "node scripts/validera.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validera": "node scripts/validera.mjs",
    "test": "node --test \"scripts/*.test.mjs\" \"src/lib/*.test.mjs\" \"src/lib/fraga/*.test.mjs\"",
    "andringar": "node scripts/andringar.mjs",
    "farskhet": "node scripts/farskhet.mjs",
    "lankkoll": "node scripts/lankkoll.mjs",
    "prova:fraga": "node --env-file-if-exists=.env scripts/prova-fraga.mjs",
    "importera:infra": "node scripts/importera-infra.mjs",
    "ny": "node scripts/ny-organisation.mjs",
    "delalank": "node scripts/delalank.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.4.0",
    "fontkitten": "^1.0.3",
    "maplibre-gl": "^6.14.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  }
}
