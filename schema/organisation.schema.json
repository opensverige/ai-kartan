{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://karta.opensverige.se/schema/organisation.schema.json",
  "title": "Organisation på AI-kartan",
  "description": "En organisation som bygger AI i Sverige. Varje uppgift är en 'fact' med värde, status, källa och datum, samma uppgiftsmodell som infra.opensverige.se. Schemat saknar medvetet fält för kontaktpersoner, anställda, ägare och e-post.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "website", "description", "offers", "areas", "kommun", "evidence", "record_created_at", "record_updated_at"],
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$", "description": "ÅÅÅÅ-MM-DD" },
    "url": { "type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 500 },
    "status": { "type": "string", "enum": ["confirmed", "claimed", "planned", "unknown", "not_applicable"] },
    "source_type": { "type": "string", "enum": ["company_register", "regulator", "third_party", "academic", "infra_dataset", "own_site", "own_docs", "press", "self_submitted"] },
    "verified_by": { "type": "string", "enum": ["manual", "agent", "scraper", "self"] },
    "fact": {
      "type": "object",
      "description": "En uppgift med proveniens. Återanvänds för varje fält.",
      "required": ["value", "status", "verified_at"],
      "additionalProperties": false,
      "properties": {
        "value": { "description": "Själva värdet. Typen beror på fältet." },
        "status": { "$ref": "#/definitions/status" },
        "source_url": { "$ref": "#/definitions/url" },
        "source_type": { "$ref": "#/definitions/source_type" },
        "verified_at": { "$ref": "#/definitions/date" },
        "verified_by": { "$ref": "#/definitions/verified_by" },
        "note": { "type": "string", "maxLength": 300 },
        "corroborated_at": { "$ref": "#/definitions/date" },
        "corroborated_by": { "$ref": "#/definitions/verified_by" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["confirmed", "claimed", "planned"] } } },
          "then": { "required": ["source_url", "source_type"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["unknown", "not_applicable"] } } },
          "then": { "properties": { "value": { "type": "null" } } }
        }
      ]
    },
    "evidence_item": {
      "type": "object",
      "description": "Ett belägg för kriterium 2: en publik länk till något organisationen byggt med AI. Länken är sin egen källa.",
      "required": ["url", "kind", "verified_at"],
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/definitions/url" },
        "kind": { "type": "string", "enum": ["produkt", "repo", "modell", "dataset", "demo", "publikation", "case", "resurs", "program", "portfolj"] },
        "title": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["confirmed", "claimed"], "default": "claimed" },
        "verified_at": { "$ref": "#/definitions/date" },
        "verified_by": { "$ref": "#/definitions/verified_by" },
        "note": { "type": "string", "maxLength": 300 }
      }
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 2, "maxLength": 60, "description": "Permanent slug. Blir URL:en /organisation/<id>. Ändras aldrig." },
    "name": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": "string", "minLength": 1, "maxLength": 120 } } } ], "description": "Namn så som organisationen själv skriver det." },
    "legal_name": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": ["string", "null"], "maxLength": 160 } } } ], "description": "Registrerat namn, om det skiljer sig från namnet." },
    "type": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": "string", "enum": ["bolag", "enskild_firma", "myndighet", "kommun_region", "larosate", "community", "finansiar", "infrastruktur"] } } } ] },
    "org_number": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": ["string", "null"], "pattern": "^\\d{6}-\\d{4}$" } } } ], "description": "Organisationsnummer. Stiftelser, enskilda firmor och utländska enheter kan sakna det: använd status unknown eller not_applicable." },
    "website": { "$ref": "#/definitions/url", "description": "Organisationens egen webbplats. Identitetsfält utan status." },
    "description": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": "string", "minLength": 20, "maxLength": 300 } } } ], "description": "En till två neutrala meningar på svenska om vad organisationen bygger med AI. Kartans ord, inte organisationens marknadsföring." },
    "offers": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["produkt", "utveckling", "infrastruktur", "data", "forskning", "utbildning", "community", "finansiering", "oppen_kallkod"] } } } } ], "description": "Vad organisationen erbjuder. Filtret på kartan." },
    "areas": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "enum": ["agenter_automation", "datorseende", "energi_klimat", "fastighet_bygg", "fintech", "forsvar_sakerhet", "handel", "halsa", "industri", "jordbruk_skog", "juridik", "media_kreativt", "offentlig_sektor", "robotik", "sprakteknik", "transport_mobilitet", "utbildning", "generell"] } } } } ], "description": "Tillämpningsområden." },
    "kommun": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": ["string", "null"], "pattern": "^\\d{4}$" } } } ], "description": "SCB:s fyrsiffriga kommunkod för sätet, inom citattecken. Län härleds ur koden. Positionen på kartan är kommunens mittpunkt, aldrig en gatuadress." },
    "coordinates": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": "object", "required": ["lat", "lng"], "additionalProperties": false, "properties": { "lat": { "type": "number", "minimum": 55, "maximum": 69.5 }, "lng": { "type": "number", "minimum": 10.5, "maximum": 24.5 } } } } } ], "description": "Exakt position. Bara för organisationer som själva publicerar en kontorsadress, aldrig för enskilda firmor." },
    "founded": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": ["integer", "null"], "minimum": 1477, "maximum": 2100 } } } ], "description": "Grundat eller registrerat år." },
    "active": { "allOf": [ { "$ref": "#/definitions/fact" }, { "properties": { "value": { "type": ["boolean", "null"] } } } ], "description": "Finns organisationen kvar? false = nedlagd eller avregistrerad; posten ligger kvar markerad tills den tas bort." },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/definitions/evidence_item" }, "description": "Belägg för att organisationen byggt något med AI. Minst ett krävs." },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "description": "Publika kanaler för organisationen, aldrig för personer.",
      "properties": {
        "github": { "$ref": "#/definitions/url" },
        "huggingface": { "$ref": "#/definitions/url" },
        "linkedin": { "$ref": "#/definitions/url" },
        "wikidata": { "type": "string", "pattern": "^Q\\d+$" },
        "infra_id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Id på infra.opensverige.se om organisationen även finns där." }
      }
    },
    "self_submitted": { "type": "boolean", "description": "true när organisationen själv skickat in posten. Obligatoriskt true för enskild firma." },
    "record_created_at": { "$ref": "#/definitions/date" },
    "record_updated_at": { "$ref": "#/definitions/date" }
  }
}
