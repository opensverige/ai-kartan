      if (palett.tillstand() === 'tom') ritaTom();
      if (palett.tillstand() === 'forslag') ritaForslag(input.value.trim());
    });
    // Loggan går tillbaka till första skärmen, utan urval, i stället för att ladda om sidan.
    document.querySelector<HTMLAnchorElement>('.marke')?.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      stang();
      input.value = '';
      palett.glom();
      byt('hem', (k) => k.aterstall(TOMT_FILTER));
    });

