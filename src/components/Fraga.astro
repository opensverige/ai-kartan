---
// Fråga kartan: första skärmen och sökpaletten (specen 3.1–3.8). Paletten är som Mobbins sökruta:
// ett fält och en lista. Medan man skriver visas träffar direkt och "Fråga AI" överst, och svaret
// står i samma lista. Varje fråga står för sig. Allt syns bara på kartsidan, där Bas.astro sätter
// html[data-fraga]. Utan flaggan, på andra sidor och utan JavaScript, gör skriptet ingenting.
import { SAJT } from '../lib/data';
---

<section class="ingang" aria-labelledby="ingang-rubrik" data-discord={SAJT.discord}>
  <div class="ingang__inre">
    <h1 class="ingang__rubrik" id="ingang-rubrik">Fråga Sveriges AI-karta</h1>
    <button type="button" class="ingang__falt" data-fraga-oppna aria-haspopup="dialog" aria-label="Fråga kartan med egna ord">
      <span class="fraga-glyf" aria-hidden="true">✦</span>
      <span class="ingang__exempel" id="fraga-exempel" aria-hidden="true">Fråga med egna ord …</span>
      <span class="ingang__pil" aria-hidden="true">→</span>
    </button>
    <div class="ingang__under">
      <span class="ingang__ai"><i aria-hidden="true"></i>AI · svarar med länkar till källorna</span>
      <button type="button" class="ingang__utforska" id="fraga-utforska">eller utforska kartan själv <span aria-hidden="true">→</span></button>
    </div>
  </div>
</section>

<dialog class="palett" id="palett" aria-label="Sök eller fråga kartan">
  <div class="palett__ruta">
    <form class="palett__falt" id="palett-form" role="search">
      <span class="fraga-glyf" aria-hidden="true">✦</span>
      <label class="visuellt-dold" for="palett-sok">Sök eller fråga med egna ord</label>
      <input
        id="palett-sok"
        type="text"
        autocomplete="off"
        autocapitalize="sentences"
        spellcheck="false"
        enterkeyhint="search"
        placeholder="Sök eller fråga med egna ord …"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
      />
      <button type="button" class="palett__stang" data-stang aria-label="Stäng"><kbd>esc</kbd></button>
      <button type="button" class="palett__avbryt" data-stang>Avbryt</button>
    </form>
    <div class="palett__kropp" id="palett-kropp"></div>
    <div class="palett__vidare" id="palett-vidare" hidden></div>
    <p class="palett__fot">
      <span class="palett__tangenter" aria-hidden="true"><kbd>↑</kbd> <kbd>↓</kbd> välj · <kbd>↵</kbd> öppna · <kbd>esc</kbd> stäng</span>
      <span id="palett-not">AI kan ta fel. Fakta och status kommer från kartans källor.</span>
    </p>
    <p class="visuellt-dold" id="palett-besked" role="status"></p>
  </div>
</dialog>

<script>
  import { TOMT_FILTER, type Filter } from '../lib/filter';
  import { MAX_TECKEN, type Fragedata, type Svar } from '../lib/fraga/typer';
  import { HANDLING, ORG, REDO, kartgranssnitt, type Kartgranssnitt, type Kartrad } from '../lib/fraga/kartgranssnitt';
  import { chipsHtml, esc, forslagHtml, ingenAnslutningHtml, svarHtml, type Lankar, type Svarsvy, type Vyetiketter } from '../lib/fraga/vy';
  import { skapaKlient } from '../lib/fraga/klient';
  import { skapaPalettlage } from '../lib/fraga/palettlage';

  type Lage = 'hem' | 'karta';
  type Flik = 'omraden' | 'typer' | 'lan';

  /** Exemplen i första skärmens fält och pillren i den tomma paletten: [pillret, frågan]. Specen 3.1. */
  const EXEMPEL: readonly (readonly [string, string])[] = [
    ['Röstagenter på svenska', 'Vilka bygger röstagenter på svenska?'],
    ['GPU-kapacitet i Sverige', 'Jag behöver GPU-kapacitet i Sverige'],
    ['AI inom hälsa i Göteborg', 'AI inom hälsa i Göteborg'],
    ['Bolla en idé med builders', 'Var kan jag bolla en idé med builders?'],
    ['Vad är OpenSverige?', 'Vad är OpenSverige?'],
  ];
  /** Kommer kartans data inte inom så lång tid blir svaret Ingen anslutning (specen 3.8). */
  const VANTA_MS = 10000;

  const rot = document.documentElement;
  const dialog = document.querySelector<HTMLDialogElement>('#palett');
  const app = document.querySelector<HTMLElement>('.app');
  if (rot.dataset.fraga && dialog && app) starta(dialog, app);

  function starta(dialog: HTMLDialogElement, app: HTMLElement) {
    const form = dialog.querySelector<HTMLFormElement>('#palett-form')!;
    const input = dialog.querySelector<HTMLInputElement>('#palett-sok')!;
    const kropp = dialog.querySelector<HTMLElement>('#palett-kropp')!;
    const vidare = dialog.querySelector<HTMLElement>('#palett-vidare')!;
    const not = dialog.querySelector<HTMLElement>('#palett-not')!;
    const besked = dialog.querySelector<HTMLElement>('#palett-besked')!;
    const exempel = document.querySelector<HTMLElement>('#fraga-exempel');
    const NOT = not.textContent ?? '';
    const etiketter = JSON.parse(document.getElementById('etiketter')?.textContent || '{}') as Vyetiketter;
    const kartbas = app.dataset.kartbas || '/';
    const lankar: Lankar = {
      // Absolut, eftersom kopian till Discord ska gå att följa utanför sajten.
      kartbas: new URL(kartbas, location.href).href,
      orgbas: app.dataset.orgbas || `${kartbas}organisation/`,
      bidra: app.dataset.bidra || `${kartbas}bidra`,
      discord: document.querySelector<HTMLElement>('.ingang')?.dataset.discord ?? '',
      infra: app.dataset.infra || 'https://infra.opensverige.se',
      infralogo: app.dataset.infralogo || `${kartbas}ai-infra.png`,
    };
    const stilla = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Samma dag som servern räknar med, så att dagens urval blir detsamma i reservvägen.
    const idag = (): string => new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Stockholm' }).format(new Date());
    const lage = (): Lage => (rot.dataset.fragelage === 'hem' ? 'hem' : 'karta');

    // Vad paletten visar och vilket svar som får ritas. Besluten står i palettlage.ts.
    const palett = skapaPalettlage<{ svar: Svar; vy: Svarsvy }>();
    let aktiv = -1;
    let flik: Flik = 'omraden';
    let bladval: Filter[] = [];

    /* ---------- Data och klienten ---------- */

    let fragedata: Promise<Fragedata> | null = null;
    function hamtaFragedata(): Promise<Fragedata> {
      if (!fragedata) {
        const hamtning = fetch(`${kartbas}api/fraga-data.json`).then((r) => {
          if (!r.ok) throw new Error(`fraga-data svarade ${r.status}`);
          return r.json() as Promise<Fragedata>;
        });
        // Ett misslyckat försök ska inte fastna: nästa fråga försöker igen.
        hamtning.catch(() => (fragedata = null));
        fragedata = hamtning;
      }
      return fragedata;
    }

    function vantaPaPoster(): Promise<readonly Kartrad[]> {
      const k = kartgranssnitt();
      if (k?.redo) return Promise.resolve(k.poster());
      return new Promise((resolve, reject) => {
        const klar = (): void => {
          window.clearTimeout(vakt);
          resolve(kartgranssnitt()?.poster() ?? []);
        };
        const vakt = window.setTimeout(() => {
          document.removeEventListener(REDO, klar);
          reject(new Error('Kartans data kom inte'));
        }, VANTA_MS);
        document.addEventListener(REDO, klar, { once: true });
      });
    }

    const klient = skapaKlient({
      adress: `${kartbas}api/fraga`,
      // Reservvägen: samma motor i webbläsaren, utan modell. Den laddas först när den behövs.
      lokalt: async (k) => {
        const [poster, fd, { svara }] = await Promise.all([vantaPaPoster(), hamtaFragedata(), import('../lib/fraga/motor')]);
        const data = { poster, etiketter: fd.etiketter, faqIds: fd.faq.map((f) => f.id), kommuner: fd.kommuner, lan: fd.lan };
        return svara(k.fraga, k.tidigare, data, null, idag());
      },
    });

    /* ---------- Sidans lägen ---------- */

    /** Byter läge. När kartytan har fått sin nya storlek görs `sedan`, till exempel att öppna en organisation. */
    function byt(nytt: Lage, sedan?: (k: Kartgranssnitt) => void, ramaIn = false): void {
      const andrat = lage() !== nytt;
      rot.dataset.fragelage = nytt;
      if (andrat && nytt === 'hem') skrivExempel();
      requestAnimationFrame(() => {
        const k = kartgranssnitt();
        if (!k) return;
        if (andrat) k.passa(ramaIn && !sedan);
        sedan?.(k);
      });
    }

    // Exemplen skrivs ut i första skärmens fält, ett i taget. Med stillastående rörelse står ett kvar.
    let exempelvakt = 0;
    let exempelNr = 0;
    function skrivExempel(): void {
      if (!exempel) return;
      window.clearTimeout(exempelvakt);
      if (stilla.matches) {
        exempel.textContent = `Fråga med egna ord, till exempel: ${EXEMPEL[0][1]}`;
        return;
      }
      const text = EXEMPEL[exempelNr % EXEMPEL.length][1];
      let n = 0;
      const skriv = (): void => {
        if (lage() !== 'hem') return;
        n += 1;
        exempel.textContent = text.slice(0, n);
        exempelvakt = window.setTimeout(n < text.length ? skriv : sudda, n < text.length ? 42 + Math.random() * 40 : 2000);
      };
      const sudda = (): void => {
        if (lage() !== 'hem') return;
        n -= 1;
        exempel.textContent = text.slice(0, n) || '​';
        if (n > 0) exempelvakt = window.setTimeout(sudda, 18);
        else {
          exempelNr += 1;
          exempelvakt = window.setTimeout(skrivExempel, 280);
        }
      };
      skriv();
    }

    /* ---------- Paletten ---------- */

    function oppna(): void {
      if (!dialog.open) dialog.showModal();
      kartgranssnitt()?.handling('ai');
      input.focus();
      input.select();
      visa();
    }
    const stang = (): void => {
      if (dialog.open) dialog.close();
    };

    /** Det som ska stå i paletten för texten i fältet. */
    function visa(): void {
      const q = input.value.trim();
      uppdateraNot(q);
      const v = palett.visa(q);
      if (v.sort === 'svar') return ritaSvar(v.sparat.vy);
      if (v.sort === 'tom') return ritaTom();
      if (v.sort === 'forslag') ritaForslag(v.q);
    }

    const val = (): HTMLElement[] => [...kropp.querySelectorAll<HTMLElement>('[role="option"]')];

    function markera(i: number): void {
      const rader = val();
      if (!rader.length) return;
      aktiv = ((i % rader.length) + rader.length) % rader.length;
      rader.forEach((r, n) => r.setAttribute('aria-selected', String(n === aktiv)));
      input.setAttribute('aria-activedescendant', rader[aktiv].id);
      rader[aktiv].scrollIntoView({ block: 'nearest' });
    }

    /** Ny lista i paletten: raderna får id, och den första markeras när Enter ska välja den. */
    function nyLista(markeraForsta: boolean): void {
      const rader = val();
      rader.forEach((r, n) => (r.id = `palett-val-${n}`));
      input.setAttribute('aria-expanded', String(rader.length > 0));
      // Listan finns bara när det finns rader att välja. Annars pekar fältet inte på något.
      if (rader.length) input.setAttribute('aria-controls', 'palett-lista');
      else input.removeAttribute('aria-controls');
      input.removeAttribute('aria-activedescendant');
      aktiv = -1;
      if (markeraForsta) markera(0);
    }

    function ritaTom(): void {
      const poster = kartgranssnitt()?.poster() ?? [];
      const rakna = (falt: (o: Kartrad) => readonly (string | null)[]): [string, number][] => {
        const m = new Map<string, number>();
        for (const o of poster) for (const v of falt(o)) if (v) m.set(v, (m.get(v) ?? 0) + 1);
        return [...m].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'sv'));
      };
      const flikar: Record<Flik, { namn: string; tecken: string; rader: { text: string; antal: number; filter: Filter }[] }> = {
        omraden: {
          namn: 'Områden',
          tecken: '◇',
          rader: rakna((o) => o.a)
            .filter(([id]) => etiketter.omraden[id])
            .map(([id, antal]) => ({ text: etiketter.omraden[id], antal, filter: { ...TOMT_FILTER, omrade: [id] } })),
        },
        typer: {
          namn: 'Typer',
          tecken: '○',
          rader: rakna((o) => [o.t]).map(([id, antal]) => ({ text: etiketter.typerPlural[id] ?? etiketter.typer[id] ?? id, antal, filter: { ...TOMT_FILTER, typ: [id] } })),
        },
        lan: {
          namn: 'Län',
          tecken: '⌖',
          rader: rakna((o) => [o.l])
            .filter(([kod]) => etiketter.lan[kod])
            .map(([kod, antal]) => ({ text: etiketter.lan[kod], antal, filter: { ...TOMT_FILTER, lan: kod } })),
        },
      };
      const vald = flikar[flik];
      bladval = vald.rader.map((r) => r.filter);
      const piller = vald.rader.map((r, i) => `<button type="button" class="palett-chip" data-blad="${i}">${esc(r.text)} <small>${r.antal}</small></button>`).join('');
      const nav = (Object.keys(flikar) as Flik[])
        .map((id) => `<button type="button" data-flik="${id}" aria-pressed="${id === flik}"><i aria-hidden="true">${flikar[id].tecken}</i>${flikar[id].namn}</button>`)
        .join('');
      kropp.innerHTML =
        `<p class="palett__rubrik">Prova att fråga</p>${chipsHtml(EXEMPEL)}` +
        `<div class="palett-blad"><div class="palett-blad__nav" role="group" aria-label="Bläddra i kartan">${nav}</div>` +
        `<div><p class="palett__rubrik">${vald.namn} på kartan</p>` +
        (piller ? `<div class="palett-chips">${piller}</div>` : '<p class="palett__vantar"><span aria-hidden="true">✦</span>Kartan laddar …</p>') +
        `</div></div>`;
      vidare.hidden = true;
      vidare.replaceChildren();
      nyLista(false);
    }

    function ritaForslag(q: string): void {
      const t = kartgranssnitt()?.sok(q) ?? { org: [], platser: [] };
      kropp.innerHTML = forslagHtml(q, t.org.slice(0, 5), t.platser.slice(0, 3), etiketter, lankar);
      vidare.hidden = true;
      vidare.replaceChildren();
      nyLista(true);
    }

    function ritaSvar(v: Svarsvy): void {
      kropp.innerHTML = v.kropp;
      vidare.innerHTML = v.vidare;
      vidare.hidden = !v.vidare;
      kropp.scrollTop = 0;
      nyLista(false);
    }

    async function fraga(text: string): Promise<void> {
      const q = text.trim();
      const start = palett.fraga(q);
      if (start.sort === 'ingen') return;
      input.value = q;
      uppdateraNot(q);
      if (start.sort === 'svar') return ritaSvar(start.sparat.vy);
      kropp.innerHTML = '<p class="palett__vantar"><span aria-hidden="true">✦</span>Söker i kartan …</p>';
      vidare.hidden = true;
      vidare.replaceChildren();
      nyLista(false);
      besked.textContent = 'Söker i kartan …';
      try {
        const [svar, poster, fd] = await Promise.all([
          klient.fraga({ fraga: q, tidigare: [] }),
          vantaPaPoster(),
          hamtaFragedata().catch(() => null),
        ]);
        if (!svar || !palett.aktuell(start.stalld)) return;
        const vy = svarHtml(svar.svar, svar.lage, new Map(poster.map((o) => [o.id, o])), fd?.faq ?? [], etiketter, lankar, q);
        palett.svarat(start.stalld, { svar: svar.svar, vy });
        ritaSvar(vy);
        besked.textContent = vy.besked;
        kartgranssnitt()?.handelser.fragaStalld(svar.svar.sort);
      } catch {
        if (!palett.misslyckad(start.stalld)) return;
        kropp.innerHTML = ingenAnslutningHtml();
        besked.textContent = 'Ingen anslutning just nu.';
      }
    }

    /** Räknaren längst ner från 260 tecken. Den läses upp när läget byts, inte för varje tecken. */
    let sistaNot = '';
    function uppdateraNot(q: string): void {
      const n = q.length;
      const rakna = n > MAX_TECKEN ? 'Frågan är för lång. Korta den lite.' : n >= MAX_TECKEN - 40 ? `${MAX_TECKEN - n} tecken kvar` : '';
      not.textContent = rakna || NOT;
      not.classList.toggle('palett__not--rakna', Boolean(rakna));
      const nu = n > MAX_TECKEN ? 'lang' : rakna ? 'rakna' : '';
      if (nu !== sistaNot) {
        sistaNot = nu;
        if (rakna) besked.textContent = rakna;
      }
    }

    function valj(rad: HTMLElement): void {
      // Raden till AI-Infra är en länk. Enter öppnar den som ett klick.
      if (rad.hasAttribute('data-infrarad')) return rad.click();
      if (rad.hasAttribute('data-fraga')) {
        if (rad.getAttribute('aria-disabled') !== 'true') void fraga(input.value);
        return;
      }
      const org = rad.dataset.org;
      if (org) {
        // En rad i ett svar räknas som ett klick i svaret. En rad bland förslagen är en vanlig sökning.
        const iSvaret = palett.tillstand() === 'svar';
        if (iSvaret) kartgranssnitt()?.handelser.fragaKlick('organisation');
        stang();
        return byt('karta', (k) => k.oppnaOrg(org, iSvaret ? null : 'sok'));
      }
      const [typ, kod] = (rad.dataset.plats ?? '').split(':');
      if (kod) {
        stang();
        byt('karta', (k) => k.aterstall(typ === 'lan' ? { ...TOMT_FILTER, lan: kod } : { ...TOMT_FILTER, kommun: kod }));
      }
    }

    async function kopiera(knapp: HTMLButtonElement): Promise<void> {
      const forut = knapp.textContent;
      try {
        await navigator.clipboard.writeText(knapp.dataset.kopiera ?? '');
        knapp.textContent = 'Kopierad';
      } catch {
        knapp.textContent = 'Gick inte att kopiera';
      }
      window.setTimeout(() => (knapp.textContent = forut), 2400);
    }

    /* ---------- Händelser i paletten ---------- */

    input.addEventListener('input', visa);
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      const steg = e.key === 'ArrowDown' ? 1 : -1;
      markera(aktiv < 0 ? (steg > 0 ? 0 : -1) : aktiv + steg);
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const rad = aktiv >= 0 ? val()[aktiv] : undefined;
      if (rad) valj(rad);
      else void fraga(input.value);
    });
    // Esc stänger paletten. Kartan under ska inte också reagera på samma tryck.
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') e.stopPropagation();
    });
    kropp.addEventListener('mousemove', (e) => {
      const rad = (e.target as HTMLElement).closest<HTMLElement>('[role="option"]');
      const i = rad ? val().indexOf(rad) : -1;
      if (i >= 0 && i !== aktiv) markera(i);
    });
    dialog.addEventListener('click', (e) => {
      const mal = e.target as HTMLElement;
      // Ytan runt rutan hör till dialogen själv. Ett klick där stänger.
      if (mal === dialog || mal.closest('[data-stang]')) return stang();
      // AI-Infra öppnas i en ny flik som vanligt. Klicket räknas som en länk ut.
      if (mal.closest('[data-infrarad]')) return kartgranssnitt()?.handelser.utlank('ai-infra');
      const kartlank = mal.closest<HTMLAnchorElement>('a[data-kartlank]');
      if (kartlank) {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        kartgranssnitt()?.handelser.fragaKlick('alla_pa_kartan');
        const senaste = palett.senaste();
        const f = kartlank.dataset.kartlank === 'svar' && senaste ? senaste.svar.filter : TOMT_FILTER;
        stang();
        return byt('karta', (k) => k.aterstall(f));
      }
      const skicka = mal.closest<HTMLElement>('[data-skicka]');
      if (skicka) {
        void fraga(skicka.dataset.skicka ?? '');
        return input.focus();
      }
      const blad = mal.closest<HTMLElement>('[data-blad]');
      const bladfilter = blad ? bladval[Number(blad.dataset.blad)] : undefined;
      if (bladfilter) {
        stang();
        return byt('karta', (k) => k.aterstall(bladfilter));
      }
      const nyFlik = mal.closest<HTMLElement>('[data-flik]')?.dataset.flik;
      if (nyFlik === 'omraden' || nyFlik === 'typer' || nyFlik === 'lan') {
        flik = nyFlik;
        return ritaTom();
      }
      if (mal.closest('[data-forsok]')) {
        void fraga(input.value);
        return input.focus();
      }
      // Länken till Discord öppnas som vanligt. Klicket räknas bara.
      if (mal.closest('[data-klick="discord"]')) return kartgranssnitt()?.handelser.fragaKlick('discord');
      const kopieraKnapp = mal.closest<HTMLButtonElement>('[data-kopiera]');
      if (kopieraKnapp) {
        kartgranssnitt()?.handelser.fragaKlick('kopiera');
        return void kopiera(kopieraKnapp);
      }
      const tumme = mal.closest<HTMLButtonElement>('[data-tumme]');
      if (tumme) {
        // Bara det första valet per svar räknas, så att ett ångrat tryck inte blir två svar.
        const svar = tumme.dataset.tumme;
        const forsta = !tumme.parentElement?.querySelector('[aria-pressed="true"]');
        if (forsta && (svar === 'ja' || svar === 'nej')) kartgranssnitt()?.handelser.fragaTumme(svar);
        tumme.parentElement?.querySelectorAll('[data-tumme]').forEach((b) => b.setAttribute('aria-pressed', String(b === tumme)));
        return;
      }
      const rad = mal.closest<HTMLElement>('[role="option"]');
      if (rad) valj(rad);
    });

    /* ---------- Händelser på sidan ---------- */

    // Fältet på första skärmen och sidhuvudets knapp öppnar paletten. Sidhuvudets ⌘K trycker på knappen.
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-fraga-oppna]')) oppna();
    });
    document.getElementById('fraga-utforska')?.addEventListener('click', () => byt('karta', undefined, true));
    // Den som drar, zoomar, trycker på en prick eller öppnar en organisation lämnar första skärmen.
    // Att öppna paletten räknas också som en handling, men den lämnar inte första skärmen.
    document.addEventListener(HANDLING, (e) => lage() === 'hem' && (e as CustomEvent<string>).detail !== 'ai' && byt('karta'));
