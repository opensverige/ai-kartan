---
// Det som sidorna under /uppdrag delar: namnen på kommuner och områden, som korten slår upp,
// och stilen för korten och formuläret. Korten ritas i webbläsaren, så stilen är global.
import { hamtaData } from '../lib/data';
import type { Etiketter } from '../lib/uppdragkort';

const d = hamtaData();
const etiketter: Etiketter = {
  kommuner: Object.fromEntries(d.kommuner.map((k) => [k.kod, k.namn])),
  omraden: Object.fromEntries(d.taxonomi.omraden.map((o) => [o.id, o.label])),
};
---

<script type="application/json" id="uppdrag-etiketter" set:html={JSON.stringify(etiketter)} />

<style is:global>
  /* En regel med display får inte vinna över hidden, som sidornas skript sätter. */
  :is(.uppdrag__filter, .redigera, .uppdragsform, .besked, .knapp)[hidden] {
    display: none !important;
  }
  .profiler {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 22px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 560px) {
    .profiler {
      grid-template-columns: 1fr 1fr;
      gap: 14px 12px;
    }
  }

  /* Samlarkortet: bilden stor, namnet och en rad under. Ritas av src/lib/uppdragkort.ts. Det
     kompakta kortet vid handen på kartan står i global.css. Utan bild står pixelhanden. */
  .samlarkort {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--kant));
    border-radius: 20px;
    background: #fbf8f1;
    color: hsl(var(--ink));
  }
  .samlarkort__bild {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #1e1d19;
  }
  .samlarkort__bild-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .samlarkort:hover .samlarkort__bild-foto {
      transform: scale(1.04);
    }
  }
  .samlarkort__bild-hand {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 76%;
    transform: translateX(-50%);
  }
  .samlarkort__ort {
    position: absolute;
    top: 10px;
    left: 10px;
    max-width: calc(100% - 20px);
    padding: 5px 8px;
    border-radius: var(--r-pill);
    background: hsl(0 0% 100% / 0.9);
    color: hsl(var(--ink));
    font: 500 11px/1.2 var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .samlarkort__text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px 14px;
  }
  .samlarkort__namn {
    margin: 0;
    color: hsl(var(--ink));
    font: 650 18px/1.2 var(--font-sans);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .samlarkort__rubrik {
    margin: 0;
    color: hsl(var(--ink-soft));
    font-size: 14.5px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .samlarkort__fot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: auto 0 0;
    padding-top: 8px;
  }
  .samlarkort__lank {
    color: hsl(var(--moss));
    font: 650 14.5px/1.3 var(--font-sans);
    text-decoration: none;
  }
  .samlarkort__lank:hover {
    text-decoration: underline;
  }
  .samlarkort__lank[aria-disabled='true'] {
    cursor: default;
    text-decoration: none;
  }
  .samlarkort__bolag {
    color: hsl(var(--ink-mute));
    font: 400 11.5px/1.3 var(--font-mono);
    overflow-wrap: anywhere;
  }
  a.samlarkort__bolag:hover {
    color: hsl(var(--ink));
  }
  @media (max-width: 560px) {
    .samlarkort {
      border-radius: 16px;
    }
    .samlarkort__ort {
      top: 8px;
      left: 8px;
      padding: 4px 6px;
      font-size: 10px;
    }
    .samlarkort__text {
      padding: 10px 11px 12px;
    }
    .samlarkort__namn {
      font-size: 16px;
    }
    .samlarkort__rubrik {
      font-size: 13.5px;
    }
    .samlarkort__bolag {
      display: none;
    }
  }

  /* Figurväljaren i formuläret. Valet är en vanlig radioknapp, så att tangentbordet fungerar. */
  /* Bildvalet i formuläret: bilden som den syns, och två vägar att få in en. */
  .bildval {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
  }
  .bildval__visning {
    position: relative;
    flex: none;
    width: 96px;
    height: 96px;
    overflow: hidden;
    border-radius: 18px;
    background: #1e1d19;
  }
  .bildval__visning img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bildval__visning img.bildval__hand {
    object-fit: contain;
    object-position: 50% 100%;
    padding: 8px 4px 0;
  }
  .bildval__vagar {
    display: grid;
    flex: 1;
    gap: 10px;
    min-width: 220px;
  }
  .bildval__x {
    display: flex;
    gap: 8px;
  }
  .bildval__x input {
    flex: 1;
    min-width: 0;
  }
  .bildval__fil {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .bildval__fil:focus-visible + .knapp {
    outline: 2px solid hsl(var(--moss));
    outline-offset: 2px;
  }

  /* Formulären */
  .uppdragsform {
    display: grid;
    gap: 18px;
    max-width: 560px;
  }
  .uppdragsform fieldset {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .uppdragsform legend,
  .falt__etikett {
    padding: 0;
    color: hsl(var(--ink));
    font-weight: 600;
    font-size: 15px;
  }
  .falt {
    display: grid;
    gap: 6px;
  }
  .falt__hjalp {
    margin: 0;
    font-size: 13.5px;
    color: hsl(var(--ink-mute));
  }
  .falt__fel {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    color: hsl(var(--rust));
  }
  .uppdragsform input[type='text'],
  .uppdragsform input[type='email'],
  .uppdragsform input[type='url'],
  .uppdragsform select {
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    border: 1.5px solid hsl(var(--rule));
    border-radius: var(--r-btn);
    background: hsl(var(--bg));
    color: hsl(var(--ink));
    font: 400 16px/1.3 var(--font-sans);
  }
  .uppdragsform input:focus-visible,
  .uppdragsform select:focus-visible {
    outline: 0;
    border-color: hsl(var(--moss));
    box-shadow: 0 0 0 3px hsl(var(--moss) / 0.15);
  }
  .uppdragsform [aria-invalid='true'] {
    border-color: hsl(var(--rust));
  }
  .val {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.4;
    cursor: pointer;
  }
  .val input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: hsl(var(--moss));
  }
  .valrutnat {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 8px 16px;
  }
  .val:has(input:disabled) {
    color: hsl(var(--ink-mute));
    cursor: default;
  }
  .honung {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .besked {
    padding: 16px 18px;
    border-radius: var(--r-card);
    background: hsl(var(--bg-soft));
    border-left: 3px solid hsl(var(--moss));
  }
  .besked--fel {
    border-left-color: hsl(var(--rust));
  }
  .besked p {
    margin: 0;
  }
  .besked p + p {
    margin-top: 8px;
  }
  .knapp:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .knapp--fara {
    background: transparent;
    border-color: hsl(var(--rust) / 0.5);
    color: hsl(var(--rust));
  }
  .knapp--fara:hover {
    background: hsl(var(--rust) / 0.08);
    border-color: hsl(var(--rust));
    color: hsl(var(--rust));
  }
</style>
