---
// Det som sidorna under /uppdrag delar: namnen på kommuner och områden, som raderna och sökningen
// slår upp, och stilen för raderna och formuläret. Raderna ritas i webbläsaren, så stilen är global.
import { hamtaData } from '../lib/data';
import type { Etiketter } from '../lib/uppdragkort';

const d = hamtaData();
const etiketter: Etiketter = {
  kommuner: Object.fromEntries(d.kommuner.map((k) => [k.kod, k.namn])),
  omraden: Object.fromEntries(d.taxonomi.omraden.map((o) => [o.id, o.label])),
};
---

<script type="application/json" id="uppdrag-etiketter" set:html={JSON.stringify(etiketter)} />

<style is:global>
  /* En regel med display får inte vinna över hidden, som sidornas skript sätter. */
  :is(.uppdrag__sok, .redigera, .uppdragsform, .besked, .knapp, .falt, .bildval__x, .lankknapp, .ordval)[hidden] {
    display: none !important;
  }

  /* Den mörka sidan som listan, länksteget och formuläret delar. Den bryter med flit mot resten
     av kartan. color-scheme gör att webbläsarens egna reglage, som listan i en select, också blir
     mörka. Klippningen i sidled skapar ingen rullyta, så att det som ska stå kvar när man rullar gör det. */
  .morka {
    padding: 34px 0 60px;
    overflow-x: clip;
    background: #141310;
    color: #e9e5da;
    color-scheme: dark;
  }
  /* Länksteget och formuläret är korta sidor. Den mörka ytan når ändå ner till sidfoten. */
  .morka--hel {
    min-height: calc(100vh - var(--huvud-h));
    min-height: calc(100dvh - var(--huvud-h));
  }
  .morka :focus-visible {
    outline-color: #f6f2e8;
  }
  /* Raderna läses lättast i en spalt som inte är bredare än en rad text orkar. */
  .morka__ram {
    max-width: 1080px;
  }
  .morka__ram--smal {
    max-width: 660px;
  }
  .morka__kicker {
    margin: 0;
    color: #a39f92;
    font: 500 12px/1.2 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .morka h1 {
    margin: 12px 0 0;
    color: #f6f2e8;
    font: 650 clamp(36px, 4.6vw, 54px) / 1 var(--font-sans);
    letter-spacing: -0.035em;
  }
  .morka__ingress {
    max-width: 54ch;
    margin: 12px 0 0;
    color: #c9c4b6;
    font-size: 16.5px;
    line-height: 1.5;
  }
  .morka a {
    color: #f6f2e8;
  }
  .morka .knapp {
    border-color: #f6f2e8;
    background: #f6f2e8;
    color: #141310;
  }
  .morka .knapp:hover {
    border-color: #ffffff;
    background: #ffffff;
    color: #141310;
  }
  .morka .knapp--ghost {
    border-color: #4a473f;
    background: transparent;
    color: #f6f2e8;
  }
  .morka .knapp--ghost:hover {
    border-color: #f6f2e8;
    background: transparent;
    color: #f6f2e8;
  }
  .morka .knapp--fara {
    border-color: rgb(243 166 131 / 0.5);
    background: transparent;
    color: #f3a683;
  }
  .morka .knapp--fara:hover {
    border-color: #f3a683;
    background: rgb(243 166 131 / 0.08);
    color: #f3a683;
  }
  .morka .knapp:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  @media (max-width: 560px) {
    .morka {
      padding: 26px 0 44px;
    }
    .morka__ingress {
      font-size: 16px;
    }
  }
  /* Raden för en medlem, ritad av src/lib/uppdragkort.ts. Den är mörk, likadan i listan och i
     förhandsvisningen på den ljusa sidan. Listans bredd avgör formen, inte fönstrets: i en bred
     lista står allt på en rad som ögat följer rakt ner, och i en smal spalt staplas det.
     Det kompakta kortet vid handen på kartan står i global.css. */
  .medlemslista {
    container-type: inline-size;
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .medlemsrad {
    position: relative;
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 14px;
    padding: 16px;
    border: 1px solid #2b2924;
    border-radius: 14px;
    background: #1a1915;
    color: #e3dece;
    transition:
      background-color 240ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .medlemsrad__bild {
    position: relative;
    display: block;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 50%;
    background: #2a2722;
    box-shadow: 0 0 0 1px hsl(40 30% 80% / 0.16);
  }
  .medlemsrad__bild-foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Utan bild står föreningens hand i en ljus rundel, så att platsen ser avsedd ut och inte tom. */
  .medlemsrad__bild--utan {
    background: radial-gradient(circle at 38% 32%, #f5eedf, #d9cdb4 75%);
  }
  .medlemsrad__bild-hand {
    position: absolute;
    left: 50%;
    bottom: -6%;
    width: 88%;
    transform: translateX(-47%);
  }
  .medlemsrad__vem {
    min-width: 0;
  }
  .medlemsrad__namn {
    margin: 0;
    color: #f6f2e8;
    font: 650 16.5px/1.2 var(--font-sans);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .medlemsrad__ort {
    margin: 4px 0 0;
    color: #a39f92;
    font: 500 11.5px/1.3 var(--font-mono);
    letter-spacing: 0.03em;
  }
  /* I en smal spalt står länken uppe till höger, bredvid namnet, och raden om vad medlemmen gör
     under. Då ryms fler medlemmar på en telefonskärm. */
  .medlemsrad__vad {
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
  }
  .medlemsrad__rubrik {
    margin: 0;
    color: #e3dece;
    font: 400 16px/1.4 var(--font-sans);
    overflow-wrap: anywhere;
  }
  .medlemsrad__ord {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .medlemsrad__kunskap {
    padding: 4px 8px;
    border-radius: 6px;
    background: #2b2822;
    color: #ecdfbd;
    font: 500 12px/1.2 var(--font-mono);
  }
  .medlemsrad__omrade {
    color: #a39f92;
    font: 400 13px/1.3 var(--font-sans);
  }
  .medlemsrad__omrade::before {
    content: '·';
    margin-right: 6px;
    color: #7a766b;
  }
  .medlemsrad__omrade:first-child::before {
    content: none;
  }
  .medlemsrad__kunskap + .medlemsrad__omrade {
    margin-left: 2px;
  }
  .medlemsrad__ut {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    min-width: 0;
    max-width: 150px;
  }
  .medlemsrad__lank {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    max-width: 100%;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid #4a473f;
    border-radius: var(--r-pill);
    color: #f6f2e8;
    font: 600 13.5px/1 var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 240ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 240ms cubic-bezier(0.16, 1, 0.3, 1),
      color 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .medlemsrad__marke {
    display: inline-flex;
    flex: none;
  }
  .medlemsrad__lanktext {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Hela raden är länken: ett stort mål i stället för en liten knapp. Bolagets länk ligger ovanpå. */
  .medlemsrad__lank[href]::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
  }
  .medlemsrad__lank:focus-visible {
    outline: 0;
  }
  .medlemsrad__lank:focus-visible::after {
    outline: 2px solid #f6f2e8;
    outline-offset: 2px;
  }
  .medlemsrad__lank[aria-disabled='true'] {
    cursor: default;
  }
  @media (hover: hover) {
    .medlemsrad:has(.medlemsrad__lank[href]):hover {
      border-color: #5d594f;
      background: #211f1a;
    }
    .medlemsrad:hover .medlemsrad__lank[href] {
      border-color: #f6f2e8;
      background: #f6f2e8;
      color: #141310;
    }
  }
  .medlemsrad__bolag {
    position: relative;
    z-index: 1;
    max-width: 100%;
    overflow: hidden;
    color: #a39f92;
    font-size: 12.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.medlemsrad__bolag:hover {
    color: #f6f2e8;
  }
  /* Platsen sist i listan, för den som själv tar uppdrag. */
  .medlemsrad--ledig {
    border-style: dashed;
    border-color: #3d3a33;
    background: transparent;
  }
  @container (min-width: 760px) {
    .medlemsrad {
      grid-template-columns: 48px minmax(0, 190px) minmax(0, 1fr) auto;
      gap: 20px;
      padding: 14px 18px 14px 16px;
    }
    .medlemsrad__vad {
      grid-column: 3;
      grid-row: 1;
    }
    .medlemsrad__ut {
      grid-column: 4;
      gap: 6px;
      max-width: 220px;
    }
    .medlemsrad__lank {
      gap: 8px;
      min-height: 40px;
      padding: 0 16px;
      font-size: 14.5px;
    }
    .medlemsrad__bolag {
      font-size: 13px;
    }
  }

  /* ---------- Formuläret ---------- */

  /* Formuläret ska gå fort: stora fält, en sak i taget och så lite text som det går. Allt står
     på samma mörka sida som listan, så att raden överst ser ut precis som den kommer att göra. */
  .uppdragsform {
    display: grid;
    gap: 26px;
    max-width: 600px;
  }
  .uppdragsform fieldset {
    display: grid;
    gap: 10px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .falt {
    display: grid;
    gap: 9px;
    min-width: 0;
  }
  .uppdragsform legend,
  .falt__etikett {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 0;
    color: #f6f2e8;
    font: 600 15.5px/1.3 var(--font-sans);
  }
  /* En legend står utanför rutnätet i sitt fieldset, så avståndet till fälten sätts här. */
  .uppdragsform legend {
    margin-bottom: 10px;
  }
  /* Det lilla bredvid etiketten: frivilligt, eller hur många ord som är valda. */
  .falt__vid {
    color: #979386;
    font: 500 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .faltnot {
    margin: 0;
    color: #a39f92;
    font-size: 13.5px;
    line-height: 1.45;
  }
  .faltnot:empty {
    display: none;
  }
  .falt__fel {
    margin: 0;
    color: #f3a683;
    font-size: 13.5px;
    font-weight: 600;
  }
  .uppdragsform input[type='text'],
  .uppdragsform input[type='email'],
  .uppdragsform select {
    width: 100%;
    min-height: 52px;
    padding: 0 16px;
    border: 1px solid #3a3832;
    border-radius: 12px;
    background: #1e1d19;
    color: #f6f2e8;
    font: 400 16.5px/1.3 var(--font-sans);
    transition:
      border-color 240ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .uppdragsform input::placeholder {
    color: #979386;
  }
  .uppdragsform input:focus-visible,
  .uppdragsform select:focus-visible {
    outline: 0;
    border-color: #f6f2e8;
    box-shadow: 0 0 0 3px rgb(246 242 232 / 0.14);
  }
  .uppdragsform [aria-invalid='true'] {
    border-color: #f3a683;
  }
  .faltrad {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .faltrad > input,
  .faltrad > select {
    flex: 1;
    min-width: 200px;
  }

  /* Kunskaperna: orden och fältet står i samma ruta, som man är van vid från andra ställen. */
  .ordfalt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    min-height: 52px;
    padding: 7px 8px;
    border: 1px solid #3a3832;
    border-radius: 12px;
    background: #1e1d19;
    cursor: text;
    transition:
      border-color 240ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ordfalt:focus-within {
    border-color: #f6f2e8;
    box-shadow: 0 0 0 3px rgb(246 242 232 / 0.14);
  }
  .uppdragsform .ordfalt input[type='text'] {
    flex: 1;
    width: auto;
    min-width: 170px;
    min-height: 36px;
    padding: 0 8px;
    border: 0;
    background: transparent;
    box-shadow: none;
  }
  .ordval {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ordval:empty {
    display: none;
  }
  .ordval__ord {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 11px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: #2f2c25;
    color: #ecdfbd;
    font: 500 13px/1 var(--font-mono);
    cursor: pointer;
    transition:
      border-color 240ms cubic-bezier(0.16, 1, 0.3, 1),
      color 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ordval__ord:hover {
    border-color: #f3a683;
    color: #f3a683;
  }
  .ordval__ord:focus-visible {
    outline: 2px solid #f6f2e8;
    outline-offset: 2px;
  }
  .ordval--forslag .ordval__ord {
    border: 1px dashed #4a473f;
    background: transparent;
    color: #c9c4b6;
  }
  .ordval--forslag .ordval__ord:hover {
    border-style: solid;
    border-color: #f6f2e8;
    color: #f6f2e8;
  }

  /* Val som brickor: områdena och vad medlemmen erbjuder. */
  .brickval {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .bricka {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 13px;
    border: 1px solid #3a3832;
    border-radius: var(--r-pill);
    color: #c9c4b6;
    font: 500 13.5px/1 var(--font-sans);
    cursor: pointer;
    transition:
      background-color 240ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 240ms cubic-bezier(0.16, 1, 0.3, 1),
      color 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bricka input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .bricka:has(input:checked) {
    border-color: #f6f2e8;
    background: #f6f2e8;
    color: #141310;
    font-weight: 600;
  }
  .bricka:has(input:focus-visible) {
    outline: 2px solid #f6f2e8;
    outline-offset: 2px;
  }
  .bricka:has(input:disabled) {
    opacity: 0.4;
    cursor: default;
  }
  .val {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    color: #e3dece;
    font-size: 15px;
    line-height: 1.45;
    cursor: pointer;
  }
  .val input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 1px 0 0;
    accent-color: #f6f2e8;
  }
  .val--rad {
    align-items: center;
    min-height: 52px;
    white-space: nowrap;
  }

  /* Bilden: rund som i raden, med vägarna att få in en bredvid. */
  .bildval__rad {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .bildval__visning {
    position: relative;
    flex: none;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 50%;
    background: #2a2722;
    box-shadow: 0 0 0 1px hsl(40 30% 80% / 0.16);
  }
  .bildval__visning img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bildval__visning--utan {
    background: radial-gradient(circle at 38% 32%, #f5eedf, #d9cdb4 75%);
  }
  .bildval__visning--utan img {
    position: absolute;
    left: 50%;
    bottom: -6%;
    width: 88%;
    height: auto;
    transform: translateX(-47%);
  }
  .bildval__fil {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .bildval__fil:focus-visible + .knapp {
    outline: 2px solid #f6f2e8;
    outline-offset: 2px;
  }
  .bildval__x {
    display: flex;
    gap: 8px;
  }
  .bildval__x input {
    flex: 1;
    min-width: 0;
  }
  .lankknapp {
    padding: 6px 2px;
    border: 0;
    background: none;
    color: #a39f92;
    font: 500 13.5px/1.2 var(--font-sans);
    text-decoration: underline;
    cursor: pointer;
  }
  .lankknapp:hover {
    color: #f6f2e8;
  }
  .lankknapp--fara,
  .lankknapp--fara:hover {
    color: #f3a683;
  }

  /* Det som inte behövs för att synas ligger hopfällt. */
  .mer {
    border-top: 1px solid #2b2924;
    border-bottom: 1px solid #2b2924;
  }
  .mer summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    padding: 17px 0;
    color: #f6f2e8;
    font: 600 15.5px/1.3 var(--font-sans);
    list-style: none;
    cursor: pointer;
  }
  .mer summary::-webkit-details-marker {
    display: none;
  }
  .mer summary span {
    color: #979386;
    font: 400 13.5px/1.3 var(--font-sans);
  }
  .mer summary::after {
    content: '+';
    margin-left: auto;
    color: #a39f92;
    font: 400 20px/1 var(--font-mono);
  }
  .mer[open] summary::after {
    content: '–';
  }
  .mer__kropp {
    display: grid;
    gap: 24px;
    padding: 6px 0 24px;
  }

  /* Spara står kvar längst ner medan man fyller i, så att knappen alltid är inom räckhåll. */
  .sparrad {
    position: sticky;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 0 -8px;
    padding: 18px 8px calc(14px + env(safe-area-inset-bottom));
    background: linear-gradient(to top, #141310 76%, rgb(20 19 16 / 0));
  }
  .sparrad .knapp {
    min-height: 50px;
    padding: 0 26px;
    font-size: 16px;
  }
  .sparrad__kvitto {
    margin: 0;
    color: #e9e5da;
    font-size: 14.5px;
  }
  .sparrad__kvitto:empty {
    display: none;
  }
  /* På en telefon är knappen lika bred som fälten, så att tummen når den var den än är. */
  @media (max-width: 560px) {
    .sparrad .knapp {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  .honung {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .besked {
    max-width: 600px;
    padding: 16px 18px;
    border-left: 3px solid #cfc8b4;
    border-radius: 12px;
    background: #1e1d19;
    color: #e9e5da;
  }
  .besked--fel {
    border-left-color: #f3a683;
  }
  .besked p {
    margin: 0;
  }
  .besked p + p {
    margin-top: 8px;
  }
</style>
