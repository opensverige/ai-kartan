---
// Det som sidorna under /uppdrag delar: namnen på kommuner och områden, som korten slår upp,
// och stilen för korten och formuläret. Korten ritas i webbläsaren, så stilen är global.
import { hamtaData } from '../lib/data';
import type { Etiketter } from '../lib/uppdragkort';

const d = hamtaData();
const etiketter: Etiketter = {
  kommuner: Object.fromEntries(d.kommuner.map((k) => [k.kod, k.namn])),
  omraden: Object.fromEntries(d.taxonomi.omraden.map((o) => [o.id, o.label])),
};
---

<script type="application/json" id="uppdrag-etiketter" set:html={JSON.stringify(etiketter)} />

<style is:global>
  /* En regel med display får inte vinna över hidden, som sidornas skript sätter. */
  :is(.uppdrag__filter, .redigera, .uppdragsform, .besked, .knapp)[hidden] {
    display: none !important;
  }
  .profiler {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 22px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 560px) {
    .profiler {
      grid-template-columns: 1fr 1fr;
      gap: 14px 12px;
    }
  }

  /* Samlarkortet, ritat av src/lib/uppdragkort.ts. Ett mörkt kort med folieram, likadant på den
     mörka listan och i förhandsvisningen på den ljusa sidan, som ett kort man håller i handen.
     Det kompakta kortet vid handen på kartan står i global.css. */
  .samlarkort {
    --kortbotten: #1b1915;
    --folie: linear-gradient(
      var(--folievinkel, 125deg),
      #6e5634 0%,
      #f1dca2 22%,
      #9a7646 40%,
      #fff1c8 58%,
      #8a6a3e 76%,
      #e6c88a 100%
    );
    display: flex;
    min-width: 0;
    perspective: 900px;
  }
  .samlarkort__yta {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    padding: 12px 12px 10px;
    border: 1.5px solid transparent;
    border-radius: 16px;
    background:
      linear-gradient(180deg, #23201b, var(--kortbotten) 40%) padding-box,
      var(--folie) border-box;
    box-shadow:
      0 1px 0 hsl(40 60% 90% / 0.08) inset,
      0 18px 34px -18px rgb(0 0 0 / 0.75);
    color: #e9e5da;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition:
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .samlarkort__yta:hover {
      box-shadow:
        0 1px 0 hsl(40 60% 90% / 0.12) inset,
        0 26px 44px -18px rgb(0 0 0 / 0.85);
    }
  }
  .samlarkort__namn {
    margin: 0 2px 10px;
    color: #f6f2e8;
    font: 650 18px/1.15 var(--font-sans);
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }
  .samlarkort__bild {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 9px;
    background: #2a2722;
    box-shadow: 0 0 0 1px hsl(40 50% 80% / 0.18);
  }
  .samlarkort__bild-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .samlarkort__bild-hand {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 76%;
    transform: translateX(-50%);
  }
  /* Glansen över bilden följer pekaren. Den syns bara när kortet lutas. */
  .samlarkort__glans {
    position: absolute;
    inset: 0;
    opacity: 0;
    background:
      radial-gradient(circle at var(--px, 50%) var(--py, 40%), hsl(45 100% 96% / 0.5), transparent 55%),
      linear-gradient(
        115deg,
        transparent 18%,
        hsl(28 90% 75% / 0.35) 34%,
        hsl(160 60% 75% / 0.3) 50%,
        hsl(250 70% 82% / 0.3) 66%,
        transparent 82%
      );
    background-size: 100% 100%, 260% 260%;
    background-position: 0 0, var(--px, 50%) var(--py, 50%);
    mix-blend-mode: soft-light;
    pointer-events: none;
    transition: opacity 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .samlarkort__yta:hover .samlarkort__glans {
      opacity: 1;
    }
  }
  .samlarkort__stampel {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 7px 3px;
    border-radius: 5px;
    background: linear-gradient(var(--folievinkel, 120deg), #f6d6a6, #cfe8d4 35%, #d8d2f4 65%, #f3c6d6);
    box-shadow:
      0 1px 0 hsl(0 0% 100% / 0.55) inset,
      0 2px 8px rgb(0 0 0 / 0.35);
    color: #1b1915;
    font: 700 9.5px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .samlarkort__ort {
    position: absolute;
    left: 8px;
    bottom: 8px;
    max-width: calc(100% - 16px);
    padding: 5px 8px;
    border-radius: var(--r-pill);
    background: rgb(20 19 16 / 0.74);
    color: #f6f2e8;
    font: 500 11px/1.2 var(--font-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    backdrop-filter: blur(6px);
  }
  .samlarkort__typ {
    margin: 12px 2px 0;
    color: #dcc28c;
    font: 500 11px/1.45 var(--font-mono);
  }
  .samlarkort__rubrik {
    margin: 5px 2px 0;
    color: #cdc8ba;
    font-size: 14.5px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .samlarkort__fot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin: auto 2px 0;
    padding-top: 12px;
  }
  .samlarkort__lank {
    color: #f4a877;
    font: 650 14.5px/1.3 var(--font-sans);
    text-decoration: none;
  }
  .samlarkort__lank:hover {
    color: #ffc39b;
    text-decoration: underline;
  }
  .samlarkort__lank[aria-disabled='true'] {
    cursor: default;
    text-decoration: none;
  }
  .samlarkort__bolag {
    color: #a39f92;
    font: 400 11.5px/1.3 var(--font-mono);
    overflow-wrap: anywhere;
  }
  a.samlarkort__bolag:hover {
    color: #f6f2e8;
  }
  /* Sist på kortet: föreningens märke och kortets nummer, som tryckt längst ner på ett samlarkort. */
  .samlarkort__serie {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 10px 0 0;
    padding: 8px 2px 0;
    border-top: 1px solid hsl(40 40% 80% / 0.12);
    color: #9b9585;
    font: 500 9.5px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .samlarkort__marke {
    width: 13px;
    height: auto;
    image-rendering: pixelated;
  }
  .samlarkort__nr {
    margin-left: auto;
    color: #cbb27c;
  }
  @media (max-width: 560px) {
    .samlarkort__yta {
      padding: 9px 9px 8px;
      border-radius: 13px;
    }
    .samlarkort__namn {
      margin-bottom: 8px;
      font-size: 15.5px;
    }
    .samlarkort__bild {
      border-radius: 7px;
    }
    .samlarkort__stampel {
      top: 6px;
      right: 6px;
      padding: 3px 5px 2px;
      font-size: 8px;
    }
    .samlarkort__ort {
      left: 6px;
      bottom: 6px;
      padding: 4px 6px;
      font-size: 10px;
    }
    .samlarkort__typ {
      margin-top: 9px;
      font-size: 10px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .samlarkort__rubrik {
      font-size: 13.5px;
    }
    .samlarkort__bolag {
      display: none;
    }
    .samlarkort__serie {
      font-size: 8.5px;
    }
  }

  /* Bildvalet i formuläret: bilden som den syns, och två vägar att få in en. */
  .bildval {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
  }
  .bildval__visning {
    position: relative;
    flex: none;
    width: 96px;
    height: 96px;
    overflow: hidden;
    border-radius: 18px;
    background: #1e1d19;
  }
  .bildval__visning img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bildval__visning img.bildval__hand {
    object-fit: contain;
    object-position: 50% 100%;
    padding: 8px 4px 0;
  }
  .bildval__vagar {
    display: grid;
    flex: 1;
    gap: 10px;
    min-width: 220px;
  }
  .bildval__x {
    display: flex;
    gap: 8px;
  }
  .bildval__x input {
    flex: 1;
    min-width: 0;
  }
  .bildval__fil {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .bildval__fil:focus-visible + .knapp {
    outline: 2px solid hsl(var(--moss));
    outline-offset: 2px;
  }

  /* Formulären */
  .uppdragsform {
    display: grid;
    gap: 18px;
    max-width: 560px;
  }
  .uppdragsform fieldset {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .uppdragsform legend,
  .falt__etikett {
    padding: 0;
    color: hsl(var(--ink));
    font-weight: 600;
    font-size: 15px;
  }
  .falt {
    display: grid;
    gap: 6px;
  }
  .falt__hjalp {
    margin: 0;
    font-size: 13.5px;
    color: hsl(var(--ink-mute));
  }
  .falt__fel {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    color: hsl(var(--rust));
  }
  .uppdragsform input[type='text'],
  .uppdragsform input[type='email'],
  .uppdragsform input[type='url'],
  .uppdragsform select {
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    border: 1.5px solid hsl(var(--rule));
    border-radius: var(--r-btn);
    background: hsl(var(--bg));
    color: hsl(var(--ink));
    font: 400 16px/1.3 var(--font-sans);
  }
  .uppdragsform input:focus-visible,
  .uppdragsform select:focus-visible {
    outline: 0;
    border-color: hsl(var(--moss));
    box-shadow: 0 0 0 3px hsl(var(--moss) / 0.15);
  }
  .uppdragsform [aria-invalid='true'] {
    border-color: hsl(var(--rust));
  }
  .val {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.4;
    cursor: pointer;
  }
  .val input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: hsl(var(--moss));
  }
  .valrutnat {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 8px 16px;
  }
  .val:has(input:disabled) {
    color: hsl(var(--ink-mute));
    cursor: default;
  }
  .honung {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .besked {
    padding: 16px 18px;
    border-radius: var(--r-card);
    background: hsl(var(--bg-soft));
    border-left: 3px solid hsl(var(--moss));
  }
  .besked--fel {
    border-left-color: hsl(var(--rust));
  }
  .besked p {
    margin: 0;
  }
  .besked p + p {
    margin-top: 8px;
  }
  .knapp:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .knapp--fara {
    background: transparent;
    border-color: hsl(var(--rust) / 0.5);
    color: hsl(var(--rust));
  }
  .knapp--fara:hover {
    background: hsl(var(--rust) / 0.08);
    border-color: hsl(var(--rust));
    color: hsl(var(--rust));
  }
</style>
