---
// Sidhuvud i appstil: märke, vyväxel, sök i mitten och meny till höger.
// Sökfältet är ett vanligt GET-formulär mot kartan. På kartsidan och i listan tar
// KartApp över det och visar träffar direkt medan man skriver.
import { SAJT, url } from '../lib/data';
import { ikon } from '../lib/ikoner';
import type { IkonNamn } from '../lib/ikoner';

const stig = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const vyer: { href: string; text: string; ikon: IkonNamn }[] = [
  { href: '/', text: 'Karta', ikon: 'karta' },
  { href: '/organisationer', text: 'Lista', ikon: 'lista' },
];
const lankar: { href: string; text: string }[] = [
  { href: '/om', text: 'Varför vi finns' },
  { href: '/plats', text: 'Platser' },
  { href: '/andringar', text: 'Ändringar' },
  { href: '/metod', text: 'Metod' },
  { href: '/kriterier', text: 'Kriterier' },
  { href: '/data', text: 'Öppen data' },
  { href: '/bidra', text: 'Bidra' },
];
function aktiv(href: string): boolean {
  if (href === '/') return stig === '/' || stig === '';
  return stig === href || stig.startsWith(`${href}/`);
}
---

<header class="sidhuvud">
  <div class="sidhuvud__rad">
    <a class="marke" href={url('/')} aria-label={`${SAJT.namn}, till kartan`}>
      <img src={url('/icon.png')} alt="" width="36" height="36" class="marke__bild" />
      <span class="marke__text">
        <span class="marke__namn">OpenSverige</span>
        <span class="marke__under">AI-kartan · ideell, oberoende, inte statlig</span>
      </span>
    </a>

    <nav class="vyval" aria-label="Vy">
      {vyer.map((v) => (
        <a href={url(v.href)} aria-current={aktiv(v.href) ? 'page' : undefined}>
          <Fragment set:html={ikon(v.ikon, 17)} />
          {v.text}
        </a>
      ))}
    </nav>

    <form class="sok" id="sokform" role="search" action={url('/')} method="get">
      <label class="visuellt-dold" for="sok">Sök på namn, plats eller vad de bygger</label>
      <span class="sok__ikon"><Fragment set:html={ikon('sok', 19)} /></span>
      <input
        id="sok"
        class="sok__falt"
        type="search"
        name="q"
        placeholder="Sök namn, plats eller ämne"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
      />
      <kbd class="sok__kbd" aria-hidden="true">⌘K</kbd>
      <div class="sok__lada" id="sokresultat" hidden></div>
    </form>

    <div class="sidhuvud__hoger">
      <a class="hknapp hknapp--mork" href={url('/bidra')}>
        <Fragment set:html={ikon('plus', 17)} />
        Lägg till
      </a>
      <details class="meny">
        <summary class="hknapp hknapp--ikon" aria-label="Meny">
          <Fragment set:html={ikon('meny', 20)} />
        </summary>
        <ul class="meny__lista">
          {vyer.map((v) => (
            <li class="meny__vy">
              <a href={url(v.href)} aria-current={aktiv(v.href) ? 'page' : undefined}>{v.text}</a>
            </li>
          ))}
          {lankar.map((l) => (
            <li>
              <a href={url(l.href)} aria-current={aktiv(l.href) ? 'page' : undefined}>{l.text}</a>
            </li>
          ))}
          <li class="meny__skilje">
            <a href={SAJT.infra} rel="noopener">AI-Infra</a>
          </li>
          <li>
            <a href={SAJT.discord} rel="noopener">Discord</a>
          </li>
        </ul>
      </details>
    </div>
  </div>
</header>

<script>
  const falt = document.querySelector<HTMLInputElement>('#sok');
  const kbd = document.querySelector<HTMLElement>('.sok__kbd');
  const meny = document.querySelector<HTMLDetailsElement>('.meny');

  if (kbd && !/Mac|iPhone|iPad/.test(navigator.userAgent)) kbd.textContent = 'Ctrl K';

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      falt?.focus();
      falt?.select();
    }
    if (e.key === 'Escape' && meny?.open) {
      meny.open = false;
      meny.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (meny?.open && !meny.contains(e.target as Node)) meny.open = false;
  });
</script>

<style>
  .sidhuvud {
    position: sticky;
    top: 0;
    z-index: 50;
    flex: none;
    background: hsl(var(--yta));
    border-bottom: 1px solid hsl(var(--kant));
  }
  .sidhuvud__rad {
    display: flex;
    align-items: center;
    gap: 16px;
    height: var(--huvud-h);
    padding: 0 20px;
  }
  .marke {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex: none;
    text-decoration: none;
    color: hsl(var(--ink));
  }
  .marke__bild {
    width: 36px;
    height: 36px;
    transition: transform var(--t-fast);
  }
  .marke:hover .marke__bild {
    transform: rotate(-9deg);
  }
  .marke__text {
    display: grid;
    gap: 3px;
  }
  .marke__namn {
    font-weight: 700;
    font-size: 21px;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  /* Kartan ska aldrig kunna tas för en statlig tjänst. */
  .marke__under {
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--moss));
    white-space: nowrap;
  }

  /* Vyväxel: Karta eller Lista */
  .vyval {
    display: inline-flex;
    flex: none;
    gap: 2px;
    padding: 4px;
    border-radius: var(--r-pill);
    background: hsl(var(--yta-chip));
  }
  .vyval a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: var(--r-pill);
    color: hsl(var(--ink-mute));
    text-decoration: none;
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.2;
    transition: color var(--t-fast), background var(--t-fast);
  }
  .vyval a:hover {
    color: hsl(var(--ink));
  }
  .vyval a[aria-current='page'] {
    background: hsl(var(--bg));
    color: hsl(var(--ink));
    font-weight: 600;
    box-shadow: 0 1px 2px hsl(var(--ink) / 0.12);
  }

  /* Sök: sidhuvudets tydligaste element */
  .sok {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    height: 46px;
    border: 1.5px solid hsl(var(--ink) / 0.22);
    border-radius: var(--r-pill);
    background: hsl(var(--bg));
    box-shadow: 0 1px 2px hsl(var(--ink) / 0.05);
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }
  .sok:hover {
    border-color: hsl(var(--ink) / 0.45);
  }
  .sok:focus-within {
    border-color: hsl(var(--ink));
    box-shadow: 0 0 0 4px hsl(var(--ink) / 0.08);
  }
  .sok__ikon {
    display: grid;
    place-items: center;
    width: 46px;
    flex: none;
    color: hsl(var(--ink));
    pointer-events: none;
  }
  .sok__falt {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0 8px 0 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: hsl(var(--ink));
    font: 500 16px/1.2 var(--font-sans);
    -webkit-appearance: none;
    appearance: none;
  }
  .sok__falt::placeholder {
    color: hsl(var(--ink-mute));
    font-weight: 400;
    opacity: 1;
  }
  .sok__kbd {
    flex: none;
    margin-right: 10px;
    padding: 4px 7px;
    border: 1px solid hsl(var(--kant));
    border-radius: 7px;
    background: hsl(var(--yta-chip));
    color: hsl(var(--ink-mute));
    font: 500 11px/1 var(--font-mono);
    white-space: nowrap;
  }
  .sok:focus-within .sok__kbd {
    display: none;
  }

  .sidhuvud__hoger {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }
  .hknapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 42px;
    padding: 0 16px;
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-ruta);
    background: hsl(var(--yta-kort));
    color: hsl(var(--ink));
    font: 600 14.5px/1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
    transition: background var(--t-fast), border-color var(--t-fast);
  }
  .hknapp:hover {
    border-color: hsl(var(--ink) / 0.4);
    color: hsl(var(--ink));
  }
  .hknapp--mork {
    background: hsl(var(--ink));
    border-color: hsl(var(--ink));
    color: hsl(var(--yta));
  }
  .hknapp--mork:hover {
    background: hsl(var(--ink-soft));
    border-color: hsl(var(--ink-soft));
    color: hsl(var(--yta));
  }
  .hknapp--ikon {
    width: 42px;
    padding: 0;
    list-style: none;
  }
  .hknapp--ikon::-webkit-details-marker {
    display: none;
  }
  .meny {
    position: relative;
  }
  .meny[open] > summary {
    border-color: hsl(var(--ink));
  }
  .meny__lista {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 230px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: hsl(var(--yta-kort));
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-kort);
    box-shadow: var(--skugga-flyt);
  }
  .meny__lista a {
    display: block;
    padding: 9px 12px;
    border-radius: 10px;
    color: hsl(var(--ink-soft));
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }
  .meny__lista a:hover {
    background: hsl(var(--yta-chip));
    color: hsl(var(--ink));
  }
  .meny__lista a[aria-current='page'] {
    color: hsl(var(--ink));
    font-weight: 700;
  }
  .meny__vy {
    display: none;
  }
  .meny__skilje {
    margin-top: 4px;
    padding-top: 4px;
    border-top: 1px solid hsl(var(--kant));
  }

  @media (max-width: 1180px) {
    .marke__under {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .sidhuvud__rad {
      gap: 10px;
      padding: 0 12px;
    }
    .marke__text,
    .vyval,
    .hknapp--mork,
    .sok__kbd {
      display: none;
    }
    .meny__vy {
      display: block;
    }
    .marke {
      min-width: 44px;
      min-height: 44px;
      justify-content: center;
    }
    .sok {
      height: 44px;
    }
    .sok__ikon {
      width: 42px;
    }
  }
</style>
