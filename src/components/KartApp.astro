---
// Karta + filter + lista. Datan hämtas från /api/karta.json i webbläsaren.
// Filtren speglas i URL:en så att en filtrerad vy går att länka och citera.
// Sökfältet ligger i sidhuvudet (Sidhuvud.astro) och kopplas in härifrån.
import 'maplibre-gl/dist/maplibre-gl.css';
import Filterrad from './Filterrad.astro';
import { hamtaData, typikoner, url, formateraDatum, SAJT } from '../lib/data';
import { ikon } from '../lib/ikoner';
import { medlemsvy, type Medlemsdata } from '../lib/medlemmar';
import medlemsdata from '../../data/gemenskap/regioner.json';

interface Props {
  lage?: 'karta' | 'lista';
}
const { lage = 'karta' } = Astro.props;
const d = hamtaData();
const s = d.statistik;
const etiketter = {
  typer: Object.fromEntries(d.taxonomi.typer.map((t) => [t.id, t.label])),
  erbjuder: Object.fromEntries(d.taxonomi.erbjuder.map((t) => [t.id, t.label])),
  omraden: Object.fromEntries(d.taxonomi.omraden.map((t) => [t.id, t.label])),
  lan: Object.fromEntries(d.lan.map((l) => [l.kod, l.namn])),
  typikoner: typikoner(),
};
const allaEfterNamn = d.organisationer.slice().sort((a, b) => a.name.value.localeCompare(b.name.value, 'sv'));
// Var föreningens medlemmar finns, som antal per region. Ritas på kartan först när besökaren ber om det.
const medlemmar = lage === 'karta' ? medlemsvy(medlemsdata as Medlemsdata, d.kommuner) : null;
const kraftan = url('/ikoner/opensverige.png');
// Stapelns bredd räknas ur ikonens storlek, som redan är rensad från små antal.
const stapel = (storlek: number) => Math.round(((storlek - 0.5) / 0.5) ** 2 * 100);
---

<div class="app" data-lage={lage} data-api={url('/api/karta.json')} data-orgbas={url('/organisation/')} data-bidra={url('/bidra')} data-csv={url('/api/data.csv')} data-infra={SAJT.infra} data-infralogo={url('/ai-infra.png')} data-worker={url('/vendor/maplibre/maplibre-gl-worker.mjs')} data-kartbas={url('/')} data-kraftan={kraftan}>
  {lage === 'lista' && <Filterrad />}

  <section class="panel" id="panel" data-blad="titt" aria-label="Organisationer">
    {lage === 'karta' && (
      <button type="button" class="panel__grepp" id="grepp" aria-expanded="false" aria-controls="vy-lista">
        <span class="panel__handtag" aria-hidden="true"></span>
        <span class="panel__grepptext" id="grepptext">Visa listan</span>
      </button>
    )}

    <div class="panel__vy" id="vy-lista">
      {lage === 'karta' && (
        <header class="panel__intro">
          <div class="panel__topp">
            <nav aria-label="Plats">
              <ol class="brod" id="brod">
                <li aria-current="page">Sverige</li>
              </ol>
            </nav>
            <button type="button" class="ikonknapp" id="falla" aria-label="Dölj panelen" title="Dölj panelen">
              <Fragment set:html={ikon('panel-stang', 20)} />
            </button>
          </div>
          <p class="kicker panel__kicker">Tech Embassy · oberoende, inte statlig</p>
          <h1 class="panel__rubrik" id="rubrik">Alla som bygger AI i Sverige</h1>
          <p class="panel__antal"><strong id="antal-tal">{s.antal}</strong> <span id="antal-not">organisationer</span></p>
          <p class="panel__text" id="ingress">
            Drivs ideellt av föreningen OpenSverige, inget företag. Inget rankas och ingen kan köpa en plats.
            <a href={url('/bidra')}>Lägg till dig själv.</a>
          </p>
        </header>
      )}

      <div class="listhuvud">
        <p class:list={['kicker', 'listhuvud__antal', { 'visuellt-dold': lage === 'karta' }]} id="antal" aria-live="polite">Laddar …</p>
        <div class="listhuvud__hoger">
          <label class="sortera">
            <span>Sortera:</span>
            <select id="sortera">
              <option value="namn">Namn A–Ö</option>
              <option value="kontroll">Senast kontrollerad</option>
            </select>
          </label>
          <button type="button" class="ikonknapp ej-utskrift" id="dela" aria-label="Kopiera länk till urvalet" title="Kopiera länk till urvalet">
            <Fragment set:html={ikon('lank', 18)} />
          </button>
          <button type="button" class="ikonknapp ej-utskrift" id="ladda-ner" aria-label="Ladda ner urvalet som CSV" title="Ladda ner urvalet som CSV">
            <Fragment set:html={ikon('ladda-ner', 18)} />
          </button>
        </div>
      </div>

      <noscript>
        <style>{'.post--skelett { display: none; } .enkel-lista { margin: 16px 0; padding-left: 28px; line-height: 1.9; } .enkel-lista span { color: hsl(var(--ink-mute)); }'}</style>
        <p class="lista__tom lista__tom--ram">
          <strong>Kartan och listan kräver JavaScript.</strong>
          <span>Alla organisationer finns också <a href={url('/plats')}>per kommun och län</a> och som <a href={url('/data')}>öppen data</a>.</span>
        </p>
        {/* Utan JavaScript ska listsidan ändå gå att läsa och följa, för människor och för robotar som inte kör skript. */}
        {lage === 'lista' && (
          <ol class="enkel-lista">
            {allaEfterNamn.map((o) => (
              <li>
                <a href={url(`/organisation/${o.id}`)}>{o.name.value}</a>
                <span> · {etiketter.typer[o.type.value] ?? o.type.value}{o.h.kommun_namn ? `, ${o.h.kommun_namn}` : ''}</span>
              </li>
            ))}
          </ol>
        )}
      </noscript>

      <ol class="lista" id="lista">
        {[0, 1, 2, 3].map(() => (
          <li class="post post--skelett" aria-hidden="true">
            <span class="skelett skelett--logo"></span>
            <span class="skelett skelett--rad"></span>
            <span class="skelett skelett--text"></span>
          </li>
        ))}
      </ol>

      <p class="lista__saknas">Saknas någon? <a href={url('/bidra')}>Lägg till en organisation</a></p>

      {lage === 'karta' && (
        <p class="panel__fakta meta">
          {s.andel_med_bekraftat} % har minst ett bekräftat fält · {d.platser.kommuner.length} kommuner ·
          senast verifierad {formateraDatum(s.senast_verifierad)}
        </p>
      )}

      {lage === 'karta' && (
        <footer class="panel__fot">
          <a href={url('/metod')}>Metod</a>
          <a href={url('/kriterier')}>Kriterier</a>
          <a href={url('/data')}>Öppen data</a>
          <a href={url('/integritet')}>Personuppgifter</a>
        </footer>
      )}
    </div>

    {lage === 'karta' && <div class="panel__vy panel__vy--detalj" id="vy-detalj" hidden></div>}
  </section>

  {lage === 'karta' && (
    <div class="kartyta">
      <div id="karta" class="karta" role="region" aria-label="Karta över organisationer som bygger AI i Sverige. Listan bredvid innehåller samma urval."></div>
      <Filterrad />
      <button type="button" class="kartknapp visa-panel" id="visa-panel" aria-label="Visa panelen" title="Visa panelen" hidden>
        <Fragment set:html={ikon('panel-oppna', 20)} />
      </button>
      <div class="kartknappar">
        {medlemmar && (
          <button type="button" class="kartknapp kartknapp--vi" id="visa-medlemmar" aria-pressed="false" aria-controls="medlemskort" aria-label="Visa var OpenSveriges medlemmar finns" title="Var är vi?">
            <img src={kraftan} alt="" width="36" height="36" decoding="async" />
          </button>
        )}
        <div class="kartknappar__grupp">
          <button type="button" class="kartknapp" id="zooma-in" aria-label="Zooma in"><Fragment set:html={ikon('plus', 20)} /></button>
          <button type="button" class="kartknapp" id="zooma-ut" aria-label="Zooma ut"><Fragment set:html={ikon('minus', 20)} /></button>
        </div>
        <button type="button" class="kartknapp" id="visa-allt" aria-label="Visa hela urvalet på kartan" title="Visa hela urvalet">
          <Fragment set:html={ikon('helbild', 19)} />
        </button>
      </div>
      {medlemmar && (
        <aside class="medlemskort" id="medlemskort" aria-label="OpenSveriges medlemmar per region" hidden>
          <div class="medlemskort__topp">
            <img class="medlemskort__bild" src={kraftan} alt="" width="44" height="44" loading="lazy" decoding="async" />
            <div>
              <p class="kicker">Du hittade kräftan</p>
              <h2 class="medlemskort__rubrik">Här är vi</h2>
            </div>
            <button type="button" class="ikonknapp" id="stang-medlemmar" aria-label="Tillbaka till kartan" title="Tillbaka till kartan">
              <Fragment set:html={ikon('kryss', 20)} />
            </button>
          </div>
          <p class="medlemskort__text"><strong>{medlemmar.totalt}</strong> byggare har sagt var de finns.</p>
          <ul class="medlemskort__lista">
            {medlemmar.regioner.map((r) => (
              <li>
                <span>{r.namn}</span>
                <span class="medlemskort__stapel" style={`--b:${stapel(r.storlek)}%`}></span>
                {r.tom ? <a href={SAJT.discord} rel="noopener">bli först</a> : <strong>{r.visat}</strong>}
              </li>
            ))}
          </ul>
          <p class="medlemskort__annan">Remote eller annan ort: <strong>{medlemmar.annanOrt}</strong></p>
          <p class="meta medlemskort__not">
            Regionen väljer var och en själv på vår Discord: en stad och tio mil runt den. Vi vet inte var någon bor.
            Uppdaterat {formateraDatum(medlemmar.uppdaterad)}.
            <a class="medlemskort__lank" href={SAJT.discord} rel="noopener">Gå med på Discord</a>
          </p>
          <a class="knapp knapp--liten medlemskort__knapp" href={SAJT.discord} rel="noopener">Gå med på Discord</a>
        </aside>
      )}
      <p class="karta__not meta">Positioner visas på kommunnivå, aldrig som gatuadress. <a href={url('/metod#plats')}>Varför?</a></p>
    </div>
  )}
</div>

<script type="application/json" id="etiketter" set:html={JSON.stringify(etiketter)} />
{medlemmar && <script type="application/json" id="medlemsdata" set:html={JSON.stringify(medlemmar)} />}

<script>
  // MapLibre är stort och laddas först när en karta faktiskt ska ritas, inte i listläget.
  import type { Map as MapLibreMap, Popup, GeoJSONSource, ExpressionSpecification, MapLayerMouseEvent, PaddingOptions } from 'maplibre-gl';
  import { ikon, type IkonNamn } from '../lib/ikoner';
  import { urvalSomCsv } from '../lib/csv';
  import { grupperaPerPlats, platsEfterUtzoomning, platsmitt, zoomgranser, ZOOM_KOMMUN, ZOOM_POSTER, type Platsgrupp } from '../lib/platsgrupper';
  import { arPaskagg, cirkel, type Medlemsvy } from '../lib/medlemmar';

  type Post = {
    id: string; n: string; t: string; o: string[]; a: string[]; k: string | null; kn: string | null;
    l: string | null; ln: string | null; lat: number | null; lng: number | null; pt: string | null;
    d: string; s: string | null; c: number; f: number; w: string; i: string | null;
  };
  /** Post med förberedd söktext: nn är namnet, ns allt som går att söka på. */
  type Rad = Post & { nn: string; ns: string };
  type FacettNamn = 'erbjuder' | 'typ' | 'omrade' | 'lan';
  type Filter = { q: string; erbjuder: string[]; typ: string[]; omrade: string[]; lan: string; kommun: string };
  type PlatsTraff = { typ: 'kommun' | 'lan'; kod: string; namn: string; nn: string; under: string; antal: number };
  type SokTraff = { org: Rad[]; platser: PlatsTraff[]; totalt: number };
  type SokVal = { typ: 'org'; o: Rad } | { typ: 'plats'; p: PlatsTraff } | { typ: 'vy' };

  const app = document.querySelector<HTMLElement>('.app');
  if (app) starta(app);

  function starta(app: HTMLElement) {
    const etiketter = JSON.parse(document.getElementById('etiketter')!.textContent || '{}') as Record<string, Record<string, string>>;
    // Typer med egen ikon: de ritas som landmärken på kartan och i logorutan på korten.
    const typikoner = etiketter.typikoner ?? {};
    const medKarta = app.dataset.lage === 'karta';
    const orgbas = app.dataset.orgbas || '/organisation/';
    const bidra = app.dataset.bidra || '/bidra';
    const form = app.querySelector<HTMLFormElement>('#filter')!;
    const lista = app.querySelector<HTMLOListElement>('#lista')!;
    const antalEl = app.querySelector<HTMLElement>('#antal')!;
    const sortEl = app.querySelector<HTMLSelectElement>('#sortera')!;
    const delaEl = app.querySelector<HTMLButtonElement>('#dela')!;
    const laddaNerEl = app.querySelector<HTMLButtonElement>('#ladda-ner')!;
    const infra = app.dataset.infra || 'https://infra.opensverige.se';
    const infralogo = app.dataset.infralogo || '/ai-infra.png';
    const rensaEl = app.querySelector<HTMLButtonElement>('#rensa')!;
    const rensaText = app.querySelector<HTMLElement>('#rensa-text')!;
    const filterAntal = app.querySelector<HTMLElement>('#filter-antal')!;
    const oppnaFilter = app.querySelector<HTMLButtonElement>('#oppna-filter')!;
    const stangFilter = app.querySelector<HTMLButtonElement>('#stang-filter')!;
    const filterSkugga = app.querySelector<HTMLElement>('#filter-skugga')!;
    const visaUrval = app.querySelector<HTMLButtonElement>('#visa-urval')!;
    const panel = app.querySelector<HTMLElement>('#panel')!;
    const vyLista = app.querySelector<HTMLElement>('#vy-lista')!;
    const vyDetalj = app.querySelector<HTMLElement>('#vy-detalj');
    const grepp = app.querySelector<HTMLButtonElement>('#grepp');
    const greppText = app.querySelector<HTMLElement>('#grepptext');
    const rubrik = app.querySelector<HTMLElement>('#rubrik');
    const antalTal = app.querySelector<HTMLElement>('#antal-tal');
    const antalNot = app.querySelector<HTMLElement>('#antal-not');
    const ingress = app.querySelector<HTMLElement>('#ingress');
    const brod = app.querySelector<HTMLElement>('#brod');
    const sokFalt = document.querySelector<HTMLInputElement>('#sok');
    const sokLada = document.querySelector<HTMLElement>('#sokresultat');
    const smal = window.matchMedia('(max-width: 900px)');
    const medlemsknapp = app.querySelector<HTMLButtonElement>('#visa-medlemmar');
    const medlemskort = app.querySelector<HTMLElement>('#medlemskort');
    const medlemsdata = JSON.parse(document.getElementById('medlemsdata')?.textContent || 'null') as Medlemsvy | null;

    const FARG: Record<string, string> = {
      bolag: '#2d492d', enskild_firma: '#478547', myndighet: '#2d2920', kommun_region: '#6d665f',
      larosate: '#926516', community: '#a35c29', finansiar: '#955023', infrastruktur: '#52667a',
    };
    const BLACK = '#1c1a17';
    const SVERIGE: [[number, number], [number, number]] = [[10.6, 55.1], [24.4, 69.2]];
    const FACETTER: FacettNamn[] = ['erbjuder', 'typ', 'omrade', 'lan'];
    const stdRubrik = rubrik?.textContent ?? '';
    const stdIngress = ingress?.innerHTML ?? '';
    const start = new URLSearchParams(location.search);

    let alla: Rad[] = [];
    let urval: Rad[] = [];
    let platser: PlatsTraff[] = [];
    let kommun = '';
    let valdId = medKarta ? start.get('org') : null;
    // Sant när detaljvyn har en egen post i webbläsarens historik, så att Bakåt stänger den.
    let detaljIHistorik = false;
    let karta: MapLibreMap | null = null;
    let kartaKlar = false;
    // Mittpunkt per län och kommun, räknad på alla organisationer. Där ritas platsens grupp.
    let mitt = { lan: new Map<string, [number, number]>(), kommun: new Map<string, [number, number]>() };
    // Följer med kartans egna kamerarörelser, så att de går att skilja från besökarens.
    const AV_KOD = { avKod: true };
    // Organisationer som är ensamma på sin plats i urvalet och därför ritas som sig själva.
    let ensamma = { lan: new Set<string>(), kommun: new Set<string>() };
    let tips: Popup | null = null;
    let sokVal: SokVal[] = [];
    let sokAktiv = -1;
    // Medlemsvyn: organisationerna göms och föreningens medlemmar visas som antal per region.
    let medlemslage = medKarta && !!medlemsdata && start.get('vy') === 'medlemmar';

    const normalisera = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const plural = (n: number) => (n === 1 ? 'organisation' : 'organisationer');

    function datum(iso: string | null): string {
      if (!iso) return '–';
      const [y, m, dd] = iso.split('-').map(Number);
      const manader = ['jan', 'feb', 'mars', 'april', 'maj', 'juni', 'juli', 'aug', 'sep', 'okt', 'nov', 'dec'];
      return `${dd} ${manader[(m ?? 1) - 1]} ${y}`;
    }

    function initialer(namn: string): string {
      const ord = namn.replace(/[^\p{L}\p{N}\s]/gu, ' ').split(/\s+/).filter(Boolean);
      if (!ord.length) return '?';
      return (ord.length === 1 ? ord[0].slice(0, 2) : ord[0][0] + ord[1][0]).toUpperCase();
    }

    // Platshållare tills organisationerna har logotyper: typens ikon om den finns, annars initialer i typens färg.
    function logoHtml(o: Post, klass = ''): string {
      const bild = typikoner[o.t];
      if (bild) return `<span class="logo logo--ikon ${klass}" aria-hidden="true"><img src="${esc(bild)}" alt="" loading="lazy" decoding="async"></span>`;
      return `<span class="logo ${klass}" style="--f:${FARG[o.t] || FARG.bolag}" aria-hidden="true">${esc(initialer(o.n))}</span>`;
    }

    /* ---------- Filter ---------- */

    function lasFilter(): Filter {
      const fd = new FormData(form);
      return {
        q: (sokFalt?.value ?? '').trim(),
        erbjuder: fd.getAll('erbjuder').map(String),
        typ: fd.getAll('typ').map(String),
        omrade: fd.getAll('omrade').map(String),
        lan: String(fd.get('lan') || ''),
        kommun,
      };
    }

    function sattVal(namn: string, varden: string[]) {
      form.querySelectorAll<HTMLInputElement>(`input[name="${namn}"]`).forEach((i) => (i.checked = varden.includes(i.value)));
    }

    /** Sant om posten klarar filtret. `utom` hoppar över en facett, för att räkna antal per val. */
    function passar(o: Rad, f: Filter, ord: string[], utom?: FacettNamn): boolean {
      if (ord.length && !ord.every((t) => o.ns.includes(t))) return false;
      if (utom !== 'erbjuder' && f.erbjuder.length && !f.erbjuder.some((x) => o.o.includes(x))) return false;
      if (utom !== 'typ' && f.typ.length && !f.typ.includes(o.t)) return false;
      if (utom !== 'omrade' && f.omrade.length && !f.omrade.some((x) => o.a.includes(x))) return false;
      if (utom !== 'lan') {
        if (f.lan && o.l !== f.lan) return false;
        if (f.kommun && o.k !== f.kommun) return false;
      }
      return true;
    }

    const sokord = (q: string) => normalisera(q).split(/\s+/).filter(Boolean);

    function skrivUrl(f: Filter, nyPost = false) {
      const p = new URLSearchParams();
      if (f.q) p.set('q', f.q);
      if (f.erbjuder.length) p.set('erbjuder', f.erbjuder.join(','));
      if (f.typ.length) p.set('typ', f.typ.join(','));
      if (f.omrade.length) p.set('omrade', f.omrade.join(','));
      if (f.lan) p.set('lan', f.lan);
      if (f.kommun) p.set('kommun', f.kommun);
      if (valdId) p.set('org', valdId);
      if (medlemslage) p.set('vy', 'medlemmar');
      const qs = p.toString();
      const adress = qs ? `?${qs}` : location.pathname;
      if (nyPost) history.pushState(null, '', adress);
      else history.replaceState(null, '', adress);
    }

    function lasUrl(p: URLSearchParams) {
      const lista = (namn: string) => (p.get(namn) || '').split(',').filter(Boolean);
      kommun = p.get('kommun') || '';
      if (sokFalt) sokFalt.value = p.get('q') || '';
      sattVal('erbjuder', lista('erbjuder'));
      sattVal('typ', lista('typ'));
      sattVal('omrade', lista('omrade'));
      // En kommun ligger alltid i ett län; koden börjar med länets två siffror.
      sattVal('lan', [p.get('lan') || kommun.slice(0, 2)]);
    }

    function filtrera(skriv = true) {
      const f = lasFilter();
      const ord = sokord(f.q);
      urval = alla.filter((o) => passar(o, f, ord));
      renderLista();
      uppdateraHuvud(f);
      uppdateraFacetter(f, ord);
      if (karta && kartaKlar) uppdateraKarta();
      if (skriv) skrivUrl(f);
    }

    function platsNamn(f: Filter): string | null {
      if (f.kommun) return alla.find((o) => o.k === f.kommun)?.kn ?? null;
      if (f.lan) return etiketter.lan[f.lan] ?? null;
      return null;
    }

    function uppdateraHuvud(f: Filter) {
      const n = urval.length;
      const utanPlats = urval.filter((o) => o.lat === null).length;
      antalEl.textContent = `${n} ${plural(n)}`;
      visaUrval.textContent = `Visa ${n} ${plural(n)}`;

      const plats = platsNamn(f);
      if (rubrik) rubrik.textContent = plats ?? stdRubrik;
      if (antalTal) antalTal.textContent = n === alla.length ? String(n) : `${n} av ${alla.length}`;
      if (antalNot) antalNot.textContent = plural(n) + (medKarta && utanPlats ? ` · ${utanPlats} utan plats på kartan` : '');
      if (ingress) {
        if (plats) ingress.textContent = `Organisationer som bygger AI i ${plats}. Varje uppgift har källa, datum och status.`;
        else ingress.innerHTML = stdIngress;
      }
      if (brod) {
        const lanNamn = f.lan ? etiketter.lan[f.lan] ?? f.lan : '';
        const delar: string[] = [];
        if (!f.lan && !f.kommun) delar.push('<li aria-current="page">Sverige</li>');
        else delar.push('<li><button type="button" data-brod="sverige">Sverige</button></li>');
        if (f.lan && f.kommun) delar.push(`<li><button type="button" data-brod="lan">${esc(lanNamn)}</button></li>`);
        else if (f.lan) delar.push(`<li aria-current="page">${esc(lanNamn)}</li>`);
        if (f.kommun) delar.push(`<li aria-current="page">${esc(plats ?? f.kommun)}</li>`);
        brod.innerHTML = delar.join('');
      }

      const aktiva = f.erbjuder.length + f.typ.length + f.omrade.length + (f.lan || f.kommun ? 1 : 0);
      rensaEl.hidden = aktiva === 0 && !f.q;
      rensaText.textContent = aktiva ? `Rensa ${aktiva} filter` : 'Rensa sökningen';
      filterAntal.hidden = aktiva === 0;
      filterAntal.textContent = String(aktiva);
      oppnaFilter.classList.toggle('fknapp--aktiv', aktiva > 0);
      uppdateraGrepp();
    }

    /** Räknar om antalet per val, givet alla andra filter, och markerar aktiva piller. */
    function uppdateraFacetter(f: Filter, ord: string[]) {
      for (const namn of FACETTER) {
        const antal = new Map<string, number>();
        for (const o of alla) {
          if (!passar(o, f, ord, namn)) continue;
          const varden = namn === 'erbjuder' ? o.o : namn === 'omrade' ? o.a : namn === 'typ' ? [o.t] : o.l ? [o.l] : [];
          for (const v of varden) antal.set(v, (antal.get(v) ?? 0) + 1);
        }
        form.querySelectorAll<HTMLElement>(`[data-antal^="${namn}:"]`).forEach((el) => {
          const n = antal.get(el.dataset.antal!.slice(namn.length + 1)) ?? 0;
          el.textContent = String(n);
          el.closest('.val')?.classList.toggle('val--tom', n === 0);
        });
        const valda = namn === 'lan' ? (f.lan ? 1 : 0) : f[namn].length;
        const pill = form.querySelector<HTMLElement>(`.fpill[data-facett="${namn}"]`)!;
        const marke = pill.querySelector<HTMLElement>('.fknapp__antal')!;
        pill.classList.toggle('fpill--aktiv', valda > 0);
        marke.hidden = valda === 0;
        marke.textContent = String(valda);
      }
    }

    /**
     * Sätter plats (län och eventuell kommun) och visar den i listan och på kartan.
     * Vid utzoomning rörs inte kameran, eftersom besökaren redan har flyttat den.
     */
    function sattPlats(lan: string, nyKommun = '', utzoomning = false) {
      lamnaMedlemsvy();
      kommun = nyKommun;
      sattVal('lan', [lan]);
      const vald = valdId ? alla.find((o) => o.id === valdId) : undefined;
      const paPlatsen = !!vald && (!lan || vald.l === lan) && (!nyKommun || vald.k === nyKommun);
      // Detaljvyn står kvar om organisationen ligger på platsen: då zoomar kartan in runt den.
      // En utzoomning vidgar bara platsen och stänger därför aldrig det besökaren läser.
      if (!utzoomning && !paPlatsen) stangDetalj(false);
      // Platsen har ändrats under en öppen detaljvy. Posten före den i historiken bär den gamla
      // platsen, så Tillbaka ska stänga detaljvyn här i stället för att backa dit.
      else if (vald) detaljIHistorik = false;
      filtrera();
      if (!utzoomning) passaKarta();
    }

    function rensa(vad: string) {
      if (vad === 'alla') {
        for (const namn of ['erbjuder', 'typ', 'omrade']) sattVal(namn, []);
        if (sokFalt) sokFalt.value = '';
        sattPlats('');
        return;
      }
      if (vad === 'lan') return sattPlats('');
      sattVal(vad, []);
      filtrera();
    }

    /* ---------- Lista ---------- */

    /** Länk till systersajten AI-Infra: leverantörens egen sida om den finns där, annars översikten. */
    function infralank(rubrik: string, text: string, adress: string): string {
      return (
        `<a class="infralank" href="${esc(adress)}" rel="noopener"><img class="infralank__logo" src="${esc(infralogo)}" alt="" width="44" height="44" />` +
        `<span class="infralank__text"><strong>${rubrik}</strong><span>${text}</span></span>${ikon('ut', 18)}</a>`
      );
    }

    function kortHtml(o: Rad): string {
      const chips = o.o.slice(0, 3).map((x) => `<span class="chip">${esc(etiketter.erbjuder[x] || x)}</span>`).join('');
      const fler = o.o.length > 3 ? `<span class="chip">+${o.o.length - 3}</span>` : '';
      const bekr = o.c > 0 ? `<span class="chip chip--bekr"><span class="chip__prick"></span>${o.c} av ${o.f} fält bekräftade</span>` : '';
      return (
        `<a class="post__lank" href="${orgbas}${encodeURIComponent(o.id)}">${logoHtml(o)}` +
        `<span class="post__huvud"><span class="post__rad"><span class="post__namn">${esc(o.n)}</span>${o.i ? '<span class="post__marke">AI-Infra</span>' : ''}</span>` +
        `<span class="post__under">${esc(o.kn ?? 'Utan plats')} · ${esc(etiketter.typer[o.t] || o.t)}</span></span>` +
        `<span class="post__text">${esc(o.d)}</span>` +
        `<span class="post__chips">${chips}${fler}${bekr}</span></a>`
      );
    }

    /** Urvalet i den ordning listan visar det. */
    function sorterat(): Rad[] {
      const poster = urval.slice();
      if (sortEl.value === 'kontroll') poster.sort((a, b) => (b.s ?? '').localeCompare(a.s ?? '') || a.n.localeCompare(b.n, 'sv'));
      else poster.sort((a, b) => a.n.localeCompare(b.n, 'sv'));
      return poster;
    }

    function renderLista() {
      const frag = document.createDocumentFragment();
      const sorterade = sorterat();
      const f = lasFilter();
      // Den som letar infrastruktur får veta att leverantörerna jämförs i detalj på systersajten.
      if (sorterade.length && (f.typ.includes('infrastruktur') || f.erbjuder.includes('infrastruktur'))) {
        const li = document.createElement('li');
        li.innerHTML = infralank('AI-infrastruktur i detalj', 'Pris, datacenter och ägande per leverantör på AI-Infra', infra);
        frag.appendChild(li);
      }
      for (const o of sorterade) {
        const li = document.createElement('li');
        li.className = 'post' + (o.id === valdId ? ' post--aktiv' : '');
        li.dataset.id = o.id;
        li.innerHTML = kortHtml(o);
        frag.appendChild(li);
      }
      if (!sorterade.length && alla.length) {
        const li = document.createElement('li');
        li.className = 'lista__tom';
        li.innerHTML = `<strong>Inga organisationer matchar.</strong><span>Ta bort ett filter eller sök bredare. Saknas någon? <a href="${bidra}">Lägg till en organisation.</a></span>`;
        frag.appendChild(li);
      }
      lista.replaceChildren(frag);
    }

    /* ---------- Detaljvy ---------- */

    function detaljHtml(o: Rad): string {
      const lista = (varden: string[], karta: Record<string, string>) => varden.map((x) => karta[x] || x).join(', ') || '–';
      const rutor: [IkonNamn, string, string][] = [
        ['tagg', 'Typ', etiketter.typer[o.t] || o.t],
        ['nal', 'Plats', o.kn ? `${o.kn}${o.ln ? `, ${o.ln}` : ''}` : 'Saknar plats'],
        ['lager', 'Erbjuder', lista(o.o, etiketter.erbjuder)],
        ['kompass', 'Område', lista(o.a, etiketter.omraden)],
        ['bock', 'Bekräftade fält', `${o.c} av ${o.f}`],
        ['kalender', 'Senast kontrollerad', datum(o.s)],
      ];
      const webb = /^https?:\/\//.test(o.w)
        ? `<a class="rundknapp rundknapp--kant" href="${esc(o.w)}" target="_blank" rel="noopener" aria-label="Webbplats för ${esc(o.n)}, öppnas i ny flik" title="Webbplats">${ikon('glob', 20)}</a>`
        : '';
      return (
        `<article class="detalj" style="--f:${FARG[o.t] || FARG.bolag}">` +
        `<div class="detalj__banner"><button type="button" class="rundknapp" data-tillbaka aria-label="Tillbaka till listan">${ikon('vanster', 20)}</button></div>` +
        `<div class="detalj__kropp">${logoHtml(o, 'logo--stor')}` +
        `<h2 class="detalj__namn" tabindex="-1">${esc(o.n)}</h2>` +
        `<p class="detalj__text">${esc(o.d)}</p>` +
        `<p class="kicker detalj__kicker">Detaljer</p>` +
        `<dl class="rutor">${rutor.map(([i, e, v]) => `<div><dt>${ikon(i, 16)}${e}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl>` +
        (o.i
          ? infralank('Finns på AI-Infra', 'Pris, datacenter och ägande, med källa på varje uppgift', `${infra}/leverantor/${encodeURIComponent(o.i)}`)
          : o.t === 'infrastruktur' || o.o.includes('infrastruktur')
            ? infralank('Jämför AI-infrastruktur', 'Svenska och europeiska leverantörer på AI-Infra', infra)
            : '') +
        `<p class="detalj__ratta">Fel eller inaktuellt? <a href="${orgbas}${encodeURIComponent(o.id)}#ratta">Begär rättelse</a></p>` +
        (o.pt === 'kommun' ? '<p class="meta detalj__not">Positionen visas på kommunnivå, aldrig som gatuadress.</p>' : '') +
        `</div>` +
        `<div class="detalj__fot">${webb}` +
        `<button type="button" class="rundknapp rundknapp--kant" data-kopiera aria-label="Kopiera länk till organisationen" title="Kopiera länk">${ikon('lank', 20)}</button>` +
        `<a class="detalj__cta" href="${orgbas}${encodeURIComponent(o.id)}">Källor och belägg ${ikon('hoger', 18)}</a></div>` +
        `</article>`
      );
    }

    function visaDetalj(o: Rad, flyg = true, nyPost = true) {
      if (!vyDetalj) return;
      lamnaMedlemsvy();
      // Bara första öppningen lägger en post i historiken. Byte mellan organisationer ersätter den.
      const iHistorik = nyPost && vyDetalj.hidden;
      valdId = o.id;
      vyDetalj.innerHTML = detaljHtml(o);
      vyDetalj.hidden = false;
      vyDetalj.scrollTop = 0;
      vyLista.hidden = true;
      app.classList.remove('app--utan-panel');
      sattBlad('oppen');
      lista.querySelectorAll('.post--aktiv').forEach((el) => el.classList.remove('post--aktiv'));
      lista.querySelector(`[data-id="${CSS.escape(o.id)}"]`)?.classList.add('post--aktiv');
      vyDetalj.querySelector<HTMLElement>('.detalj__namn')?.focus({ preventScroll: true });
      skrivUrl(lasFilter(), iHistorik);
      if (iHistorik) detaljIHistorik = true;
      uppdateraGrepp();
      if (karta && kartaKlar) {
        uppdateraVald();
        if (flyg && o.lat !== null && o.lng !== null) {
          karta.resize();
          // Ända in till nivån där organisationerna ritas, så att den valda syns bland sina grannar.
          karta.flyTo({ center: [o.lng, o.lat], zoom: Math.max(karta.getZoom(), ZOOM_POSTER + 0.5) }, AV_KOD);
        }
      }
    }

    function stangDetalj(skriv = true, fokus = skriv) {
      if (!vyDetalj || vyDetalj.hidden) return;
      const id = valdId;
      valdId = null;
      detaljIHistorik = false;
      vyDetalj.hidden = true;
      vyDetalj.replaceChildren();
      vyLista.hidden = false;
      if (id) {
        const rad = lista.querySelector<HTMLElement>(`[data-id="${CSS.escape(id)}"]`);
        rad?.classList.remove('post--aktiv');
        rad?.scrollIntoView({ block: 'nearest' });
        if (fokus) rad?.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      }
      if (karta && kartaKlar) uppdateraVald();
      if (skriv) skrivUrl(lasFilter());
      uppdateraGrepp();
    }

    /* ---------- Bottenblad i smal vy ---------- */

    function sattBlad(lage: 'titt' | 'oppen') {
      panel.dataset.blad = lage;
      grepp?.setAttribute('aria-expanded', String(lage === 'oppen'));
      // I tittläget syns bara greppet; innehållet ska inte gå att tabba in i.
      const dolt = medKarta && smal.matches && lage === 'titt';
      vyLista.inert = dolt;
      if (vyDetalj) vyDetalj.inert = dolt;
      uppdateraGrepp();
    }

    function uppdateraGrepp() {
      if (!greppText) return;
      if (panel.dataset.blad === 'oppen') greppText.textContent = 'Visa kartan';
      else if (valdId) greppText.textContent = alla.find((o) => o.id === valdId)?.n ?? 'Visa listan';
      else greppText.textContent = alla.length ? `${urval.length} ${plural(urval.length)} · visa listan` : 'Visa listan';
    }

    /* ---------- Sök ---------- */

    // Sökmotorn ligger bakom ett enda anrop så att den kan bytas mot ett färdigt index
    // utan att gränssnittet ändras. I dag räcker en genomgång i minnet: några hundra poster.
    function sok(q: string): SokTraff {
      const nq = normalisera(q.trim());
      const ord = nq.split(/\s+/).filter(Boolean);
      if (!ord.length) return { org: [], platser: platser.filter((p) => p.typ === 'kommun').slice(0, 5), totalt: 0 };
      const poang = (o: Rad): number => {
        if (!ord.every((t) => o.ns.includes(t))) return -1;
        if (o.nn === nq) return 100;
        if (o.nn.startsWith(nq)) return 80;
        if (o.nn.split(/[\s\-–.]+/).some((w) => w.startsWith(ord[0]))) return 60;
        if (o.nn.includes(nq)) return 40;
        return 10;
      };
      const traffar = alla.map((o) => ({ o, p: poang(o) })).filter((x) => x.p >= 0);
      traffar.sort((a, b) => b.p - a.p || a.o.n.localeCompare(b.o.n, 'sv'));
      const platsTraffar = platser
        .filter((p) => ord.every((t) => p.nn.includes(t)))
        .sort((a, b) => Number(b.nn.startsWith(nq)) - Number(a.nn.startsWith(nq)) || b.antal - a.antal);
      return { org: traffar.slice(0, 6).map((x) => x.o), platser: platsTraffar.slice(0, 4), totalt: traffar.length };
    }

    /** Namnet med träffen i fetstil. Normaliseringen behåller längden för svenska tecken. */
    function markera(text: string, q: string): string {
      const nt = normalisera(text);
      const ord = sokord(q)[0];
      const i = ord ? nt.indexOf(ord) : -1;
      if (i < 0 || nt.length !== text.length) return esc(text);
      return `${esc(text.slice(0, i))}<mark>${esc(text.slice(i, i + ord.length))}</mark>${esc(text.slice(i + ord.length))}`;
    }

    function renderSok() {
      if (!sokLada || !sokFalt) return;
      const q = sokFalt.value.trim();
      const t = sok(q);
      sokVal = [];
      sokAktiv = -1;
      const rad = (v: SokVal, bild: string, namn: string, under: string) => {
        const i = sokVal.push(v) - 1;
        return (
          `<div class="sokval" role="option" id="sokval-${i}" data-i="${i}" aria-selected="false">${bild}` +
          `<span class="sokval__text"><span class="sokval__namn">${namn}</span><span class="sokval__under">${under}</span></span></div>`
        );
      };
      let html = '';
      // Påskägget: den som söker på föreningen eller på kräftan får vägen till medlemsvyn.
      if (arPaskagg(q)) {
        const bild = `<span class="logo logo--liten logo--ikon" aria-hidden="true"><img src="${esc(app.dataset.kraftan ?? '')}" alt=""></span>`;
        html += '<div role="group" aria-label="OpenSverige"><p class="sokgrupp">Du hittade kräftan</p>';
        html += rad({ typ: 'vy' }, bild, 'Var är OpenSverige?', 'Visa medlemmarna på kartan, region för region');
        html += '</div>';
      }
      if (t.org.length) {
        html += '<div role="group" aria-label="Organisationer"><p class="sokgrupp">Organisationer</p>';
        for (const o of t.org) html += rad({ typ: 'org', o }, logoHtml(o, 'logo--liten'), markera(o.n, q), `${esc(o.kn ?? 'Utan plats')} · ${esc(etiketter.typer[o.t] || o.t)}`);
        html += '</div>';
      }
      if (t.platser.length) {
        const titel = q ? 'Platser' : 'Hoppa till en plats';
        html += `<div role="group" aria-label="${titel}"><p class="sokgrupp">${titel}</p>`;
        for (const p of t.platser) html += rad({ typ: 'plats', p }, `<span class="logo logo--liten logo--plats" aria-hidden="true">${ikon('nal', 17)}</span>`, markera(p.namn, q), `${esc(p.under)} · ${p.antal} ${plural(p.antal)}`);
        html += '</div>';
      }
      if (!sokVal.length) {
        html = `<p class="soktom"><strong>Inga träffar på ”${esc(q)}”.</strong> Sökningen går på namn, beskrivning, plats, typ och område.</p>`;
      }
      const fot = q
        ? `<span class="sokfot__antal">${t.totalt} ${t.totalt === 1 ? 'träff' : 'träffar'} i listan</span>`
        : '<span class="sokfot__antal">Skriv för att söka direkt</span>';
      sokLada.innerHTML =
        `<div class="soklista" role="listbox" id="soklista" aria-label="Sökträffar">${html}</div>` +
        `<p class="sokfot" aria-hidden="true">${fot}<span class="sokfot__tang"><kbd>↑</kbd><kbd>↓</kbd> bläddra <kbd>↵</kbd> öppna <kbd>esc</kbd> stäng</span></p>`;
      sokFalt.removeAttribute('aria-activedescendant');
    }

    function oppnaSok() {
      if (!sokLada || !sokFalt || !alla.length) return;
      renderSok();
      sokLada.hidden = false;
      sokFalt.setAttribute('aria-expanded', 'true');
    }

    function stangSok() {
      if (!sokLada || !sokFalt) return;
      sokLada.hidden = true;
      sokFalt.setAttribute('aria-expanded', 'false');
      sokFalt.removeAttribute('aria-activedescendant');
      sokAktiv = -1;
    }

    function markeraSokval(i: number) {
      if (!sokLada || !sokFalt || !sokVal.length) return;
      sokAktiv = (i + sokVal.length) % sokVal.length;
      sokLada.querySelectorAll<HTMLElement>('.sokval').forEach((el) => {
        const aktiv = Number(el.dataset.i) === sokAktiv;
        el.setAttribute('aria-selected', String(aktiv));
        if (aktiv) el.scrollIntoView({ block: 'nearest' });
      });
      sokFalt.setAttribute('aria-activedescendant', `sokval-${sokAktiv}`);
    }

    function valjSokval(v: SokVal) {
      stangSok();
      sokFalt?.blur();
      if (v.typ === 'vy') {
        if (!medKarta) return void (location.href = `${app.dataset.kartbas ?? '/'}?vy=medlemmar`);
        if (sokFalt) sokFalt.value = '';
        filtrera(false);
        return sattMedlemsvy(true);
      }
      if (v.typ === 'org') {
        if (medKarta) visaDetalj(v.o);
        else location.href = `${orgbas}${encodeURIComponent(v.o.id)}`;
        return;
      }
      if (sokFalt) sokFalt.value = '';
      if (v.p.typ === 'lan') sattPlats(v.p.kod);
      else sattPlats(v.p.kod.slice(0, 2), v.p.kod);
      if (smal.matches) sattBlad('oppen');
    }

    function kopplaSok() {
      if (!sokFalt || !sokLada) return;
      sokFalt.setAttribute('role', 'combobox');
      sokFalt.setAttribute('aria-autocomplete', 'list');
      sokFalt.setAttribute('aria-controls', 'soklista');
      sokFalt.setAttribute('aria-expanded', 'false');
      sokFalt.form?.addEventListener('submit', (e) => e.preventDefault());
      sokFalt.addEventListener('input', () => {
        stangDetalj(false);
        filtrera();
        oppnaSok();
      });
      sokFalt.addEventListener('focus', oppnaSok);
      sokFalt.addEventListener('click', () => sokLada.hidden && oppnaSok());
      sokFalt.addEventListener('blur', () => setTimeout(() => !sokLada.contains(document.activeElement) && stangSok(), 120));
      sokFalt.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          if (sokLada.hidden) oppnaSok();
          markeraSokval(sokAktiv + (e.key === 'ArrowDown' ? 1 : sokAktiv < 0 ? 0 : -1));
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (sokAktiv >= 0 && sokVal[sokAktiv]) valjSokval(sokVal[sokAktiv]);
          else if (arPaskagg(sokFalt.value)) valjSokval({ typ: 'vy' });
          else {
            // Den som söker vidare vill se organisationer, inte medlemsvyn.
            lamnaMedlemsvy();
            stangSok();
            sokFalt.blur();
            if (smal.matches) sattBlad('oppen');
          }
        } else if (e.key === 'Escape') {
          if (!sokLada.hidden) stangSok();
          else sokFalt.blur();
        }
      });
      // mousedown i stället för click: valet ska hinna före fältets blur.
      sokLada.addEventListener('mousedown', (e) => {
        e.preventDefault();
        const el = (e.target as HTMLElement).closest<HTMLElement>('.sokval');
        const v = el ? sokVal[Number(el.dataset.i)] : undefined;
        if (v) valjSokval(v);
      });
      sokLada.addEventListener('mousemove', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('.sokval');
        if (el && Number(el.dataset.i) !== sokAktiv) markeraSokval(Number(el.dataset.i));
      });
    }

    /* ---------- Karta ---------- */

    const kartMarginal = (): Required<PaddingOptions> =>
      smal.matches ? { top: 84, bottom: 96, left: 24, right: 24 } : { top: 96, bottom: 48, left: 48, right: 72 };

    /** `el` och `ek` säger om organisationen är ensam i sitt län respektive sin kommun och då ritas som sig själv. */
    function tillGeoJson(poster: Post[], ensamILan?: Set<string>, ensamIKommun?: Set<string>): GeoJSON.FeatureCollection {
      return {
        type: 'FeatureCollection',
        features: poster
          .filter((o) => o.lat !== null && o.lng !== null)
          .map((o) => ({
            type: 'Feature',
            geometry: { type: 'Point', coordinates: [o.lng as number, o.lat as number] },
            properties: { id: o.id, n: o.n, t: o.t, k: o.k ?? '', el: ensamILan?.has(o.id) ?? false, ek: ensamIKommun?.has(o.id) ?? false },
          })),
      };
    }

    function grupperSomGeoJson(grupper: Platsgrupp[]): GeoJSON.FeatureCollection {
      return {
        type: 'FeatureCollection',
        features: grupper.map((g) => ({
          type: 'Feature',
          geometry: { type: 'Point', coordinates: [g.lng, g.lat] },
          properties: { kod: g.kod, n: g.namn, antal: g.antal },
        })),
      };
    }

    function uppdateraKarta() {
      const lan = grupperaPerPlats(urval, 'lan', mitt.lan);
      const kommuner = grupperaPerPlats(urval, 'kommun', mitt.kommun);
      ensamma = { lan: lan.ensamma, kommun: kommuner.ensamma };
      (karta!.getSource('orgs') as GeoJSONSource | undefined)?.setData(tillGeoJson(urval, lan.ensamma, kommuner.ensamma));
      (karta!.getSource('lan-grupper') as GeoJSONSource | undefined)?.setData(grupperSomGeoJson(lan.grupper));
      (karta!.getSource('kommun-grupper') as GeoJSONSource | undefined)?.setData(grupperSomGeoJson(kommuner.grupper));
      uppdateraVald();
    }

    // Den valda organisationen ritas i en egen källa, ovanpå allt annat. Ligger den inne i en grupp
    // markeras den inte, för ringen skulle täcka gruppens siffra. Har ett filter tagit bort den ur
    // urvalet finns den inte i någon grupp, och då ritas den på alla nivåer.
    function uppdateraVald() {
      const o = valdId ? alla.find((x) => x.id === valdId) : undefined;
      const utanfor = o && !urval.includes(o) ? new Set([o.id]) : undefined;
      (karta!.getSource('vald') as GeoJSONSource | undefined)?.setData(tillGeoJson(o ? [o] : [], utanfor ?? ensamma.lan, utanfor ?? ensamma.kommun));
    }

    /**
     * Zoomar till urvalet om en plats är vald, annars till hela Sverige. Ligger urvalet i en
     * enda kommun går kartan ända in till organisationerna, annars stannar den på kommunnivån.
     */
    function passaKarta() {
      if (!karta) return;
      const f = lasFilter();
      const p = urval.filter((o) => o.lat !== null && o.lng !== null);
      if ((!f.lan && !f.kommun) || !p.length) {
        karta.fitBounds(SVERIGE, { padding: kartMarginal() }, AV_KOD);
        return;
      }
      const lng = p.map((o) => o.lng as number);
      const lat = p.map((o) => o.lat as number);
      const [v, s, o, n] = [Math.min(...lng), Math.min(...lat), Math.max(...lng), Math.max(...lat)];
      const [lagst, hogst] = zoomgranser(p);
      // Lite extra luft när kartan passas in, så att cirklar och namn inte hamnar i kanten.
      const m = kartMarginal();
      const luft = { top: m.top + 36, bottom: m.bottom + 36, left: m.left + 36, right: m.right + 36 };
      const passad = karta.cameraForBounds([[v, s], [o, n]], { padding: luft });
      karta.flyTo({ center: passad?.center ?? [(v + o) / 2, (s + n) / 2], zoom: Math.min(hogst, Math.max(lagst, passad?.zoom ?? hogst)) }, AV_KOD);
    }

    /* ---------- Medlemsvyn ---------- */

    const ORGKALLOR = ['orgs', 'lan-grupper', 'kommun-grupper', 'vald'];
    const MEDLEMSLAGER = ['medlemmar-yta', 'medlemmar-kant', 'medlemmar-ikon'];
    const KRAFTROD = '#c2511f';
    let medlemmarRitade: Promise<void> | null = null;
    let kameraFore: { center: [number, number]; zoom: number } | null = null;

    /** Organisationernas lager syns i den vanliga vyn och medlemmarnas i medlemsvyn, aldrig båda. */
    function visaMedlemslager() {
      if (!karta) return;
      for (const lager of karta.getStyle().layers) {
        const kalla = 'source' in lager ? String(lager.source) : '';
        if (ORGKALLOR.includes(kalla)) karta.setLayoutProperty(lager.id, 'visibility', medlemslage ? 'none' : 'visible');
        else if (MEDLEMSLAGER.includes(lager.id)) karta.setLayoutProperty(lager.id, 'visibility', medlemslage ? 'visible' : 'none');
      }
    }

    /** Brickans storlek: efter regionens antal, och lite mindre när hela landet ryms på en smal skärm. */
    const brickstorlek = (skala = 1) =>
      ['interpolate', ['linear'], ['zoom'], 3.3, ['*', 0.78 * skala, ['get', 'storlek']], 4.3, ['*', skala, ['get', 'storlek']]] as unknown as ExpressionSpecification;

    /** Ritas första gången vyn öppnas: en cirkel med regionens radie och föreningens kräfta i mitten. */
    async function ritaMedlemmar() {
      if (!karta || !medlemsdata) return;
      const bild = new Image();
      bild.src = app.dataset.kraftan ?? '';
      await bild.decode();
      // Bilden har egen bakgrund. Den skärs till en rund bricka med kant, så att den står ut mot kartan.
      const BREDD = 60;
      const tathet = Math.max(2, Math.min(3, Math.ceil(window.devicePixelRatio || 1)));
      const duk = document.createElement('canvas');
      duk.width = duk.height = BREDD * tathet;
      const penna = duk.getContext('2d');
      if (!penna) return;
      const mitten = duk.width / 2;
      const kant = 2.5 * tathet;
      penna.imageSmoothingQuality = 'high';
      penna.beginPath();
      penna.arc(mitten, mitten, mitten - kant / 2, 0, Math.PI * 2);
      penna.fillStyle = '#fbfaf7';
      penna.fill();
      penna.save();
      penna.clip();
      // Lite luft runt om, så att fingrarna och klon inte skärs av i brickans kant.
      const luft = duk.width * 0.07;
      penna.drawImage(bild, luft, luft, duk.width - luft * 2, duk.height - luft * 2);
      penna.restore();
      penna.lineWidth = kant;
      penna.strokeStyle = BLACK;
      penna.stroke();
      karta.addImage('kraftan', penna.getImageData(0, 0, duk.width, duk.height), { pixelRatio: tathet });

      const { regioner, radieKm } = medlemsdata;
      karta.addSource('medlemmar-ytor', {
        type: 'geojson',
        data: {
          type: 'FeatureCollection',
          features: regioner.map((r) => ({ type: 'Feature', geometry: { type: 'Polygon', coordinates: [cirkel(r.lat, r.lng, radieKm)] }, properties: { tom: r.tom } })),
        },
      });
      karta.addSource('medlemmar', {
        type: 'geojson',
        data: {
          type: 'FeatureCollection',
          features: regioner.map((r) => ({ type: 'Feature', geometry: { type: 'Point', coordinates: [r.lng, r.lat] }, properties: { n: r.namn, visat: r.visat, storlek: r.storlek, tom: r.tom, sida: r.sida } })),
        },
      });
      // En region som ingen har valt än ritas blekare: den finns, men är tom.
      const blek = (tomt: number, fullt: number) => ['case', ['get', 'tom'], tomt, fullt] as unknown as ExpressionSpecification;
      karta.addLayer({ id: 'medlemmar-yta', type: 'fill', source: 'medlemmar-ytor', paint: { 'fill-color': KRAFTROD, 'fill-opacity': blek(0.04, 0.16) } });
      karta.addLayer({
        id: 'medlemmar-kant', type: 'line', source: 'medlemmar-ytor',
        paint: { 'line-color': KRAFTROD, 'line-width': 1.5, 'line-dasharray': [3, 2.5], 'line-opacity': blek(0.5, 0.9) },
      });
      karta.addLayer({
        id: 'medlemmar-ikon', type: 'symbol', source: 'medlemmar',
        layout: {
          'icon-image': 'kraftan', 'icon-size': brickstorlek(), 'icon-allow-overlap': true,
          'text-field': ['format', ['get', 'n'], {}, '\n', {}, ['get', 'visat'], { 'font-scale': 1.3 }],
          'text-font': ['Noto Sans Bold'], 'text-size': ['interpolate', ['linear'], ['zoom'], 3.3, 11.5, 4.3, 13], 'text-line-height': 1.25, 'text-allow-overlap': true,
          // Namnet står under brickan, eller väster om den när en grannregion ligger nära i öster.
          // Avståndet följer brickan, som är 60 px bred gånger regionens storlek.
          'text-anchor': ['match', ['get', 'sida'], 'vanster', 'right', 'top'],
          'text-justify': ['match', ['get', 'sida'], 'vanster', 'right', 'center'],
          'text-radial-offset': ['+', 0.45, ['*', 2.3, ['get', 'storlek']]],
          // Störst sist, så att den ligger överst där två regioner möts.
          'symbol-sort-key': ['get', 'storlek'],
        },
        paint: { 'icon-opacity': blek(0.5, 1), 'text-color': BLACK, 'text-halo-color': '#fdfbf7', 'text-halo-width': 2 },
      });
      visaMedlemslager();
    }

    /** Brickorna landar: de växer lite för stora och sätter sig sedan. */
    function landaBrickor() {
      if (!karta || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const borjan = performance.now();
      const steg = (nu: number) => {
        if (!karta?.getLayer('medlemmar-ikon')) return;
        const t = Math.min(1, (nu - borjan) / 520);
        const skala = 1 + 2.70158 * (t - 1) ** 3 + 1.70158 * (t - 1) ** 2;
        karta.setLayoutProperty('medlemmar-ikon', 'icon-size', brickstorlek(Math.max(0.01, skala)));
        if (t < 1) requestAnimationFrame(steg);
      };
      requestAnimationFrame(steg);
    }

    /** Alla regioner i bild, med plats för kortet som ligger över kartan. */
    function passaMedlemmar() {
      if (!karta || !medlemsdata) return;
      const horn = medlemsdata.regioner.flatMap((r) => cirkel(r.lat, r.lng, medlemsdata.radieKm, 12));
      const lng = horn.map((p) => p[0]);
      const lat = horn.map((p) => p[1]);
      const kort = medlemskort?.getBoundingClientRect();
      // I smal vy ligger kortet som ett blad i botten, och knapparna och källraden flyttar upp ovanför det.
      app.style.setProperty('--medlemskort-h', `${Math.round(kort?.height ?? 0)}px`);
      const padding = smal.matches
        ? { top: 28, bottom: (kort?.height ?? 0) + 64, left: 84, right: 32 }
        : { top: 48, bottom: 48, left: (kort?.width ?? 0) + 40, right: 80 };
      karta.fitBounds([[Math.min(...lng), Math.min(...lat)], [Math.max(...lng), Math.max(...lat)]], { padding }, AV_KOD);
    }

    /**
     * Slår på eller av medlemsvyn. `flyttaKameran` är falskt när besökaren redan är på väg någon
     * annanstans, till exempel till en plats eller en organisation.
     */
    function sattMedlemsvy(pa: boolean, skriv = true, flyttaKameran = true) {
      if (!karta || !kartaKlar || !medlemsdata) return;
      const bytte = pa !== (app.dataset.vy === 'medlemmar');
      medlemslage = pa;
      if (pa) app.dataset.vy = 'medlemmar';
      else delete app.dataset.vy;
      medlemsknapp?.setAttribute('aria-pressed', String(pa));
      medlemsknapp?.setAttribute('aria-label', pa ? 'Tillbaka till organisationerna' : 'Visa var OpenSveriges medlemmar finns');
      if (medlemskort) medlemskort.hidden = !pa;
      tips?.remove();
      visaMedlemslager();
      if (pa) {
        if (bytte) kameraFore = { center: karta.getCenter().toArray() as [number, number], zoom: karta.getZoom() };
        stangDetalj(false);
        if (smal.matches) sattBlad('titt');
        medlemmarRitade ??= ritaMedlemmar().catch((fel) => console.warn('Medlemsvyn gick inte att rita', fel));
        void medlemmarRitade.then(() => medlemslage && bytte && landaBrickor());
        passaMedlemmar();
      } else {
        if (flyttaKameran && kameraFore) karta.flyTo(kameraFore, AV_KOD);
        kameraFore = null;
      }
      if (skriv) skrivUrl(lasFilter());
    }

    /** Den som går till en plats eller en organisation lämnar medlemsvyn. */
    function lamnaMedlemsvy() {
      if (medlemslage) sattMedlemsvy(false, false, false);
    }

    async function startaKarta() {
      const el = document.getElementById('karta');
      if (!el) return;
      // Typikonerna hämtas och avkodas medan kartbiblioteket laddas, så att landmärkena kan ritas direkt.
      const ikonbilder = Promise.allSettled(
        Object.keys(typikoner).map(async (typ): Promise<[string, HTMLImageElement]> => {
          const bild = new Image();
          bild.src = typikoner[typ];
          await bild.decode();
          return [typ, bild];
        }),
      );
      const { Map: Karta, Popup: Tips, setWorkerUrl } = await import('maplibre-gl');
      // Workern serveras från sajten; se scripts/kopiera-maplibre-worker.mjs.
      if (app.dataset.worker) setWorkerUrl(new URL(app.dataset.worker, location.href).href);
      karta = new Karta({
        container: el,
        style: 'https://tiles.openfreemap.org/styles/positron',
        // Hela Sverige i bild oavsett skärmstorlek.
        bounds: SVERIGE,
        fitBoundsOptions: { padding: kartMarginal() },
        minZoom: 3,
        maxZoom: 14,
        attributionControl: { compact: true },
      });
      (window as unknown as { aiKartan?: unknown }).aiKartan = { karta };
      karta.on('load', () => {
        // Positron är kallgrå. Några ytor värms upp så att kartan hör ihop med gränssnittet.
        const varm: [string, 'background-color' | 'fill-color', string][] = [
          ['background', 'background-color', '#f2eee5'],
          ['water', 'fill-color', '#d5dce1'],
          ['park', 'fill-color', '#e6e7d8'],
          ['landcover_wood', 'fill-color', '#e5e6d7'],
          ['landuse_residential', 'fill-color', '#ece7db'],
          ['building', 'fill-color', '#e6e0d3'],
        ];
        for (const [id, egenskap, farg] of varm) if (karta!.getLayer(id)) karta!.setPaintProperty(id, egenskap, farg);

        // Positioner ligger på kommunnivå, så organisationerna räknas ihop per plats och inte
        // per pixelavstånd: län när hela landet syns, kommuner på vägen in, och organisationerna
        // själva från ZOOM_POSTER. En organisation som är ensam på sin plats ritas alltid som sig själv.
        karta!.addSource('orgs', { type: 'geojson', data: tillGeoJson(urval) });
        karta!.addSource('lan-grupper', { type: 'geojson', data: grupperSomGeoJson([]) });
        karta!.addSource('kommun-grupper', { type: 'geojson', data: grupperSomGeoJson([]) });
        karta!.addSource('vald', { type: 'geojson', data: tillGeoJson([]) });
        // Störst underst, så att en liten grupp aldrig göms bakom en stor.
        const minstOverst = ['-', ['get', 'antal']] as unknown as ExpressionSpecification;
        // Cirkelns radie efter antal. Längst ut på varje nivå krymper grupperna, annars täcker
        // grannar varandra: länen kring Mälaren när hela landet är i bild, och förorterna runt en storstad.
        const radie = ['step', ['get', 'antal'], 15, 5, 19, 20, 24, 60, 30];
        const mellan = (fran: number, till: number, litet: unknown, fullt: unknown) =>
          ['interpolate', ['linear'], ['zoom'], fran, litet, till, fullt] as unknown as ExpressionSpecification;
        // En genomskinlig bild som bara tar plats: den håller platsnamnen borta från cirklarna.
        karta!.addImage('tom', { width: 1, height: 1, data: new Uint8Array(4) });
        type Gruppniva = { niva: 'lan' | 'kommun'; zoom: { minzoom?: number; maxzoom?: number }; fran: number; till: number };
        const GRUPPNIVAER: Gruppniva[] = [
          { niva: 'lan', zoom: { maxzoom: ZOOM_KOMMUN }, fran: 3.5, till: 5.5 },
          { niva: 'kommun', zoom: { minzoom: ZOOM_KOMMUN, maxzoom: ZOOM_POSTER }, fran: ZOOM_KOMMUN, till: ZOOM_KOMMUN + 2.5 },
        ];
        const ritaCirklar = ({ niva, zoom, fran, till }: Gruppniva) => {
          const medZoom = (litet: unknown, fullt: unknown) => mellan(fran, till, litet, fullt);
          karta!.addLayer({
            id: `${niva}-grupp`, type: 'circle', source: `${niva}-grupper`, ...zoom,
            layout: { 'circle-sort-key': minstOverst },
            paint: {
              'circle-color': BLACK,
              'circle-radius': medZoom(['*', 0.58, radie], radie),
              'circle-stroke-width': medZoom(2, 3),
              'circle-stroke-color': '#fdfbf7',
            },
          });
        };
        // Namn och siffror läggs över organisationernas lager. Kartan placerar text uppifrån och ner,
        // så platsens namn får plats före namnen på enstaka organisationer intill.
        const ritaText = ({ niva, zoom, fran, till }: Gruppniva) => {
          const medZoom = (litet: unknown, fullt: unknown) => mellan(fran, till, litet, fullt);
          // Platsens namn säger vad siffran räknar. Det läggs rakt över, under eller bredvid cirkeln, där
          // det får plats. I ett hörn hamnar det mellan två cirklar och går att läsa som grannens.
          karta!.addLayer({
            id: `${niva}-grupp-namn`, type: 'symbol', source: `${niva}-grupper`, ...zoom,
            layout: {
              'text-field': ['get', 'n'], 'text-font': ['Noto Sans Bold'], 'text-size': 12, 'text-max-width': 7, 'symbol-sort-key': minstOverst,
              'text-variable-anchor': ['top', 'bottom', 'right', 'left'], 'text-justify': 'auto',
              // Avståndet räknas en gång per heltalszoom medan cirkeln växer steglöst. Stegen ligger
              // därför en zoomnivå tidigare, så att namnet aldrig hamnar innanför cirkeln.
              'text-radial-offset': mellan(fran - 1, till - 1, ['/', ['+', ['*', 0.58, radie], 6], 12], ['/', ['+', radie, 7], 12]),
            },
            paint: { 'text-color': BLACK, 'text-halo-color': '#fdfbf7', 'text-halo-width': 1.8 },
          });
          // Siffran ligger överst och placeras därför först: bilden runt den reserverar cirkelns yta.
          karta!.addLayer({
            id: `${niva}-grupp-antal`, type: 'symbol', source: `${niva}-grupper`, ...zoom,
            layout: {
              'text-field': ['to-string', ['get', 'antal']], 'text-font': ['Noto Sans Bold'], 'text-size': medZoom(10.5, 13), 'text-allow-overlap': true, 'text-ignore-placement': true,
              'icon-image': 'tom', 'icon-size': medZoom(['*', 1.04, radie], ['*', 1.8, radie]), 'icon-allow-overlap': true, 'icon-padding': 0,
              'symbol-sort-key': minstOverst,
            },
            paint: { 'text-color': '#fdfbf7' },
          });
        };
        GRUPPNIVAER.forEach(ritaCirklar);
        // Vilka organisationer som ritas på varje nivå: alla närmast, annars bara de som är ensamma på sin plats.
        const synlig = ['case', ['>=', ['zoom'], ZOOM_POSTER], true, ['>=', ['zoom'], ZOOM_KOMMUN], ['get', 'ek'], ['get', 'el']] as unknown as ExpressionSpecification;
        karta!.addLayer({
          id: 'punkter', type: 'circle', source: 'orgs', filter: synlig,
          paint: {
            'circle-color': ['match', ['get', 't'], ...Object.entries(FARG).flat(), FARG.bolag] as unknown as ExpressionSpecification,
            'circle-radius': ['interpolate', ['linear'], ['zoom'], 4, 6, 9, 8, 13, 11],
            'circle-stroke-width': 2.5,
            'circle-stroke-color': '#fdfbf7',
          },
        });
        karta!.addLayer({
          id: 'namn', type: 'symbol', source: 'orgs', filter: synlig, minzoom: 7,
          layout: { 'text-field': ['get', 'n'], 'text-font': ['Noto Sans Bold'], 'text-size': 12, 'text-anchor': 'bottom', 'text-offset': [0, -1.1], 'text-max-width': 9, 'text-optional': true },
          paint: { 'text-color': BLACK, 'text-halo-color': '#fdfbf7', 'text-halo-width': 1.8 },
        });
        GRUPPNIVAER.forEach(ritaText);
        // Reserverar ytan för organisationer som ritas som sig själva på gruppnivåerna, så att ett
        // platsnamn inte hamnar tvärs över en prick eller ett landmärke och ser ut att höra dit.
        karta!.addLayer({
          id: 'ensam-yta', type: 'symbol', source: 'orgs', maxzoom: ZOOM_POSTER, filter: synlig,
          layout: { 'icon-image': 'tom', 'icon-size': 18, 'icon-allow-overlap': true, 'icon-padding': 0 },
        });
        karta!.addLayer({
          id: 'vald-ring', type: 'circle', source: 'vald', filter: synlig,
          paint: { 'circle-color': '#fdfbf7', 'circle-radius': 15, 'circle-stroke-width': 3, 'circle-stroke-color': BLACK },
        });
        karta!.addLayer({
          id: 'vald-punkt', type: 'circle', source: 'vald', filter: synlig,
          paint: { 'circle-color': ['match', ['get', 't'], ...Object.entries(FARG).flat(), FARG.bolag] as unknown as ExpressionSpecification, 'circle-radius': 9 },
        });
        karta!.addLayer({
          id: 'vald-namn', type: 'symbol', source: 'vald', filter: synlig,
          layout: { 'text-field': ['get', 'n'], 'text-font': ['Noto Sans Bold'], 'text-size': 13, 'text-anchor': 'bottom', 'text-offset': [0, -1.6], 'text-max-width': 10, 'text-allow-overlap': true },
          paint: { 'text-color': BLACK, 'text-halo-color': '#fdfbf7', 'text-halo-width': 2 },
        });

        const grupplager = ['lan-grupp', 'kommun-grupp'];
        // Landmärkeslagret läggs till senare; lager som saknas hoppas över tills dess.
        const punktlager = ['punkter', 'landmarken'];
        // En organisation som ritas som sig själv ligger ovanpå gruppernas cirklar. Pekar besökaren
        // på den är det den som gäller, inte gruppen under.
        const prickUnder = (e: MapLayerMouseEvent) => {
          const lager = punktlager.filter((id) => karta!.getLayer(id));
          return lager.length ? karta!.queryRenderedFeatures(e.point, { layers: lager })[0] : undefined;
        };
        // Grupper kan överlappa. Den minsta ritas överst och är den besökaren ser under pekaren.
        const overst = (e: MapLayerMouseEvent) =>
          (e.features ?? []).slice().sort((a, b) => Number(a.properties?.antal ?? 0) - Number(b.properties?.antal ?? 0))[0];

        let tipsFor: string | null = null;
        const visaTips = (e: MapLayerMouseEvent) => {
          const f = prickUnder(e) ?? overst(e);
          if (!f) return;
          // Markören sätts vid varje rörelse, så att den inte nollställs när pekaren går mellan lager.
          karta!.getCanvas().style.cursor = 'pointer';
          const antal = Number(f.properties?.antal ?? 0);
          const id = String(f.properties?.id ?? `${f.layer.id}:${f.properties?.kod}`);
          if (id === tipsFor) return;
          tipsFor = id;
          tips?.remove();
          // Ett landmärke eller en grupp är högre än en prick, så tipset får mer luft.
          tips = new Tips({ closeButton: false, closeOnClick: false, offset: antal ? 34 : f.layer.id === 'landmarken' ? 24 : 14, className: 'tips' })
            .setLngLat((f.geometry as GeoJSON.Point).coordinates as [number, number])
            .setText(antal ? `${f.properties?.n} · ${antal} organisationer` : String(f.properties?.n ?? ''))
            .addTo(karta!);
        };
        const doljTips = () => {
          tipsFor = null;
          karta!.getCanvas().style.cursor = '';
          tips?.remove();
        };
        // En uppsättning lyssnare för alla lagren. Med en per lager släcker det ena lagrets
        // mouseleave tipset som det andra just visade.
        karta!.on('mousemove', [...punktlager, ...grupplager], visaTips);
        karta!.on('mouseleave', [...punktlager, ...grupplager], doljTips);

        // Klick på en grupp går en nivå in: kartan zoomar dit och panelen visar platsen.
        // Tiden för klicket sparas. Ett dubbelklick eller dubbeltryck känns igen på den, inte på vad
        // som ligger under pekaren: när andra trycket kommer har gruppen redan flugit därifrån.
        let gruppklick = -Infinity;
        const nyssGrupp = () => performance.now() - gruppklick < 700;
        karta!.on('click', grupplager, (e) => {
          if (nyssGrupp() || prickUnder(e)) return;
          const f = overst(e);
          const kod = String(f?.properties?.kod ?? '');
          if (!f || !kod) return;
          gruppklick = performance.now();
          // Gruppen under pekaren finns inte kvar när kartan har flugit, så tipset släcks.
          doljTips();
          if (f.layer.id === 'lan-grupp') sattPlats(kod);
          else sattPlats(kod.slice(0, 2), kod);
        });
        // Andra trycket ska varken zooma ett vanligt steg eller stanna halvvägs. Att hindra kartans
        // egen zoom avbryter också flygningen dit, så den startas om.
        const hallKursen = (e: { preventDefault(): void }) => {
          if (!nyssGrupp()) return;
          e.preventDefault();
          setTimeout(passaKarta, 0);
        };
        karta!.on('dblclick', hallKursen);
        karta!.on('touchstart', hallKursen);
        karta!.on('click', punktlager, (e) => {
          // Andra klicket i ett dubbelklick på en grupp: det som nu ligger under pekaren var inte målet.
          if (nyssGrupp()) return;
          const id = e.features?.[0]?.properties?.id;
          const o = id ? alla.find((x) => x.id === String(id)) : undefined;
          if (o) visaDetalj(o, false);
        });
        karta!.on('click', (e) => {
          // Tryck på tom karta fäller ner bottenbladet i smal vy.
          const lager = [...grupplager, ...punktlager].filter((id) => karta!.getLayer(id));
          if (smal.matches && !karta!.queryRenderedFeatures(e.point, { layers: lager }).length) sattBlad('titt');
        });

        // Typer med egen ikon ritas som landmärken: bilden i stället för en prick, med namnet under.
        // Går bilderna inte att ladda ligger prickarna kvar.
        const ritaLandmarken = async () => {
          const BREDD = 40;
          // Bildens täthet följer skärmen, så att pixelkonsten inte förstoras på telefoner. Källan är 192 px.
          const tathet = Math.max(2, Math.min(4, Math.ceil(window.devicePixelRatio || 1)));
          const typer: string[] = [];
          for (const utfall of await ikonbilder) {
            // En ikon som inte går att ladda ska inte dra med sig de andra: den typen behåller sin prick.
            if (utfall.status === 'rejected') {
              console.warn('Typikonen gick inte att ladda', utfall.reason);
              continue;
            }
            const [typ, bild] = utfall.value;
            // Skalas ner en gång här. WebGL förminskar utan utjämning, och då flimrar pixelkonsten.
            const duk = document.createElement('canvas');
            duk.width = duk.height = BREDD * tathet;
            const penna = duk.getContext('2d');
            if (!penna) continue;
            penna.imageSmoothingQuality = 'high';
            penna.drawImage(bild, 0, 0, duk.width, duk.height);
            karta!.addImage(`typ-${typ}`, penna.getImageData(0, 0, duk.width, duk.height), { pixelRatio: tathet });
            typer.push(typ);
          }
          if (!typer.length) return;
          const arLandmarke = ['in', ['get', 't'], ['literal', typer]] as unknown as ExpressionSpecification;
          const ikon = ['concat', 'typ-', ['get', 't']] as unknown as ExpressionSpecification;
          karta!.addLayer(
            {
              id: 'landmarken', type: 'symbol', source: 'orgs', filter: ['all', synlig, arLandmarke],
              // Ikonen stannar vid 40 px, samma storlek som den valda ikonen och dess ring är ritade för.
              layout: { 'icon-image': ikon, 'icon-size': ['interpolate', ['linear'], ['zoom'], 4, 0.8, 9, 1], 'icon-allow-overlap': true },
            },
            'lan-grupp-namn',
          );
          // Namnet ligger i ett eget lager. I samma lager som ikonen räknas textrutan som träffyta,
          // och då fångar namnet klick och hovring som gäller grannen under.
          karta!.addLayer(
            {
              id: 'landmarken-namn', type: 'symbol', source: 'orgs', minzoom: 7, filter: ['all', synlig, arLandmarke],
              layout: { 'text-field': ['get', 'n'], 'text-font': ['Noto Sans Bold'], 'text-size': 12, 'text-anchor': 'top', 'text-offset': [0, 1.85], 'text-max-width': 9 },
              paint: { 'text-color': BLACK, 'text-halo-color': '#fdfbf7', 'text-halo-width': 1.8 },
            },
            'lan-grupp-namn',
          );
          karta!.setFilter('punkter', ['all', synlig, ['!', arLandmarke]]);
          karta!.setFilter('namn', ['all', synlig, ['!', arLandmarke]]);
          // Den valda organisationen: större ring bakom, och ikonen i stället för pricken.
          karta!.setPaintProperty('vald-ring', 'circle-radius', ['case', arLandmarke, 24, 15]);
          karta!.setFilter('vald-punkt', ['all', synlig, ['!', arLandmarke]]);
          karta!.setLayoutProperty('ensam-yta', 'icon-size', ['case', arLandmarke, 38, 18]);
          karta!.addLayer({ id: 'vald-ikon', type: 'symbol', source: 'vald', filter: ['all', synlig, arLandmarke], layout: { 'icon-image': ikon, 'icon-allow-overlap': true } }, 'vald-namn');
          karta!.setLayoutProperty('vald-namn', 'text-offset', ['case', arLandmarke, ['literal', [0, -2.3]], ['literal', [0, -1.6]]]);
          // Landmärkena kan bli klara efter att medlemsvyn har öppnats. Då ska de också vara gömda.
          visaMedlemslager();
        };
        ritaLandmarken().catch((fel) => console.warn('Landmärkena gick inte att rita', fel));
        // Den som själv zoomar ut ur en nivå lämnar platsen den hörde till. Annars står kartan
        // kvar med bara den platsens organisationer när resten av landet kommer i bild.
        // Zoomen före rörelsen följer med även för kartans egna rörelser, så att en avbruten flygning
        // räknas från där den stannade. Före datan finns ingen första vy att lämna.
        let zoomFore = karta!.getZoom();
        karta!.on('zoomend', (e) => {
          const fran = zoomFore;
          zoomFore = karta!.getZoom();
          if ((e as { avKod?: boolean }).avKod || !alla.length || medlemslage) return;
          const f = lasFilter();
          const efter = platsEfterUtzoomning(zoomFore, { lan: f.lan, kommun: f.kommun }, fran);
          if (efter.lan !== f.lan || efter.kommun !== f.kommun) sattPlats(efter.lan, efter.kommun, true);
        });

        kartaKlar = true;
        if (alla.length) {
          uppdateraKarta();
          forstaVy();
        }
        // Adressen kan peka rakt in i medlemsvyn. Den behöver inte organisationernas data.
        if (medlemslage) sattMedlemsvy(true, false);
      });

      app.querySelector('#zooma-in')?.addEventListener('click', () => karta?.zoomIn());
      app.querySelector('#zooma-ut')?.addEventListener('click', () => karta?.zoomOut());
      app.querySelector('#visa-allt')?.addEventListener('click', () => (medlemslage ? passaMedlemmar() : passaKarta()));
      medlemsknapp?.addEventListener('click', () => sattMedlemsvy(!medlemslage));
      smal.addEventListener('change', () => medlemslage && passaMedlemmar());
      app.querySelector('#stang-medlemmar')?.addEventListener('click', () => {
        sattMedlemsvy(false);
        medlemsknapp?.focus({ preventScroll: true });
      });
    }

    /** Första vyn när både data och karta finns: vald organisation, vald plats eller hela landet. */
    function forstaVy() {
      // Medlemsvyn har sin egen kamera och ska inte flyttas när organisationernas data kommer.
      if (medlemslage) return;
      const o = valdId ? alla.find((x) => x.id === valdId) : undefined;
      if (o) return visaDetalj(o, true, false);
      valdId = null;
      const f = lasFilter();
      if (kartaKlar && (f.lan || f.kommun)) passaKarta();
    }

    /* ---------- Händelser ---------- */

    form.addEventListener('change', (e) => {
      const namn = (e.target as HTMLInputElement).name;
      if (namn === 'lan') return sattPlats((e.target as HTMLInputElement).value);
      stangDetalj(false);
      filtrera();
    });
    form.addEventListener('submit', (e) => e.preventDefault());
    sortEl.addEventListener('change', renderLista);

    app.addEventListener('click', (e) => {
      const mal = e.target as HTMLElement;
      const rensaKnapp = mal.closest<HTMLElement>('[data-rensa]');
      if (rensaKnapp) return rensa(rensaKnapp.dataset.rensa!);

      const brodKnapp = mal.closest<HTMLElement>('[data-brod]');
      if (brodKnapp) return sattPlats(brodKnapp.dataset.brod === 'lan' ? lasFilter().lan : '');

      if (mal.closest('[data-tillbaka]')) return detaljIHistorik ? history.back() : stangDetalj();
      if (mal.closest('[data-ladda-om]')) return location.reload();
      const kopiera = mal.closest<HTMLElement>('[data-kopiera]');
      if (kopiera) return void kopieraLank(kopiera);

      // Kort i listan öppnar detaljvyn på kartsidan. Med ctrl, cmd eller mittenklick
      // gäller länken som vanligt, och i listläget går den alltid till organisationssidan.
      const kort = mal.closest<HTMLAnchorElement>('.post__lank');
      const ev = e as MouseEvent;
      if (kort && medKarta && !ev.metaKey && !ev.ctrlKey && !ev.shiftKey) {
        const o = alla.find((x) => x.id === kort.closest<HTMLElement>('.post')?.dataset.id);
        if (o) {
          e.preventDefault();
          visaDetalj(o);
        }
      }
    });

    async function kopieraLank(knapp: HTMLElement) {
      try {
        await navigator.clipboard.writeText(location.href);
        knapp.classList.add('kopierad');
        setTimeout(() => knapp.classList.remove('kopierad'), 1600);
      } catch {
        prompt('Kopiera länken:', location.href);
      }
    }
    delaEl.addEventListener('click', () => kopieraLank(delaEl));

    // Urvalet som CSV: samma kolumner som hela datasetet, med källa och datum per uppgift.
    laddaNerEl.addEventListener('click', async () => {
      const adress = app.dataset.csv!;
      try {
        const svar = await fetch(adress);
        if (!svar.ok) throw new Error(String(svar.status));
        const csv = urvalSomCsv(await svar.text(), sorterat().map((o) => o.id));
        const lank = document.createElement('a');
        lank.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
        // sv-SE skriver datum som ÅÅÅÅ-MM-DD i lokal tid. toISOString räknar i UTC och hamnar fel runt midnatt.
        lank.download = `ai-kartan-urval-${new Date().toLocaleDateString('sv-SE')}.csv`;
        lank.click();
        setTimeout(() => URL.revokeObjectURL(lank.href), 1000);
        laddaNerEl.classList.add('kopierad');
        setTimeout(() => laddaNerEl.classList.remove('kopierad'), 1600);
      } catch {
        // Går urvalet inte att ta fram får man hela datasetet i stället för ingenting.
        location.href = adress;
      }
    });

    // Filterpiller: ett öppet åt gången. I smal vy ligger alla i bladet och är alltid utfällda.
    const stangPiller = (utom?: Element | null) => {
      form.querySelectorAll('.fpill--oppen').forEach((el) => {
        if (el === utom) return;
        el.classList.remove('fpill--oppen');
        el.querySelector('.fknapp')?.setAttribute('aria-expanded', 'false');
      });
    };
    form.querySelectorAll<HTMLElement>('.fpill').forEach((pill) => {
      const knapp = pill.querySelector<HTMLButtonElement>('.fknapp')!;
      knapp.addEventListener('click', () => {
        if (smal.matches) return;
        stangPiller(pill);
        knapp.setAttribute('aria-expanded', String(pill.classList.toggle('fpill--oppen')));
      });
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.fpill')) stangPiller();
    });

    const sattFilterblad = (oppet: boolean) => {
      form.classList.toggle('filteryta--oppen', oppet);
      filterSkugga.hidden = !oppet;
      oppnaFilter.setAttribute('aria-expanded', String(oppet));
      (oppet ? stangFilter : oppnaFilter).focus({ preventScroll: true });
    };
    oppnaFilter.addEventListener('click', () => sattFilterblad(true));
    stangFilter.addEventListener('click', () => sattFilterblad(false));
    filterSkugga.addEventListener('click', () => sattFilterblad(false));
    visaUrval.addEventListener('click', () => {
      sattFilterblad(false);
      if (medKarta) sattBlad('oppen');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (form.classList.contains('filteryta--oppen')) return sattFilterblad(false);
      const oppen = form.querySelector<HTMLElement>('.fpill--oppen');
      if (oppen) {
        stangPiller();
        oppen.querySelector<HTMLElement>('.fknapp')?.focus();
        return;
      }
      if (medlemslage && sokLada?.hidden !== false) sattMedlemsvy(false);
    });

    // Greppet går både att trycka på och att svepa upp eller ner.
    let greppY: number | null = null;
    let svepte = false;
    grepp?.addEventListener('pointerdown', (e) => (greppY = e.clientY));
    grepp?.addEventListener('pointerup', (e) => {
      const dy = greppY === null ? 0 : e.clientY - greppY;
      greppY = null;
      svepte = Math.abs(dy) > 24;
      if (svepte) sattBlad(dy < 0 ? 'oppen' : 'titt');
    });
    // I filterbladet är facettknapparna bara rubriker och ska inte gå att tabba till.
    const sattRubriker = () => form.querySelectorAll<HTMLButtonElement>('.fpill > .fknapp').forEach((k) => (k.tabIndex = smal.matches ? -1 : 0));
    sattRubriker();
    smal.addEventListener('change', sattRubriker);

    grepp?.addEventListener('click', () => {
      if (svepte) return void (svepte = false);
      sattBlad(panel.dataset.blad === 'oppen' ? 'titt' : 'oppen');
    });

    // Bakåt och framåt i webbläsaren: läs om hela läget ur adressen.
    window.addEventListener('popstate', () => {
      const p = new URLSearchParams(location.search);
      lasUrl(p);
      const id = medKarta ? p.get('org') : null;
      const o = id ? alla.find((x) => x.id === id) : undefined;
      // Listan ritas om först, så att fokus kan lämnas tillbaka till rätt kort.
      filtrera(false);
      if (o) visaDetalj(o, true, false);
      else stangDetalj(false, true);
      detaljIHistorik = false;
      if (medKarta && (p.get('vy') === 'medlemmar') !== medlemslage) sattMedlemsvy(!medlemslage, false);
    });
    smal.addEventListener('change', () => {
      form.classList.remove('filteryta--oppen');
      filterSkugga.hidden = true;
      stangPiller();
      sattBlad(panel.dataset.blad === 'oppen' ? 'oppen' : 'titt');
      karta?.resize();
    });

    const sattPanel = (synlig: boolean) => {
      app.classList.toggle('app--utan-panel', !synlig);
      const visa = app.querySelector<HTMLButtonElement>('#visa-panel');
      if (visa) visa.hidden = synlig;
      karta?.resize();
      (synlig ? app.querySelector<HTMLElement>('#falla') : visa)?.focus({ preventScroll: true });
    };
    app.querySelector('#falla')?.addEventListener('click', () => sattPanel(false));
    app.querySelector('#visa-panel')?.addEventListener('click', () => sattPanel(true));

    /* ---------- Start ---------- */

    lasUrl(start);
    kopplaSok();
    sattBlad('titt');
    if (medKarta) void startaKarta();
    fetch(app.dataset.api!)
      .then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      })
      .then((data: { organisationer: Post[] }) => {
        alla = data.organisationer.map((o) => ({
          ...o,
          nn: normalisera(o.n),
          ns: normalisera(
            [o.n, o.d, o.kn ?? '', o.ln ?? '', etiketter.typer[o.t] ?? '', ...o.o.map((x) => etiketter.erbjuder[x] ?? ''), ...o.a.map((x) => etiketter.omraden[x] ?? '')].join(' '),
          ),
        }));
        const perPlats = new Map<string, PlatsTraff>();
        for (const o of alla) {
          if (o.l && o.ln) {
            const p = perPlats.get(o.l) ?? { typ: 'lan' as const, kod: o.l, namn: o.ln, nn: normalisera(o.ln), under: 'Län', antal: 0 };
            p.antal++;
            perPlats.set(o.l, p);
          }
          if (o.k && o.kn) {
            const p = perPlats.get(o.k) ?? { typ: 'kommun' as const, kod: o.k, namn: o.kn, nn: normalisera(o.kn), under: o.ln ?? 'Kommun', antal: 0 };
            p.antal++;
            perPlats.set(o.k, p);
          }
        }
        platser = [...perPlats.values()].sort((a, b) => b.antal - a.antal || a.namn.localeCompare(b.namn, 'sv'));
        mitt = { lan: platsmitt(alla, 'lan'), kommun: platsmitt(alla, 'kommun') };
        filtrera();
        if (medKarta) forstaVy();
      })
      .catch(() => {
        antalEl.textContent = 'Ingen data';
        lista.innerHTML =
          '<li class="lista__tom"><strong>Kunde inte läsa datan.</strong><span>Kontrollera uppkopplingen och försök igen.</span>' +
          '<button type="button" class="knapp knapp--liten" data-ladda-om>Försök igen</button></li>';
      });
  }
</script>

