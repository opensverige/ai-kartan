    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 12px;
    padding: 8px 12px 8px 22px;
  }
  .listhuvud__antal {
    white-space: nowrap;
  }
  .listhuvud__hoger {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
  }
  .app[data-lage='karta'] .sortera {
    margin-right: auto;
  }
  .sortera {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    color: hsl(var(--ink-mute));
  }
  .sortera select {
    max-width: 190px;
    padding: 6px 2px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: hsl(var(--ink));
    font: 600 14px/1.2 var(--font-sans);
    cursor: pointer;
  }
  .lista {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0 16px 20px;
    list-style: none;
  }
  .post {
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-kort);
    background: hsl(var(--yta-kort));
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
    content-visibility: auto;
    contain-intrinsic-size: auto 172px;
  }
  .post:hover {
    border-color: hsl(var(--ink) / 0.4);
    box-shadow: 0 10px 26px -18px hsl(var(--ink) / 0.45);
  }
  .post--aktiv {
    border-color: hsl(var(--ink));
    box-shadow: 0 0 0 1px hsl(var(--ink));
  }
  .post__lank {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 0 14px;
    align-items: center;
    padding: 18px;
    border-radius: inherit;
    color: inherit;
    text-decoration: none;
  }
  .post__lank:hover {
    color: inherit;
  }
  .post__huvud {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .post__rad {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .post__marke {
    flex: none;
    margin-left: auto;
    padding: 2px 5px;
    border: 1px solid hsl(var(--moss) / 0.28);
    border-radius: var(--r-tag);
    background: hsl(var(--moss) / 0.07);
    color: hsl(var(--moss));
    font: 500 9.5px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .post__namn {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: hsl(var(--ink));
    overflow-wrap: anywhere;
  }
  .post__under {
    font-size: 13.5px;
    line-height: 1.35;
    color: hsl(var(--ink-mute));
  }
  .post__text {
    grid-column: 1 / -1;
    margin-top: 14px;
    font-size: 14.5px;
    line-height: 1.5;
    color: hsl(var(--ink-soft));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post__chips {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    border-radius: 8px;
    background: hsl(var(--yta-chip));
    color: hsl(var(--ink-soft));
    font-size: 12.5px;
    line-height: 1.35;
    white-space: nowrap;
  }
  .chip--bekr {
    background: hsl(var(--moss) / 0.1);
    color: hsl(var(--moss));
  }
  .chip__prick {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  /* Kartans lista är tät: namn, plats och typ, och en rad beskrivning. Listsidan visar hela korten. */
  .app[data-lage='karta'] .lista {
    gap: 8px;
    padding: 0 12px 16px;
  }
  .app[data-lage='karta'] .post {
    border-radius: var(--r-ruta);
    contain-intrinsic-size: auto 84px;
  }
  .app[data-lage='karta'] .post__lank {
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 2px 12px;
    align-items: start;
    padding: 11px 14px 12px 12px;
  }
  .app[data-lage='karta'] .post .logo {
    grid-row: 1 / span 2;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    font-size: 14px;
  }
  .app[data-lage='karta'] .post__huvud {
    gap: 1px;
  }
  .app[data-lage='karta'] .post__namn {
    font-size: 16px;
    line-height: 1.25;
  }
  .app[data-lage='karta'] .post__under {
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .app[data-lage='karta'] .post__text {
    display: block;
    grid-column: 2;
    margin-top: 1px;
    font-size: 13.5px;
    line-height: 1.4;
    color: hsl(var(--ink-mute));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .app[data-lage='karta'] .post__chips {
    display: none;
  }
  .app[data-lage='karta'] .post--skelett {
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 6px 12px;
    padding: 11px 14px 12px 12px;
  }
  .app[data-lage='karta'] .skelett--logo {
    grid-row: 1 / span 2;
    width: 40px;
    height: 40px;
  }
  .app[data-lage='karta'] .skelett--rad {
    height: 16px;
  }
  .app[data-lage='karta'] .skelett--text {
    grid-column: 2;
    height: 14px;
  }

  /* Länk till systersajten AI-Infra: överst i listan när man filtrerar på infrastruktur, och i detaljvyn. */
  .infralank {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 14px 9px 10px;
    border: 1px solid hsl(var(--moss) / 0.3);
    border-radius: var(--r-ruta);
    background: hsl(var(--moss) / 0.06);
    color: hsl(var(--moss));
    text-decoration: none;
    transition: background var(--t-fast), border-color var(--t-fast);
  }
  .infralank:hover {
    border-color: hsl(var(--moss));
    background: hsl(var(--moss) / 0.1);
    color: hsl(var(--moss));
  }
  .infralank__logo {
    flex: none;
    width: 44px;
    height: 44px;
    margin: -2px 0;
  }
  .infralank__text {
    display: grid;
    flex: 1;
    gap: 2px;
    min-width: 0;
  }
  .infralank strong {
    font-size: 15px;
    line-height: 1.25;
  }
  .infralank__text span {
    font-size: 13px;
    line-height: 1.35;
    color: hsl(var(--ink-mute));
  }
  .detalj .infralank {
    margin-top: 14px;
  }

  .lista__tom {
    display: grid;
    gap: 4px;
    padding: 28px 20px;
    border: 1px dashed hsl(var(--kant));
    border-radius: var(--r-kort);
    text-align: center;
    font-size: 14.5px;
    color: hsl(var(--ink-mute));
  }
  .lista__tom strong {
    color: hsl(var(--ink));
  }
  .lista__tom .knapp {
    justify-self: center;
    margin-top: 10px;
  }
  .lista__tom--ram {
    margin: 0 16px 16px;
  }
  .app .lista__saknas {
    padding: 4px 22px 22px;
    font-size: 14.5px;
    color: hsl(var(--ink-mute));
  }
  .app[data-lage='lista'] .lista__saknas {
    padding: 24px 0 0;
  }
  /* Platshållare medan datan hämtas */
  .post--skelett {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 18px;
  }
  .post--skelett:hover {
    border-color: hsl(var(--kant));
    box-shadow: none;
  }
  .skelett {
    display: block;
    height: 18px;
    border-radius: 8px;
    background: hsl(var(--yta-chip));
    animation: skelett 1.4s ease-in-out infinite;
  }
  .skelett--logo {
    width: 52px;
    height: 52px;
    border-radius: var(--r-ruta);
  }
  .skelett--rad {
    width: 62%;
  }
  .skelett--text {
    grid-column: 1 / -1;
    height: 40px;
  }
  @keyframes skelett {
    50% {
      opacity: 0.45;
    }
  }
  .panel__fot {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    padding: 14px 22px 20px;
    border-top: 1px solid hsl(var(--kant));
    font-size: 13.5px;
  }
  .panel__fot a {
    color: hsl(var(--ink-mute));
  }
  .panel__fot a:hover {
    color: hsl(var(--ink));
  }

  /* ---------- Detaljvy ---------- */
  .panel__vy--detalj:not([hidden]) {
    display: flex;
    flex-direction: column;
  }
  .detalj {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
  }
  .detalj__banner {
    position: relative;
    flex: none;
    height: 128px;
    padding: 14px;
    background:
      radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--f) 30%, transparent) 1.2px, transparent 0) 0 0 / 15px 15px,
      linear-gradient(135deg, color-mix(in srgb, var(--f) 26%, hsl(var(--yta))), color-mix(in srgb, var(--f) 8%, hsl(var(--yta))));
  }
  .detalj__kropp {
    flex: 1;
    padding: 0 22px 24px;
  }
  .detalj__namn {
    margin: 16px 0 10px;
    font-size: 32px;
    line-height: 1.05;
    letter-spacing: -0.035em;
    outline: 0;
    overflow-wrap: anywhere;
  }
  .app .detalj__text {
    font-size: 16px;
    line-height: 1.55;
    color: hsl(var(--ink-soft));
  }
  .app .detalj__kicker {
    margin: 24px 0 10px;
  }
  .rutor {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
  }
  .rutor div {
    padding: 13px 14px;
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-ruta);
    background: hsl(var(--yta-kort));
  }
  .rutor dt {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: hsl(var(--ink-mute));
  }
  .rutor dd {
    margin: 6px 0 0;
    font-size: 15.5px;
    font-weight: 500;
    line-height: 1.35;
    color: hsl(var(--ink));
  }
  .app .detalj__ratta {
    margin-top: 16px;
    font-size: 14.5px;
    color: hsl(var(--ink-mute));
  }
  .app .detalj__not {
    margin-top: 10px;
    font-size: 11.5px;
  }
  .detalj__fot {
    position: sticky;
    bottom: 0;
    display: flex;
    gap: 8px;
    padding: 12px 22px calc(12px + env(safe-area-inset-bottom));
    border-top: 1px solid hsl(var(--kant));
    background: hsl(var(--yta));
  }
  .detalj__cta {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 52px;
    border-radius: 16px;
    background: hsl(var(--ink));
    color: hsl(var(--yta));
    font: 600 16px/1 var(--font-sans);
    text-decoration: none;
    transition: background var(--t-fast);
  }
  .detalj__cta:hover {
    background: hsl(var(--ink-soft));
    color: hsl(var(--yta));
  }

  /* ---------- Karta ---------- */
  .kartyta {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  .karta {
    width: 100%;
    height: 100%;
    background: hsl(var(--yta-chip));
  }
  .kartknappar {
    position: absolute;
    right: 16px;
    bottom: 40px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .kartknappar__grupp {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    box-shadow: var(--skugga-flyt);
  }
  .kartknapp {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 1px solid hsl(var(--kant));
    border-radius: 16px;
    background: hsl(var(--yta-kort));
    color: hsl(var(--ink));
    box-shadow: var(--skugga-flyt);
    cursor: pointer;
    transition: background var(--t-fast);
  }
  .kartknapp:hover {
    background: hsl(var(--yta-chip));
  }
  .kartknappar__grupp .kartknapp {
    box-shadow: none;
  }
  .kartknappar__grupp .kartknapp:first-child {
    border-radius: 16px 16px 0 0;
  }
  .kartknappar__grupp .kartknapp:last-child {
    border-top: 0;
    border-radius: 0 0 16px 16px;
  }
  .visa-panel {
    position: absolute;
    left: 16px;
    top: 16px;
    z-index: 4;
  }
  .visa-panel[hidden] {
    display: none;
  }
  .app .karta__not {
    position: absolute;
    left: 12px;
    bottom: 10px;
    z-index: 3;
    max-width: 60%;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: hsl(var(--yta) / 0.92);
    font-size: 11px;
  }
  .maplibregl-ctrl-attrib {
    font-family: var(--font-mono);
    font-size: 10px;
  }

  /* ---------- Medlemsvyn ---------- */
  .kartknapp--vi {
    overflow: hidden;
  }
  .kartknapp--vi img {
    width: 36px;
    height: 36px;
    border-radius: 12px;
  }
  .kartknapp--vi[aria-pressed='true'] {
    border-color: hsl(var(--ink));
    box-shadow: 0 0 0 2px hsl(var(--ink)), var(--skugga-flyt);
  }
  .medlemskort {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 5;
    width: 300px;
    max-width: calc(100% - 32px);
    padding: 16px;
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-kort);
    background: hsl(var(--yta-kort));
    box-shadow: var(--skugga-flyt);
  }
  .medlemskort[hidden] {
    display: none;
  }
  /* Knappen som visar panelen ligger i samma hörn när panelen är dold. */
  .app--utan-panel .medlemskort {
    top: 74px;
  }
  .medlemskort__topp {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .medlemskort__topp .kicker {
    margin: 0 0 2px;
  }
  .medlemskort__topp .ikonknapp {
    margin-left: auto;
    align-self: flex-start;
  }
  .medlemskort__bild {
    flex: none;
    width: 44px;
    height: 44px;
    border: 2px solid hsl(var(--ink));
    border-radius: 50%;
  }
  .medlemskort__rubrik {
    margin: 0;
    font-size: 22px;
    line-height: 1.1;
  }
  .medlemskort__text {
    margin: 14px 0 10px;
  }
  .medlemskort__lista {
    display: grid;
    gap: 7px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  .medlemskort__lista li {
    display: grid;
    grid-template-columns: 78px 1fr auto;
    gap: 10px;
    align-items: center;
  }
  .medlemskort__lista strong {
    min-width: 28px;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .medlemskort__stapel {
    height: 6px;
    overflow: hidden;
    border-radius: 3px;
    background: hsl(var(--yta-chip));
  }
  .medlemskort__stapel::after {
    display: block;
    width: var(--b);
    height: 100%;
    border-radius: 3px;
    background: hsl(var(--rust));
    content: '';
  }
  .medlemskort__annan {
    margin: 0;
    font-size: 14px;
  }
  .medlemskort__not {
    margin: 10px 0 14px;
  }
  .medlemskort__lank {
    display: none;
  }
  /* Filtren och noten om positioner gäller organisationerna, som inte syns i medlemsvyn. */
  .app[data-vy='medlemmar'] .kartyta .filteryta,
  .app[data-vy='medlemmar'] .karta__not {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .kartknapp--vi:hover img,
    .medlemskort:not([hidden]) .medlemskort__bild {
      animation: nyp 620ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
  @keyframes nyp {
    25% {
      transform: rotate(-10deg);
    }
    55% {
      transform: rotate(7deg);
    }
    80% {
      transform: rotate(-3deg);
    }
  }
  .tips .maplibregl-popup-content {
    padding: 6px 10px;
    border-radius: 10px;
    background: hsl(var(--ink));
    color: hsl(var(--yta));
    font: 600 13px/1.3 var(--font-sans);
    box-shadow: var(--skugga-flyt);
    pointer-events: none;
  }
  .tips .maplibregl-popup-tip {
    border-top-color: hsl(var(--ink));
    border-bottom-color: hsl(var(--ink));
  }

  /* ---------- Filterrad ---------- */
  .app[data-lage='karta'] .filteryta {
    position: absolute;
    top: 16px;
    left: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;
  }
  .filteryta > * {
    pointer-events: auto;
  }
  .filterrad {
    position: relative;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    max-width: 100%;
    padding: 5px;
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-pill);
    background: hsl(var(--yta-kort));
    box-shadow: var(--skugga-flyt);
  }
  .facetter,
  .facetter__kropp {
    display: contents;
  }
  .facetter__huvud,
  .facetter__fot,
  .filterrad .fknapp--mobil,
  .filteryta__skugga {
    display: none;
  }
  .fknapp {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 40px;
    padding: 0 12px 0 16px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: hsl(var(--ink));
    font: 500 15px/1 var(--font-sans);
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .fknapp:hover {
    background: hsl(var(--yta-chip));
  }
  .fknapp__pil {
    display: grid;
    color: hsl(var(--ink-mute));
    transition: transform var(--t-fast);
  }
  .fknapp__antal {
    display: grid;
    place-items: center;
    min-width: 21px;
    height: 21px;
    padding: 0 6px;
    border-radius: var(--r-pill);
    background: hsl(var(--yta) / 0.22);
    font: 600 12px/1 var(--font-sans);
  }
  .fknapp__antal[hidden] {
    display: none;
  }
  .fpill--aktiv > .fknapp,
  .fpill--oppen > .fknapp,
  .fknapp--aktiv {
    background: hsl(var(--ink));
    color: hsl(var(--yta));
  }
  .fpill--aktiv .fknapp__pil,
  .fpill--oppen .fknapp__pil {
    color: inherit;
  }
  .fpill--oppen .fknapp__pil {
    transform: rotate(180deg);
  }
  .val:has(input:focus-visible) {
    outline: 2px solid hsl(var(--moss));
    outline-offset: 2px;
  }
  .pop {
    display: none;
    position: absolute;
    top: 62px;
    left: 50%;
    z-index: 6;
    width: 540px;
    max-width: calc(100vw - 32px);
    transform: translateX(-50%);
    border: 1px solid hsl(var(--kant));
    border-radius: 24px;
    background: hsl(var(--yta-kort));
    box-shadow: 0 2px 4px hsl(var(--ink) / 0.05), 0 24px 60px -20px hsl(var(--ink) / 0.4);
    text-align: left;
  }
  .fpill--oppen .pop {
    display: block;
  }
  .pop__huvud {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 22px 14px;
    border-bottom: 1px solid hsl(var(--kant));
  }
  .app .pop__under {
    margin-top: 4px;
    font-size: 13.5px;
    color: hsl(var(--ink-mute));
  }
  .pop__rensa {
    padding: 4px 0;
    border: 0;
    border-bottom: 1px solid hsl(var(--ink) / 0.4);
    background: none;
    color: hsl(var(--ink));
    font: 500 14.5px/1.2 var(--font-sans);
    cursor: pointer;
  }
  .pop__val {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-height: min(52vh, 420px);
    padding: 18px 22px 22px;
    overflow-y: auto;
  }
  .val {
    display: inline-flex;
    align-items: center;
    gap: 8px;
