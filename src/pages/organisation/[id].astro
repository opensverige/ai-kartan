---
import Bas from '../../layouts/Bas.astro';
import StatusMarke from '../../components/StatusMarke.astro';
import TypTagg from '../../components/TypTagg.astro';
import { hamtaData, allaFakta, visaVarde, kalltypEtikett, formateraDatum, typikoner, url, absolutUrl, SAJT } from '../../lib/data';
import type { Org } from '../../lib/data';
import { brodsmulor, metabeskrivning } from '../../lib/meta';
import { ikon, logga } from '../../lib/ikoner';

export function getStaticPaths() {
  const d = hamtaData();
  return d.organisationer.map((org) => ({ params: { id: org.id }, props: { org } }));
}

interface Props {
  org: Org;
}
const { org } = Astro.props;
const typikon = typikoner()[org.type.value];
const d = hamtaData();
const fakta = allaFakta(org);
const typ = d.etikett.typer.get(org.type.value);
const permalank = absolutUrl(`/organisation/${org.id}`);
const idag = d.byggd;
const andringar = d.andringar.rader.filter((r) => r.id === org.id).slice(0, 40);
const gammal = (org.h.dagar_sedan_kontroll ?? 0) > 180;
const nedlagd = org.active?.value === false;
// Namnet står redan i titeln. Beskrivningen börjar därför med typ och plats och sedan vad organisationen bygger.
const typOchPlats = `${typ?.label ?? ''}${org.h.kommun_namn ? ` i ${org.h.kommun_namn}` : ''}`;
const beskrivning = metabeskrivning(`${typOchPlats ? `${typOchPlats}: ` : ''}${org.description.value}`);

const rattelseUrl = `${SAJT.repo}/issues/new?template=rattelse.yml&title=${encodeURIComponent(`Rättelse: ${org.name.value}`)}&organisation=${encodeURIComponent(org.id)}`;
const borttagningUrl = `${SAJT.repo}/issues/new?template=borttagning.yml&title=${encodeURIComponent(`Borttagning: ${org.name.value}`)}&organisation=${encodeURIComponent(org.id)}`;
const redigeraUrl = `${SAJT.repo}/edit/main/data/organisationer/${org.id}.yaml`;
const kallkodUrl = `${SAJT.repo}/blob/main/data/organisationer/${org.id}.yaml`;

const sameAs = [org.links?.github, org.links?.huggingface, org.links?.linkedin, org.links?.wikidata ? `https://www.wikidata.org/wiki/${org.links.wikidata}` : undefined].filter(Boolean);
const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: org.name.value,
  legalName: org.legal_name?.value ?? undefined,
  url: org.website,
  description: org.description.value,
  identifier: org.org_number?.value ? { '@type': 'PropertyValue', propertyID: 'Organisationsnummer', value: org.org_number.value } : undefined,
  foundingDate: org.founded?.value ? String(org.founded.value) : undefined,
  address: org.h.kommun_namn ? { '@type': 'PostalAddress', addressLocality: org.h.kommun_namn, addressRegion: org.h.lan_namn, addressCountry: 'SE' } : undefined,
  sameAs: sameAs.length ? sameAs : undefined,
  subjectOf: { '@type': 'WebPage', url: permalank, dateModified: org.record_updated_at, license: 'https://creativecommons.org/licenses/by/4.0/' },
};
const jsonLd = [
  organisation,
  brodsmulor([
    ['Karta', absolutUrl('/')],
    ['Organisationer', absolutUrl('/organisationer')],
    [org.name.value, permalank],
  ]),
];
const citat = `OpenSverige AI-kartan, ”${org.name.value}”, hämtad ${idag}, ${permalank}. Data: CC BY 4.0.`;
---

<Bas titel={org.name.value} beskrivning={beskrivning} stig={`/organisation/${org.id}`} jsonLd={jsonLd} ogTyp="profile">
  <article class="ram sektion org">
    <nav class="meta brod" aria-label="Du är här">
      <a href={url('/')}>Karta</a> › <a href={url('/organisationer')}>Organisationer</a> › <span>{org.name.value}</span>
    </nav>

    <header class="org__huvud">
      <div class="rad">
        <TypTagg typ={org.type.value} />
        {org.h.kommun_slug && <a class="tagg" href={url(`/plats/${org.h.kommun_slug}`)}>{org.h.kommun_namn}</a>}
        {org.h.lan_slug && <a class="tagg" href={url(`/lan/${org.h.lan_slug}`)}>{org.h.lan_namn}</a>}
        {org.links?.infra_id && <a class="tagg" href={`${SAJT.infra}/leverantor/${org.links.infra_id}`} rel="noopener">Finns på AI-Infra</a>}
      </div>
      <div class="org__namnrad">
        {typikon && <img class="org__ikon" src={typikon} alt="" width="72" height="72" decoding="async" />}
        <h1>{org.name.value}</h1>
      </div>
      <p class="org__beskrivning">{org.description.value} <StatusMarke status={org.description.status} kort /></p>
      <p class="rad">
        <a class="knapp knapp--ghost knapp--liten" href={org.website} rel="noopener">{org.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>
        {org.h.position && <a class="knapp knapp--ghost knapp--liten ej-utskrift" href={url(`/?org=${org.id}#karta`)}>Visa på kartan</a>}
        {org.links?.github && <a class="knapp knapp--ghost knapp--liten" href={org.links.github} rel="noopener">GitHub</a>}
        {org.links?.huggingface && <a class="knapp knapp--ghost knapp--liten" href={org.links.huggingface} rel="noopener">Hugging Face</a>}
        {org.links?.linkedin && <a class="knapp knapp--ghost knapp--liten" href={org.links.linkedin} rel="noopener">LinkedIn</a>}
        <button type="button" class="knapp knapp--ghost knapp--liten ej-utskrift" data-dela={org.id} data-dela-namn={org.name.value} aria-haspopup="dialog">
          <Fragment set:html={ikon('dela', 15)} /> Dela
        </button>
      </p>
      {/* Det tända huset i pixelstaden, när organisationen har ett. Skriptet nedan fyller i det. */}
      <a class="orghus ej-utskrift" id="orghus" href={url(`/?org=${org.id}#karta`)} data-org={org.id} hidden>
        <span class="orghus__fonster" id="orghus-fonster" aria-hidden="true"></span>
        <span class="orghus__text"><strong>Huset lyser i <span id="orghus-stad"></span></strong><span>Visa det på kartan →</span></span>
      </a>
      {nedlagd && <div class="notis notis--rust"><strong>Markerad som nedlagd eller avregistrerad.</strong> Posten ligger kvar tills den tas bort, så att historiken behålls.</div>}
      {gammal && <div class="notis"><strong>Inte omkontrollerad på över 180 dagar.</strong> Uppgifterna kan vara inaktuella. <a href={rattelseUrl} rel="noopener">Hjälp till att kontrollera.</a></div>}
    </header>

    <section>
      <h2 id="uppgifter">Uppgifter, var och en med källa</h2>
      <p class="meta">Kontrollerad senast {formateraDatum(org.h.senast_verifierad)} · {org.h.antal_bekraftade} av {org.h.antal_fakta} fält bekräftade mot register eller oberoende källa · Posten skapad {formateraDatum(org.record_created_at)}, uppdaterad {formateraDatum(org.record_updated_at)}</p>
      <div class="tabellram">
        <table class="tabell fakta">
          <thead>
            <tr><th>Uppgift</th><th>Värde</th><th>Status</th><th>Källa</th><th>Datum</th></tr>
          </thead>
          <tbody>
            {fakta.map(({ nyckel, etikett, fakta: f }) => (
              <tr id={`falt-${nyckel}`}>
                <th scope="row"><a class="ankare" href={`#falt-${nyckel}`} aria-label={`Länk till ${etikett}`}>#</a> {etikett}</th>
                <td>
                  {nyckel === 'offers' ? (
                    <span class="rad">{(f.value as string[]).map((x) => <a class="tagg" href={url(`/organisationer?erbjuder=${x}`)}>{d.etikett.erbjuder.get(x)?.label ?? x}</a>)}</span>
                  ) : nyckel === 'areas' ? (
                    <span class="rad">{(f.value as string[]).map((x) => <a class="tagg" href={url(`/organisationer?omrade=${x}`)}>{d.etikett.omraden.get(x)?.label ?? x}</a>)}</span>
                  ) : (
                    visaVarde(d, org, nyckel, f)
                  )}
                  {f.note && <div class="meta fakta__not">{f.note}</div>}
                </td>
                <td><StatusMarke status={f.status} kort /></td>
                <td class="fakta__kalla">
                  {f.source_url ? <a href={f.source_url} rel="noopener nofollow">{kalltypEtikett(d, f.source_type)}</a> : <span class="ljus">–</span>}
                </td>
                <td class="meta">{formateraDatum(f.verified_at)}{f.corroborated_at && <span title="Automatiskt bekräftad mot källan vid detta datum"> · styrkt {formateraDatum(f.corroborated_at)}</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 id="belagg">Belägg: något de byggt med AI</h2>
      <p class="lasbredd">Kriterium två kräver minst en publik länk till en produkt, ett kodförråd, en modell, en demo eller en publikation. Länken är sin egen källa.</p>
      <ul class="belagg">
        {org.evidence.map((b) => (
          <li class="kort">
            <div class="rad mellan">
              <span class="tagg">{d.etikett.belaggstyper.get(b.kind)?.label ?? b.kind}</span>
              <StatusMarke status={b.status ?? 'claimed'} kort />
            </div>
            <a class="belagg__lank" href={b.url} rel="noopener nofollow">{b.title ?? b.url}</a>
            <div class="meta">{b.url.replace(/^https?:\/\//, '')} · {formateraDatum(b.verified_at)}</div>
            {b.note && <div class="meta">{b.note}</div>}
          </li>
        ))}
      </ul>
    </section>

    <section class="tvaspalt">
      <div>
        <h2 id="citera">Citera</h2>
        <p class="lasbredd">Permalänken är stabil och går att använda i en upphandling eller rapport. Citera alltid status och datum tillsammans med värdet: en egen uppgift är inte en bekräftad.</p>
        <pre class="citat" id="citattext">{citat}</pre>
        <button type="button" class="knapp knapp--ghost knapp--liten ej-utskrift" id="kopiera" data-text={citat}>Kopiera citatet</button>
        <a class="knapp knapp--ghost knapp--liten" href={url(`/api/data/${org.id}.json`)}>JSON för posten</a>
      </div>
      <div>
        <h2 id="ratta">Rätta eller ta bort</h2>
        <p class="lasbredd">Fel? Skriv i <a class="kanal" href={SAJT.discordKanal.url} rel="noopener">#{SAJT.discordKanal.namn}</a> på Discord eller öppna ett ärende på GitHub. Länka en källa. Vi svarar inom 14 dagar.</p>
        {/* Tjänstens logga före texten och en pil efter: knapparna leder bort från kartan. */}
        <p class="rad">
          <a class="knapp knapp--liten" href={SAJT.discord} rel="noopener">
            <Fragment set:html={logga('discord', 16)} />Gå med i Discord<Fragment set:html={ikon('ut', 14)} />
          </a>
          <a class="knapp knapp--ghost knapp--liten" href={rattelseUrl} rel="noopener">
            <Fragment set:html={logga('github', 16)} />Rätta via GitHub<Fragment set:html={ikon('ut', 14)} />
          </a>
          <a class="knapp knapp--ghost knapp--liten" href={borttagningUrl} rel="noopener">
            <Fragment set:html={logga('github', 16)} />Ta bort via GitHub<Fragment set:html={ikon('ut', 14)} />
          </a>
        </p>
        <p class="meta">
          Båda vägarna kräver konto. E-post kommer. <a href={url('/bidra#varfor')}>Varför?</a><br />
          Källfil: <a href={kallkodUrl} rel="noopener">data/organisationer/{org.id}.yaml</a> · <a href={redigeraUrl} rel="noopener">redigera på GitHub</a>
        </p>
      </div>
    </section>

    <section>
      <h2 id="andringar">Ändringar för posten</h2>
      {andringar.length === 0 ? (
        <p class="ljus">Inga ändringar loggade än. Historiken byggs ur git-historiken vid varje publicering.</p>
      ) : (
        <div class="tabellram">
          <table class="tabell">
            <thead><tr><th>Datum</th><th>Fält</th><th>Ändring</th><th>Från</th><th>Till</th></tr></thead>
            <tbody>
              {andringar.map((r) => (
                <tr>
                  <td class="meta">{r.datum}</td>
                  <td>{r.falt}</td>
                  <td>{r.andring}</td>
                  <td class="meta">{r.gammalt === null || r.gammalt === undefined ? '–' : typeof r.gammalt === 'object' ? JSON.stringify(r.gammalt) : String(r.gammalt)}</td>
                  <td class="meta">{r.nytt === null || r.nytt === undefined ? '–' : typeof r.nytt === 'object' ? JSON.stringify(r.nytt) : String(r.nytt)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <p class="meta mt-1"><a href={url('/andringar')}>Hela ändringshistoriken</a></p>
    </section>
  </article>
</Bas>

<script>
  import { husutsnitt } from '../../lib/pixelkarta/husbild';
  import type { Kartfil } from '../../lib/pixelkarta/geometri';

  // Pixelkartans tända hus. Bara när pixelkartan är påslagen vid bygget och bildtjänsten svarar.
  // Annars står sidan som förut, utan besked.
  const BILDER: string | undefined = import.meta.env.PUBLIC_PIXELKARTA_URL;
  const orghus = document.getElementById('orghus') as HTMLAnchorElement | null;
  if (BILDER && orghus?.dataset.org) {
    const id = orghus.dataset.org;
    fetch(BILDER.replace(/\/+$/, '') + '/karta.json')
      .then((svar) => (svar.ok ? (svar.json() as Promise<Kartfil>) : null))
      .then((fil) => {
        const u = fil ? husutsnitt(fil, id, BILDER) : null;
        const fonster = document.getElementById('orghus-fonster');
        const stad = document.getElementById('orghus-stad');
        if (!u || !fonster || !stad) return;
        const span = (klass: string, x: number, y: number, w: number, h: number): HTMLSpanElement => {
          const el = document.createElement('span');
          el.className = klass;
          el.style.left = `${x}px`;
          el.style.top = `${y}px`;
          el.style.width = `${w}px`;
          el.style.height = `${h}px`;
          return el;
        };
        // Rutorna förskjutna så att (dx, dy) i utsnittet hamnar i lagrets övre vänstra hörn.
        const rutor = (dx: number, dy: number): HTMLImageElement[] =>
          u.rutor.map((r) => {
            const img = document.createElement('img');
            img.src = r.src;
            img.alt = '';
            img.decoding = 'async';
            img.className = 'orghus__ruta';
            img.style.left = `${r.x - dx}px`;
            img.style.top = `${r.y - dy}px`;
            return img;
          });
        // Elementen byggs här, så sidans stilar når dem bara som :global inom .orghus.
        // Som på kartan: staden tonas ner, och huset lyser i färg genom sin form.
        const yta = span('orghus__yta', 0, 0, u.bredd, u.hojd);
        const stadslager = span('orghus__stad', 0, 0, u.bredd, u.hojd);
        stadslager.append(...rutor(0, 0));
        const sken = span('orghus__sken', u.hus.x, u.hus.y, u.hus.w, u.hus.h);
        const hus = span('orghus__hus', 0, 0, u.hus.w, u.hus.h);
        hus.style.maskImage = `url("${u.hus.src}")`;
        hus.append(...rutor(u.hus.x, u.hus.y));
        sken.append(hus);
        yta.append(stadslager, sken);
        fonster.style.setProperty('--b', String(u.bredd));
        fonster.style.setProperty('--h', String(u.hojd));
        fonster.replaceChildren(yta);
        stad.textContent = u.stad;
        orghus.hidden = false;
        const skala = () => (yta.style.transform = `scale(${fonster.clientWidth / u.bredd})`);
        new ResizeObserver(skala).observe(fonster);
        skala();
      })
      .catch(() => {});
  }

  const knapp = document.getElementById('kopiera') as HTMLButtonElement | null;
  knapp?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(knapp.dataset.text || '');
      knapp.textContent = 'Kopierat';
      setTimeout(() => (knapp.textContent = 'Kopiera citatet'), 1800);
    } catch {
      /* utan clipboard-API får användaren markera texten själv */
    }
  });
</script>

<style>
  .brod {
    margin-bottom: 18px;
  }
  /* Det tända huset: ett fönster ur pixelstaden med huset i mitten. Hela kortet går till kartan. */
  .orghus {
    display: grid;
    gap: 10px;
    width: min(100%, 480px);
    margin-top: 18px;
    color: inherit;
    text-decoration: none;
  }
  .orghus[hidden] {
    display: none;
  }
  .orghus__fonster {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: calc(var(--b, 480) / var(--h, 260));
    border: 1px solid hsl(var(--kant));
    border-radius: 16px;
    background: hsl(var(--yta-chip));
  }
  /* Utsnittet är byggt för 480 punkter. I ett smalare fönster krymper skriptet det i samma proportion. */
  .orghus :global(.orghus__yta) {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
  }
  .orghus :global(.orghus__stad),
  .orghus :global(.orghus__sken),
  .orghus :global(.orghus__hus),
  .orghus :global(.orghus__ruta) {
    position: absolute;
  }
  .orghus :global(.orghus__ruta) {
    max-width: none;
    image-rendering: pixelated;
  }
  /* Staden tonas ner mot papper, som när en organisation väljs på kartan. */
  .orghus :global(.orghus__stad) {
    overflow: hidden;
    filter: grayscale(0.85) brightness(1.12) contrast(0.85);
    opacity: 0.7;
  }
  /* Huset i färg genom sin form, med ett ljust sken runt. Skenet sitter på ett eget lager:
     en mask klipper bort det filter som sitter på samma element. */
  .orghus :global(.orghus__sken) {
    filter: drop-shadow(0 0 1.5px #fff) drop-shadow(0 0 7px hsl(45 100% 62%));
    transition: filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .orghus:hover :global(.orghus__sken),
  .orghus:focus-visible :global(.orghus__sken) {
    filter: drop-shadow(0 0 2px #fff) drop-shadow(0 0 14px hsl(45 100% 62%));
  }
  .orghus :global(.orghus__hus) {
    overflow: hidden;
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
  }
  .orghus__text {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    font-size: 15px;
  }
  .orghus__text span:last-child {
    color: hsl(var(--ink-mute));
  }
  .orghus:hover .orghus__text span:last-child {
    color: hsl(var(--ink));
  }
  .brod a {
    color: hsl(var(--ink-mute));
  }
  .org__namnrad {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  /* Får det längsta ordet inte plats bredvid ikonen faller rubriken ner under den i stället för att klippas. */
  .org__namnrad h1 {
    flex: 1 1 0;
  }
  .org__ikon {
    flex: none;
    width: 72px;
    height: 72px;
    object-fit: contain;
  }
  @media (max-width: 520px) {
    .org__ikon {
      width: 52px;
      height: 52px;
    }
  }
  .org__huvud h1 {
    margin: 12px 0 10px;
  }
  .org__beskrivning {
    font-size: 19px;
    max-width: 64ch;
    color: hsl(var(--ink-soft));
  }
  .tabellram {
    overflow-x: auto;
  }
  .fakta th[scope='row'] {
    font-weight: 600;
    color: hsl(var(--ink));
    background: transparent;
    font-family: var(--font-sans);
    font-size: 14px;
    text-transform: none;
    letter-spacing: 0;
    white-space: nowrap;
    border-bottom: 1px solid hsl(var(--rule-soft));
  }
  .ankare {
    color: hsl(var(--rule));
    text-decoration: none;
    margin-right: 2px;
  }
  tr:hover .ankare {
    color: hsl(var(--moss));
  }
  .fakta__not {
    margin-top: 4px;
    max-width: 48ch;
  }
  /* Källtypen är ett par korta ord. De hålls ihop, så att kolumnen inte krymper och bryter mitt i ordet. */
  .fakta__kalla {
    white-space: nowrap;
  }
  .belagg {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .belagg__lank {
    display: block;
    font-weight: 600;
    margin: 8px 0 4px;
    word-break: break-word;
  }
  .tvaspalt {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .citat {
    white-space: pre-wrap;
    word-break: break-word;
  }
  @media (max-width: 820px) {
    .tvaspalt {
      grid-template-columns: 1fr;
    }
  }
</style>
