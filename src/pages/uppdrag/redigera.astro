---
// Andra steget: länken i mejlet öppnar den här sidan. Engångskoden ligger efter #, så den når
// aldrig en server eller en logg. Den byts mot en session på en timme först när medlemmen
// klickar på Öppna min profil. Ett säkerhetsfilter i mejlen som öppnar länken, även ett som
// kör JavaScript, förbrukar den därför inte.
import Sida from '../../layouts/Sida.astro';
import Uppdragsbas from '../../components/Uppdragsbas.astro';
import { hamtaData, url } from '../../lib/data';
import { KUNSKAPSFORSLAG, UPPDRAG_API } from '../../lib/uppdrag';

const d = hamtaData();
const kommuner = [...d.kommuner].sort((a, b) => a.namn.localeCompare(b.namn, 'sv'));
---

<Sida
  titel="Din profil"
  kicker="Tar uppdrag"
  ingress="Fyll i det du vill visa. Raden visar hur det ser ut i listan."
  beskrivning="Lägg upp eller ändra din profil under Tar uppdrag på AI-kartan."
  stig="/uppdrag/redigera"
  noindex
  bred
>
  <Uppdragsbas />

  <div class="besked" id="r-laddar" role="status">
    <p>Öppnar din profil …</p>
  </div>

  <div class="besked" id="r-oppna" hidden>
    <p>Länken är klar. Den fungerar en gång och öppnar din profil i en timme.</p>
    <p class="mt-1"><button class="knapp" type="button" id="r-oppna-knapp">Öppna min profil →</button></p>
  </div>

  <div class="besked besked--fel" id="r-fel" role="alert" hidden>
    <p id="r-fel-text"></p>
    <p><a href={url('/uppdrag/lagg-upp')}>Be om en ny länk →</a></p>
  </div>

  <div class="besked" id="r-klar" role="status" tabindex="-1" hidden>
    <p id="r-klar-text"></p>
    <p><a href={url('/uppdrag')}>Till listan →</a></p>
  </div>

  <div class="redigera" id="r-yta" hidden>
    <form class="uppdragsform" id="profil-form" novalidate data-api={UPPDRAG_API}>
      <div class="falt">
        <label class="falt__etikett" for="f-namn">Namn</label>
        <input id="f-namn" name="namn" type="text" maxlength="60" autocomplete="name" required aria-describedby="fel-namn" />
        <p class="falt__fel" id="fel-namn" hidden></p>
      </div>

      <div class="falt">
        <label class="falt__etikett" for="f-lank">Din länk</label>
        <p class="falt__hjalp" id="hjalp-lank">GitHub, X, en egen sida eller LinkedIn. Hela raden i listan leder dit.</p>
        <div class="faltrad">
          <input id="f-lank" name="lank" type="url" maxlength="300" inputmode="url" placeholder="https://" required aria-describedby="hjalp-lank fel-lank lank-status" />
          <button class="knapp knapp--ghost" type="button" id="f-lankhamta">Hämta från länken →</button>
        </div>
        <p class="falt__hjalp" id="lank-status" role="status"></p>
        <p class="falt__fel" id="fel-lank" hidden></p>
      </div>

      <div class="falt">
        <label class="falt__etikett" for="f-rubrik">Vad du gör, på en rad</label>
        <p class="falt__hjalp" id="hjalp-rubrik">Till exempel: Bygger agenter och RAG åt mindre bolag.</p>
        <input id="f-rubrik" name="rubrik" type="text" maxlength="90" required aria-describedby="hjalp-rubrik fel-rubrik" />
        <p class="falt__fel" id="fel-rubrik" hidden></p>
      </div>

      <div class="falt">
        <label class="falt__etikett" for="f-kunskap">Kunskaper, högst sex</label>
        <p class="falt__hjalp" id="hjalp-kunskaper">Det du vill bli hittad på: tekniker, språk och verktyg. Orden står på raden och går att söka på.</p>
        <ul class="ordval" id="kunskaper-valda" aria-label="Dina kunskaper"></ul>
        <div class="faltrad">
          <input id="f-kunskap" type="text" maxlength="24" list="kunskaper-lista" autocomplete="off" spellcheck="false" placeholder="Till exempel RAG" aria-describedby="hjalp-kunskaper fel-kunskaper" />
          <button class="knapp knapp--ghost" type="button" id="f-kunskap-lagg">Lägg till</button>
        </div>
        <datalist id="kunskaper-lista">{KUNSKAPSFORSLAG.map((k) => <option value={k} />)}</datalist>
        <div class="falt" id="kunskaper-hamtade" hidden>
          <p class="falt__hjalp">Förslag från GitHub. Välj dem som stämmer.</p>
          <div class="ordval ordval--forslag" id="kunskaper-forslag"></div>
        </div>
        <p class="falt__fel" id="fel-kunskaper" role="status" hidden></p>
      </div>

      <fieldset aria-describedby="hjalp-bild fel-bild">
        <legend>Din bild, frivillig</legend>
        <p class="falt__hjalp" id="hjalp-bild">Utan bild står föreningens hand på raden. En bild beskärs till en kvadrat i din webbläsare, och platsuppgifter i filen följer inte med.</p>
        <div class="bildval">
          <span class="bildval__visning"><img id="bild-visning" src={url('/pixelhand.webp')} alt="" class="bildval__hand" /></span>
          <div class="bildval__vagar">
            <div>
              <input class="bildval__fil" type="file" id="f-bildfil" accept="image/jpeg,image/png,image/webp" />
              <label class="knapp knapp--ghost knapp--liten" for="f-bildfil">Ladda upp en bild →</label>
            </div>
            <div class="bildval__x">
              <label class="visuellt-dold" for="f-xnamn">Ditt användarnamn på X</label>
              <input id="f-xnamn" type="text" maxlength="16" placeholder="@användarnamn på X" autocomplete="off" spellcheck="false" />
              <button class="knapp knapp--ghost knapp--liten" type="button" id="f-xhamta">Hämta från X →</button>
            </div>
          </div>
        </div>
        <p class="falt__hjalp" id="bild-status" role="status"></p>
        <p class="falt__fel" id="fel-bild" hidden></p>
      </fieldset>

      <fieldset aria-describedby="fel-erbjuder">
        <legend>Vad du erbjuder</legend>
        <label class="val"><input type="radio" name="erbjuder" value="uppdrag" checked /> Tar uppdrag</label>
        <label class="val"><input type="radio" name="erbjuder" value="tjanster" /> Säljer tjänster</label>
        <label class="val"><input type="radio" name="erbjuder" value="bada" /> Båda</label>
        <p class="falt__fel" id="fel-erbjuder" hidden></p>
      </fieldset>

      <div class="falt">
        <label class="falt__etikett" for="f-kommun">Ort, frivilligt</label>
        <p class="falt__hjalp" id="hjalp-kommun">Bara kommunen visas, aldrig en adress. Väljer du en kommun står din hand i dess mitt på kartan.</p>
        <select id="f-kommun" name="kommun" aria-describedby="hjalp-kommun fel-kommun">
          <option value="">Ingen ort</option>
          {kommuner.map((k) => <option value={k.kod}>{k.namn}</option>)}
        </select>
        <p class="falt__fel" id="fel-kommun" hidden></p>
        <label class="val"><input type="checkbox" name="distans" id="f-distans" /> Jag tar uppdrag på distans</label>
      </div>

      <fieldset aria-describedby="hjalp-omraden fel-omraden">
        <legend>Områden, högst tre</legend>
        <p class="falt__hjalp" id="hjalp-omraden">Samma områden som på kartan. De står efter dina kunskaper och går att söka på.</p>
        <div class="valrutnat">
          {d.taxonomi.omraden.map((o) => (
            <label class="val"><input type="checkbox" name="omraden" value={o.id} /> {o.label}</label>
          ))}
        </div>
        <p class="falt__fel" id="fel-omraden" hidden></p>
      </fieldset>

      <details class="dragspel" id="f-bolag-ruta">
        <summary>Har du bolag? Frivilligt</summary>
        <div class="dragspel__kropp uppdragsform">
          <div class="falt">
            <label class="falt__etikett" for="f-bolag-namn">Bolagets namn</label>
            <p class="falt__hjalp" id="hjalp-bolag">Skriv aldrig ett organisationsnummer. För en enskild firma är det ditt personnummer.</p>
            <input id="f-bolag-namn" name="bolag_namn" type="text" maxlength="80" aria-describedby="hjalp-bolag fel-bolag_namn" />
            <p class="falt__fel" id="fel-bolag_namn" hidden></p>
          </div>
          <div class="falt">
            <label class="falt__etikett" for="f-bolag-webb">Bolagets webbplats</label>
            <input id="f-bolag-webb" name="bolag_webbplats" type="url" maxlength="300" inputmode="url" placeholder="https://" aria-describedby="fel-bolag_webbplats" />
            <p class="falt__fel" id="fel-bolag_webbplats" hidden></p>
          </div>
        </div>
      </details>

      <div class="falt">
        <label class="val">
          <input type="checkbox" name="samtycke" id="f-samtycke" aria-describedby="fel-samtycke" />
          <span>Jag vill synas under Tar uppdrag på AI-kartan med uppgifterna och bilden ovan: i listan, och som en hand i min kommuns mitt på kartan. Kortet visar att jag är medlem i OpenSverige. Jag kan ta bort profilen när som helst, och då försvinner den och bilden direkt.</span>
        </label>
        <p class="falt__fel" id="fel-samtycke" hidden></p>
      </div>

      <div class="besked besked--fel" id="r-sparfel" role="alert" hidden></div>

      <div class="rad">
        <button class="knapp" type="submit" id="r-spara">Spara och visa →</button>
        <button class="knapp knapp--fara" type="button" id="r-ta-bort" hidden>Ta bort min profil</button>
      </div>
      <div class="besked besked--fel" id="r-bekrafta" hidden>
        <p><strong>Ta bort profilen?</strong> Den försvinner från listan direkt, och klicken raderas.</p>
        <div class="rad mt-1">
          <button class="knapp knapp--fara" type="button" id="r-ja-ta-bort">Ja, ta bort</button>
          <button class="knapp knapp--ghost" type="button" id="r-avbryt">Avbryt</button>
        </div>
      </div>
    </form>

    <aside class="redigera__forhand" aria-labelledby="forhand-rubrik">
      <p class="kicker" id="forhand-rubrik">Så här syns du</p>
      <div class="medlemslista" id="forhand"></div>
      <p class="meta" id="r-klick" hidden></p>
      <p class="meta" id="r-session"></p>
    </aside>
  </div>
</Sida>

<style>
  .redigera {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 360px);
    gap: 40px;
    align-items: start;
  }
  .redigera__forhand {
    position: sticky;
    top: calc(var(--huvud-h) + 20px);
    display: grid;
    gap: 10px;
  }
  .redigera__forhand .kicker {
    margin: 0;
  }
  .redigera__forhand .meta {
    margin: 0;
  }
  #r-laddar,
  #r-oppna,
  #r-fel,
  #r-klar {
    max-width: 560px;
    margin-bottom: 24px;
    scroll-margin-top: calc(var(--huvud-h) + 16px);
  }
  @media (max-width: 900px) {
    .redigera {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .redigera__forhand {
      position: static;
      order: -1;
    }
  }
</style>

<script>
  import {
    bildUrl,
    forslagFranGithub,
    giltigKunskap,
    harPersonnummer,
    lanktyp,
    MAX_KUNSKAPER,
    medKunskap,
    somRubrik,
    type GithubForrad,
    type Profil,
  } from '../../lib/uppdrag';
  import { pixelhandSrc, ritaKort, type Etiketter } from '../../lib/uppdragkort';

  type Lagrat = {
    session: string;
    utgar_at: string;
    profil: Profil | null;
    forslag: { namn: string };
    klick30: number;
  };

  const NYCKEL = 'uppdrag-session';
  const form = document.getElementById('profil-form') as HTMLFormElement;
  const api = form.dataset.api ?? '';
  const etiketter = JSON.parse(document.getElementById('uppdrag-etiketter')?.textContent || '{}') as Etiketter;
  const hitta = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;
  const laddar = hitta('r-laddar');
  const oppna = hitta('r-oppna');
  const felruta = hitta('r-fel');
  const klar = hitta('r-klar');
  const yta = hitta('r-yta');
  const forhand = hitta('forhand');
  const klick = hitta('r-klick');
  const sessionText = hitta('r-session');
  const spara = hitta<HTMLButtonElement>('r-spara');
  const taBort = hitta<HTMLButtonElement>('r-ta-bort');
  const bekrafta = hitta('r-bekrafta');
  const sparfel = hitta('r-sparfel');

  let lagrat: Lagrat | null = null;
  /** En ny bild, beskuren och omkodad, som en data-adress. Skickas med när profilen sparas. */
  let nyBild: string | null = null;
  /** Kunskaperna som de står i formuläret, och förslagen som hämtats från medlemmens GitHub. */
  let kunskaper: string[] = [];
  let forslag: string[] = [];
  const bildVisning = hitta<HTMLImageElement>('bild-visning');
  const bildStatus = hitta('bild-status');
  const BILD_SIDA = 512;
  const BILD_MIN = 160;
  const BILD_MAX_BYTES = 300 * 1024;

  function lasLagrat(): Lagrat | null {
    try {
      const l = JSON.parse(sessionStorage.getItem(NYCKEL) || 'null') as Lagrat | null;
      return l && new Date(l.utgar_at).getTime() > Date.now() ? l : null;
    } catch {
      return null;
    }
  }
  function sparaLagrat(l: Lagrat | null): void {
    try {
      if (l) sessionStorage.setItem(NYCKEL, JSON.stringify(l));
      else sessionStorage.removeItem(NYCKEL);
    } catch {
      // Utan lagring fungerar sidan ändå, men en omladdning kräver en ny länk.
    }
  }

  function visa(del: 'laddar' | 'oppna' | 'fel' | 'yta' | 'klar', text = ''): void {
    laddar.hidden = del !== 'laddar';
    oppna.hidden = del !== 'oppna';
    felruta.hidden = del !== 'fel';
    yta.hidden = del !== 'yta';
    klar.hidden = del !== 'klar';
    if (del === 'fel') hitta('r-fel-text').textContent = text;
    if (del === 'klar') {
      hitta('r-klar-text').textContent = text;
      klar.focus();
    }
  }

  const falt = (namn: string): HTMLInputElement => form.elements.namedItem(namn) as HTMLInputElement;

  function fyll(l: Lagrat): void {
    const p = l.profil;
    falt('namn').value = p?.namn ?? l.forslag.namn ?? '';
    falt('rubrik').value = p?.rubrik ?? '';
    falt('lank').value = p?.lank ?? '';
    for (const r of form.querySelectorAll<HTMLInputElement>('input[name="erbjuder"]')) r.checked = r.value === (p?.erbjuder ?? 'uppdrag');
    (form.elements.namedItem('kommun') as HTMLSelectElement).value = p?.kommun ?? '';
    falt('distans').checked = p?.distans ?? false;
    for (const c of form.querySelectorAll<HTMLInputElement>('input[name="omraden"]')) c.checked = p?.omraden.includes(c.value) ?? false;
    falt('bolag_namn').value = p?.bolag_namn ?? '';
    falt('bolag_webbplats').value = p?.bolag_webbplats ?? '';
    if (p?.bolag_namn || p?.bolag_webbplats) (hitta('f-bolag-ruta') as HTMLDetailsElement).open = true;
    falt('samtycke').checked = Boolean(p);
    kunskaper = [...(p?.kunskaper ?? [])];
    forslag = [];
    visaKunskaper();
    nyBild = null;
    visaBild();
    taBort.hidden = !p;
    begransaOmraden();
    visaStatus(l);
    forhandsvisa();
  }

  function visaStatus(l: Lagrat): void {
    const tid = new Intl.DateTimeFormat('sv-SE', { hour: '2-digit', minute: '2-digit' }).format(new Date(l.utgar_at));
    sessionText.textContent = `Länken gäller till ${tid}. Sedan behövs en ny.`;
    klick.hidden = !l.profil;
    klick.textContent = `Din länk har klickats ${l.klick30} ${l.klick30 === 1 ? 'gång' : 'gånger'} de senaste 30 dagarna.`;
  }

  function lasForm(): Record<string, unknown> {
    const erbjuder = form.querySelector<HTMLInputElement>('input[name="erbjuder"]:checked')?.value ?? 'uppdrag';
    return {
      namn: falt('namn').value.trim(),
      rubrik: falt('rubrik').value.trim(),
      lank: falt('lank').value.trim(),
      erbjuder,
      kommun: (form.elements.namedItem('kommun') as HTMLSelectElement).value,
      distans: falt('distans').checked,
      omraden: [...form.querySelectorAll<HTMLInputElement>('input[name="omraden"]:checked')].map((c) => c.value),
      kunskaper,
      bolag_namn: falt('bolag_namn').value.trim(),
      bolag_webbplats: falt('bolag_webbplats').value.trim(),
      samtycke: falt('samtycke').checked,
      bild: nyBild ?? undefined,
    };
  }

  function forhandsvisa(): void {
    const f = lasForm();
    const profil: Profil = {
      slug: lagrat?.profil?.slug ?? 'forhandsvisning',
      namn: String(f.namn),
      rubrik: String(f.rubrik),
      lank: String(f.lank) || 'https://',
      erbjuder: f.erbjuder as Profil['erbjuder'],
      kommun: String(f.kommun) || null,
      distans: Boolean(f.distans),
      omraden: f.omraden as string[],
      kunskaper,
      bolag_namn: String(f.bolag_namn) || null,
      bolag_webbplats: String(f.bolag_webbplats) || null,
      uppdaterad_at: lagrat?.profil?.uppdaterad_at ?? new Date().toISOString(),
      bild: lagrat?.profil?.bild ?? null,
    };
    forhand.replaceChildren(ritaKort(profil, etiketter, { forhandsvisning: true, form: 'rad', bildSrc: nyBild ?? undefined }));
  }

  function begransaOmraden(): void {
    const rutor = [...form.querySelectorAll<HTMLInputElement>('input[name="omraden"]')];
    const fulla = rutor.filter((c) => c.checked).length >= 3;
    for (const c of rutor) c.disabled = fulla && !c.checked;
  }

  const FELTEXT: Record<string, string> = {
    namn: 'Skriv ditt namn, högst 60 tecken, utan @ och utan siffror i följd.',
    rubrik: 'Skriv en rad, högst 90 tecken. Inga länkar och inget personnummer.',
    lank: 'Länken ska börja med https://.',
    erbjuder: 'Välj vad du erbjuder.',
    kommun: 'Välj en kommun ur listan.',
    distans: 'Något gick fel med valet Distans. Ladda om sidan.',
    omraden: 'Välj högst tre områden.',
    kunskaper: 'Korta ord, högst 24 tecken var. Inga länkar eller adresser.',
    bolag_namn: 'Högst 80 tecken. Inget organisationsnummer.',
    bolag_webbplats: 'Länken ska börja med https://.',
    samtycke: 'Kryssa i rutan för att synas i listan.',
    bild: 'Bilden gick inte att spara. Prova en annan, eller spara utan bild.',
  };

  function visaFel(namn: string[]): void {
    for (const id of Object.keys(FELTEXT)) {
      const p = document.getElementById(`fel-${id}`);
      if (!p) continue;
      const fel = namn.includes(id);
      p.textContent = fel ? FELTEXT[id] : '';
      p.hidden = !fel;
      const input = form.elements.namedItem(id);
      if (input instanceof HTMLInputElement || input instanceof HTMLSelectElement) input.setAttribute('aria-invalid', String(fel));
    }
    const forsta = namn[0];
    if (forsta) {
      if (forsta.startsWith('bolag')) (hitta('f-bolag-ruta') as HTMLDetailsElement).open = true;
      const input = form.elements.namedItem(forsta);
      if (input instanceof HTMLElement) input.focus();
      else if (forsta === 'kunskaper') kunskapFalt.focus();
      else form.querySelector<HTMLInputElement>(`input[name="${forsta}"]`)?.focus();
    }
  }

  /** Samma regler som funktionen, så att de vanliga felen syns innan något skickas. */
  function provaLokalt(f: Record<string, unknown>): string[] {
    const fel: string[] = [];
    const https = (s: string): boolean => {
      try {
        const u = new URL(s);
        return u.protocol === 'https:' && u.hostname.includes('.');
      } catch {
        return false;
      }
    };
    const namn = String(f.namn);
    const rubrik = String(f.rubrik);
    if (!namn || namn.includes('@') || harPersonnummer(namn)) fel.push('namn');
    if (!rubrik || /[<>]|:\/\//.test(rubrik) || harPersonnummer(rubrik)) fel.push('rubrik');
    if (!https(String(f.lank))) fel.push('lank');
    if ((f.omraden as string[]).length > 3) fel.push('omraden');
    if (harPersonnummer(String(f.bolag_namn))) fel.push('bolag_namn');
    if (f.bolag_webbplats && !https(String(f.bolag_webbplats))) fel.push('bolag_webbplats');
    if (!f.samtycke) fel.push('samtycke');
    return fel;
  }

  /* ---------- Bilden ---------- */

  function visaBild(): void {
    const sparad = lagrat?.profil ? bildUrl(lagrat.profil) : null;
    const src = nyBild ?? sparad;
    bildVisning.src = src ?? pixelhandSrc();
    bildVisning.classList.toggle('bildval__hand', !src);
  }

  /** WebP med ett enda bildblock. Funktionen godtar inte det utökade formatet, som kan bära metadata. */
  function enkelWebp(data: string): boolean {
    const start = data.indexOf(',') + 1;
    const b = atob(data.slice(start, start + 24));
    return b.slice(0, 4) === 'RIFF' && b.slice(8, 12) === 'WEBP' && (b.slice(12, 16) === 'VP8 ' || b.slice(12, 16) === 'VP8L');
  }

  /**
   * Beskär till en kvadrat i mitten och kodar om. Omkodningen tar bort all metadata, som plats.
   * WebP där webbläsaren kan, annars JPEG.
   */
  async function kodaOm(kalla: Blob): Promise<string> {
    const bitmap = await createImageBitmap(kalla);
    const sida = Math.min(bitmap.width, bitmap.height);
    if (sida < BILD_MIN) {
      bitmap.close();
      throw new Error('liten');
    }
    const ut = Math.min(BILD_SIDA, sida);
    const duk = document.createElement('canvas');
    duk.width = ut;
    duk.height = ut;
    // Utan alfakanal blir WebP det enkla formatet, och en genomskinlig bild får mörk botten.
    const ctx = duk.getContext('2d', { alpha: false });
    if (!ctx) throw new Error('duk');
    ctx.fillStyle = '#141310';
    ctx.fillRect(0, 0, ut, ut);
    ctx.drawImage(bitmap, (bitmap.width - sida) / 2, (bitmap.height - sida) / 2, sida, sida, 0, 0, ut, ut);
    bitmap.close();
    const forsok: [string, number][] = [['image/webp', 0.86], ['image/jpeg', 0.88], ['image/jpeg', 0.72]];
    for (const [typ, kvalitet] of forsok) {
      const data = duk.toDataURL(typ, kvalitet);
      if (!data.startsWith(`data:${typ};base64,`)) continue;
      if (typ === 'image/webp' && !enkelWebp(data)) continue;
      if ((data.length - data.indexOf(',') - 1) * 0.75 <= BILD_MAX_BYTES) return data;
    }
    throw new Error('stor');
  }

  /** Tar in en bild och säger om det gick. Varför det inte gick står under bilden. */
  async function taIn(kalla: Blob, klar: string): Promise<boolean> {
    bildStatus.textContent = 'Beskär bilden …';
    try {
      nyBild = await kodaOm(kalla);
      bildStatus.textContent = klar;
      const fel = hitta('fel-bild');
      fel.hidden = true;
      fel.textContent = '';
      visaBild();
      forhandsvisa();
      return true;
    } catch (e) {
      const skal = e instanceof Error ? e.message : '';
      bildStatus.textContent =
        skal === 'liten'
          ? `Bilden är för liten. Välj en som är minst ${BILD_MIN} punkter på bredden och höjden.`
          : skal === 'stor'
            ? 'Bilden blev för stor. Prova en annan.'
            : 'Kunde inte läsa bilden. Prova en JPG eller PNG.';
      return false;
    }
  }

  const bildfil = hitta<HTMLInputElement>('f-bildfil');
  bildfil.addEventListener('change', () => {
    const fil = bildfil.files?.[0];
    bildfil.value = '';
    if (fil) void taIn(fil, 'Bilden är klar. Den sparas när du sparar profilen.');
  });

  // Bilden från X hämtas av din webbläsare via unavatar.io, som slår upp profilbilden. Bara
  // användarnamnet skickas, och bilden kodas om här som en uppladdad bild.
  const xnamn = hitta<HTMLInputElement>('f-xnamn');
  const xhamta = hitta<HTMLButtonElement>('f-xhamta');
  async function hamtaFranX(): Promise<void> {
    const namn = xnamn.value.trim().replace(/^@/, '');
    if (!/^[A-Za-z0-9_]{1,15}$/.test(namn)) {
      bildStatus.textContent = 'Skriv ditt användarnamn på X, med eller utan @.';
      return;
    }
    bildStatus.textContent = 'Hämtar bilden från X …';
    xhamta.disabled = true;
    try {
      const r = await fetch(`https://unavatar.io/x/${encodeURIComponent(namn)}?fallback=false`, {
        credentials: 'omit',
        referrerPolicy: 'no-referrer',
      });
      if (!r.ok) throw new Error(String(r.status));
      const blob = await r.blob();
      if (!blob.type.startsWith('image/')) throw new Error('typ');
      await taIn(blob, `Bilden från @${namn} är klar. Den sparas när du sparar profilen.`);
    } catch {
      bildStatus.textContent = 'Hittade ingen bild för det namnet på X just nu. Ladda upp en bild i stället.';
    } finally {
      xhamta.disabled = false;
    }
  }
  xhamta.addEventListener('click', () => void hamtaFranX());
  // Enter i namnfältet hämtar bilden i stället för att skicka hela formuläret.
  xnamn.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    void hamtaFranX();
  });

  /* ---------- Kunskaperna ---------- */

  const kunskapFalt = hitta<HTMLInputElement>('f-kunskap');
  const kunskaperValda = hitta('kunskaper-valda');
  const forslagYta = hitta('kunskaper-hamtade');
  const forslagRad = hitta('kunskaper-forslag');
  const kunskapFel = hitta('fel-kunskaper');

  function ordknapp(ord: string, text: string, etikett: string): HTMLButtonElement {
    const knapp = document.createElement('button');
    knapp.type = 'button';
    knapp.className = 'ordval__ord';
    knapp.textContent = text;
    knapp.dataset.ord = ord;
    knapp.setAttribute('aria-label', etikett);
    return knapp;
  }

  function visaKunskaper(): void {
    kunskaperValda.replaceChildren(
      ...kunskaper.map((k) => {
        const li = document.createElement('li');
        li.append(ordknapp(k, `${k} ×`, `Ta bort ${k}`));
        return li;
      }),
    );
    const kvar = forslag.filter((f) => !kunskaper.some((k) => k.toLowerCase() === f.toLowerCase()));
    forslagRad.replaceChildren(...kvar.map((f) => ordknapp(f, `+ ${f}`, `Lägg till ${f}`)));
    forslagYta.hidden = kvar.length === 0;
  }

  /** Lägger till det som står i texten. Flera ord går att skriva eller klistra in med komma emellan. */
  function laggTillKunskaper(text: string): void {
    const ord = text.split(',').map((o) => o.trim()).filter(Boolean);
    if (!ord.length) return;
    const full = kunskaper.length >= MAX_KUNSKAPER;
    for (const o of ord) kunskaper = medKunskap(kunskaper, o);
    const fel = full ? 'Högst sex. Ta bort ett ord för att lägga till ett nytt.' : ord.some((o) => !giltigKunskap(o.replace(/\s+/g, ' '))) ? FELTEXT.kunskaper : '';
    kunskapFel.textContent = fel;
    kunskapFel.hidden = !fel;
    visaKunskaper();
    forhandsvisa();
  }

  function laggTillFranFaltet(): void {
    laggTillKunskaper(kunskapFalt.value);
    if (kunskapFel.hidden) kunskapFalt.value = '';
  }
  hitta('f-kunskap-lagg').addEventListener('click', () => {
    laggTillFranFaltet();
    kunskapFalt.focus();
  });
  // Enter och komma lägger till ordet i stället för att skicka hela formuläret.
  kunskapFalt.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ',') return;
    e.preventDefault();
    laggTillFranFaltet();
  });
  kunskaperValda.addEventListener('click', (e) => {
    const ord = (e.target as Element | null)?.closest<HTMLElement>('[data-ord]')?.dataset.ord;
    if (!ord) return;
    kunskaper = kunskaper.filter((k) => k !== ord);
    kunskapFel.hidden = true;
    visaKunskaper();
    forhandsvisa();
    kunskapFalt.focus();
  });
  forslagRad.addEventListener('click', (e) => {
    const ord = (e.target as Element | null)?.closest<HTMLElement>('[data-ord]')?.dataset.ord;
    if (ord) laggTillKunskaper(ord);
  });

  /* ---------- Hämta från länken ---------- */

  // Medlemmen har redan skrivit sin länk. Går den till GitHub, X eller en egen sida hämtar
  // webbläsaren det som ligger öppet där: bilden via unavatar.io, och från GitHub också
  // presentationen och språken i de öppna kodförråden. Bara kontots namn eller sidans adress
  // skickas. Inget sparas förrän medlemmen sparar, och allt går att ändra först.
  const lankStatus = hitta('lank-status');
  const lankHamta = hitta<HTMLButtonElement>('f-lankhamta');
  const UTAN_SPAR: RequestInit = { credentials: 'omit', referrerPolicy: 'no-referrer' };

  async function hamtaBild(adress: string): Promise<boolean> {
    try {
      const r = await fetch(adress, UTAN_SPAR);
      if (!r.ok) return false;
      const blob = await r.blob();
      if (!blob.type.startsWith('image/')) return false;
      return await taIn(blob, 'Bilden från länken är klar. Den sparas när du sparar profilen.');
    } catch {
      return false;
    }
  }

  async function hamtaGithub(namn: string): Promise<{ rubrik: string; forslag: string[] }> {
    const las = async <T,>(vag: string): Promise<T | null> => {
      try {
        const r = await fetch(`https://api.github.com/users/${encodeURIComponent(namn)}${vag}`, {
          ...UTAN_SPAR,
          headers: { Accept: 'application/vnd.github+json' },
        });
        return r.ok ? ((await r.json()) as T) : null;
      } catch {
        return null;
      }
    };
    const [konto, forrad] = await Promise.all([
      las<{ bio?: string | null }>(''),
      las<GithubForrad[]>('/repos?per_page=100&sort=pushed'),
    ]);
    return { rubrik: somRubrik(konto?.bio ?? ''), forslag: Array.isArray(forrad) ? forslagFranGithub(forrad) : [] };
  }

  async function hamtaFranLanken(): Promise<void> {
    const typ = lanktyp(falt('lank').value.trim());
    if (!typ) {
      lankStatus.textContent = 'Skriv din länk först, med https:// i början.';
      return;
    }
    if (typ.typ === 'linkedin') {
      lankStatus.textContent = 'LinkedIn lämnar inte ut något till andra sajter. Fyll i själv. Bilden går att hämta från X längre ner.';
      return;
    }
    lankHamta.disabled = true;
    lankStatus.textContent = 'Hämtar …';
    try {
      const hamtat: string[] = [];
      if (typ.typ === 'github') {
        const [bild, konto] = await Promise.all([
          hamtaBild(`https://unavatar.io/github/${encodeURIComponent(typ.namn)}?fallback=false`),
          hamtaGithub(typ.namn),
        ]);
        if (bild) hamtat.push('bilden');
        if (konto.rubrik && !falt('rubrik').value.trim()) {
          falt('rubrik').value = konto.rubrik;
          hamtat.push('raden om vad du gör');
        }
        forslag = konto.forslag;
        if (forslag.length) hamtat.push('förslag på kunskaper');
        visaKunskaper();
      } else if (typ.typ === 'x') {
        if (await hamtaBild(`https://unavatar.io/x/${encodeURIComponent(typ.namn)}?fallback=false`)) hamtat.push('bilden');
      } else if (await hamtaBild(`https://unavatar.io/${encodeURIComponent(typ.host)}?fallback=false`)) {
        hamtat.push('bilden');
      }
      forhandsvisa();
      const uppraknat = hamtat.length > 1 ? `${hamtat.slice(0, -1).join(', ')} och ${hamtat.at(-1)}` : hamtat[0];
      lankStatus.textContent = hamtat.length
        ? `Hämtade ${uppraknat}. Ändra det som inte stämmer. Inget sparas förrän du sparar.`
        : typ.typ === 'sida'
          ? `Hittade ingen bild på ${typ.host} som går att använda. Fyll i själv.`
          : 'Hittade inget att hämta just nu. Fyll i själv.';
    } finally {
      lankHamta.disabled = false;
    }
  }
  lankHamta.addEventListener('click', () => void hamtaFranLanken());

  async function anrop(metod: 'PUT' | 'DELETE', kropp?: unknown): Promise<Response> {
    return fetch(`${api}/profil`, {
      method: metod,
      headers: { 'Content-Type': 'application/json', 'x-uppdrag-session': lagrat?.session ?? '' },
      body: kropp === undefined ? undefined : JSON.stringify(kropp),
    });
  }

  function sessionSlut(): void {
    sparaLagrat(null);
    lagrat = null;
    visa('fel', 'Länken har gått ut. Be om en ny, så kan du fortsätta där du var.');
  }

  form.addEventListener('input', () => {
    begransaOmraden();
    forhandsvisa();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    sparfel.hidden = true;
    // Ett ord som står kvar i fältet räknas med, också när medlemmen inte tryckte på Lägg till.
    if (kunskapFalt.value.trim()) laggTillFranFaltet();
    const f = lasForm();
    const lokala = provaLokalt(f);
    visaFel(lokala);
    if (lokala.length) return;
    spara.disabled = true;
    spara.textContent = 'Sparar …';
    try {
      const svar = await anrop('PUT', f);
      const data = (await svar.json().catch(() => ({}))) as { profil?: Profil; klick30?: number; fel?: string; falt?: string[] };
      if (svar.status === 401) return sessionSlut();
      if (svar.status === 422) return visaFel(data.falt ?? []);
      if (!svar.ok || !data.profil || !lagrat) throw new Error(data.fel ?? 'Kunde inte spara.');
      lagrat = { ...lagrat, profil: data.profil, klick30: data.klick30 ?? lagrat.klick30 };
      sparaLagrat(lagrat);
      nyBild = null;
      bildStatus.textContent = '';
      visaBild();
      taBort.hidden = false;
      visaStatus(lagrat);
      forhandsvisa();
      sparfel.hidden = true;
      hitta('r-klar-text').textContent = 'Sparat. Du syns nu i listan.';
      klar.hidden = false;
      // Knappen ligger längst ner och kvittot högst upp. Utan att rulla dit syns inget hända.
      klar.focus({ preventScroll: true });
      klar.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    } catch (err) {
      sparfel.textContent = err instanceof Error && err.message ? err.message : 'Kunde inte spara. Försök igen.';
      sparfel.hidden = false;
    } finally {
      spara.disabled = false;
      spara.textContent = 'Spara och visa →';
    }
  });

  taBort.addEventListener('click', () => {
    bekrafta.hidden = false;
    hitta<HTMLButtonElement>('r-avbryt').focus();
  });
  hitta('r-avbryt').addEventListener('click', () => {
    bekrafta.hidden = true;
    taBort.focus();
  });
  hitta('r-ja-ta-bort').addEventListener('click', async () => {
    try {
      const svar = await anrop('DELETE');
      if (svar.status === 401) return sessionSlut();
      if (!svar.ok) throw new Error();
      if (lagrat) {
        lagrat = { ...lagrat, profil: null, klick30: 0 };
        sparaLagrat(lagrat);
      }
      visa('klar', 'Profilen är borttagen. Den syns inte längre i listan.');
    } catch {
      bekrafta.hidden = true;
      sparfel.textContent = 'Kunde inte ta bort profilen. Försök igen.';
      sparfel.hidden = false;
    }
  });

  async function oppnaMedKod(token: string): Promise<void> {
    visa('laddar');
    try {
      const svar = await fetch(`${api}/session`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      const data = (await svar.json().catch(() => ({}))) as Partial<Lagrat> & { fel?: string };
      if (!svar.ok || !data.session || !data.utgar_at) {
        return visa('fel', data.fel ?? 'Länken fungerade inte. Be om en ny.');
      }
      lagrat = {
        session: data.session,
        utgar_at: data.utgar_at,
        profil: data.profil ?? null,
        forslag: data.forslag ?? { namn: '' },
        klick30: data.klick30 ?? 0,
      };
      sparaLagrat(lagrat);
      fyll(lagrat);
      visa('yta');
    } catch {
      visa('fel', 'Det gick inte att nå servern. Öppna länken i mejlet igen om en stund.');
    }
  }

  function starta(): void {
    const token = new URLSearchParams(location.hash.slice(1)).get('t');
    if (token) {
      // Koden ska inte ligga kvar i adressfältet eller historiken. Den finns bara i minnet
      // tills medlemmen klickar, och en omladdning innan dess kräver länken igen.
      history.replaceState(null, '', location.pathname);
      hitta('r-oppna-knapp').addEventListener('click', () => oppnaMedKod(token), { once: true });
      visa('oppna');
      return;
    }
    lagrat = lasLagrat();
    if (!lagrat) return visa('fel', 'Den här sidan öppnas med länken i mejlet. Be om en ny om den har gått ut.');
    fyll(lagrat);
    visa('yta');
  }

  starta();
</script>
