---
import Sida from '../../layouts/Sida.astro';
import { hamtaData, hamtaPlatsamnen, amnesstig, url } from '../../lib/data';
import { MINST_PER_SIDA, amnesrubrik } from '../../lib/platsamne';
import { talord } from '../../lib/text';

const d = hamtaData();
const amnen = [...hamtaPlatsamnen().kommuner, ...hamtaPlatsamnen().lan].sort((a, b) => b.organisationer.length - a.organisationer.length);
const omradesetikett = (id: string) => d.etikett.omraden.get(id)?.label ?? id;
---

<Sida
  titel="AI i Sveriges kommuner och län"
  kicker="Platser"
  ingress={`${d.platser.kommuner.length} kommuner och ${d.platser.lan.length} län har organisationer på kartan. Varje plats har en egen sida: vem som bygger AI just där.`}
  beskrivning="Organisationer som bygger AI, per kommun och län i Sverige. Positioner på kommunnivå med källa och datum."
  stig="/plats"
  bred
>
  <section>
    <h2 id="lan">Län</h2>
    <ul class="platslista">
      {d.platser.lan.map((l) => (
        <li><a href={url(`/lan/${l.slug}`)}>{l.namn}</a> <span class="meta">{l.organisationer.length}</span></li>
      ))}
    </ul>
  </section>
  <section>
    <h2 id="kommuner">Kommuner</h2>
    <ul class="platslista">
      {d.platser.kommuner.map((k) => (
        <li><a href={url(`/plats/${k.slug}`)}>{k.namn}</a> <span class="meta">{k.organisationer.length}</span></li>
      ))}
    </ul>
    {d.statistik.utan_plats > 0 && (
      <p class="meta">{d.statistik.utan_plats} organisationer saknar känt säte och visas bara i <a href={url('/organisationer')}>listan</a>.</p>
    )}
  </section>
  {amnen.length > 0 && (
    <section>
      <h2 id="omraden">Plats och område</h2>
      <p class="lasbredd">Där minst {talord(MINST_PER_SIDA)} organisationer på en plats arbetar inom samma område finns en egen sida.</p>
      <ul class="platslista">
        {amnen.map((a) => (
          <li><a href={url(amnesstig(a))}>{amnesrubrik(a.omrade, omradesetikett(a.omrade))} i {a.plats.namn}</a> <span class="meta">{a.organisationer.length}</span></li>
        ))}
      </ul>
    </section>
  )}
</Sida>

<style>
  .platslista {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 4px 16px;
  }
  .platslista li {
    padding: 6px 0;
    border-bottom: 1px solid hsl(var(--rule-soft));
    display: flex;
    justify-content: space-between;
  }
</style>
