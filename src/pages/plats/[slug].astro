---
import Bas from '../../layouts/Bas.astro';
import OrgKort from '../../components/OrgKort.astro';
import Platsfragor from '../../components/Platsfragor.astro';
import { hamtaData, hamtaPlatsamnen, amnesstig, platsfragedata, url, absolutUrl } from '../../lib/data';
import { brodsmulor } from '../../lib/meta';
import { antal } from '../../lib/text';
import { MAX_NAMN, faqSchema, platsfragor } from '../../lib/platsamne';
import type { Plats } from '../../lib/data';

export function getStaticPaths() {
  return hamtaData().platser.kommuner.map((p) => ({ params: { slug: p.slug }, props: { plats: p } }));
}
interface Props {
  plats: Plats;
}
const { plats } = Astro.props;
const d = hamtaData();
const n = plats.organisationer.length;
const rubrik = `AI i ${plats.namn}`;
// Titeln följer hur folk söker. Finns inga bolag på platsen lovar den inga.
const titel = plats.organisationer.some((o) => o.type.value === 'bolag') ? `AI-bolag och organisationer i ${plats.namn}` : `Organisationer som bygger AI i ${plats.namn}`;
const underlag = platsfragedata(plats);
// Första frågan besvaras av ingressen. De andra står under den, var och en med sin rubrik.
const [vilka, ...fragor] = platsfragor(underlag);
const lankar = {
  omraden: hamtaPlatsamnen()
    .kommuner.filter((a) => a.plats === plats)
    .sort((a, b) => b.organisationer.length - a.organisationer.length)
    .map((a) => ({ text: `${d.etikett.omraden.get(a.omrade)?.label ?? a.omrade} · ${a.organisationer.length}`, href: url(amnesstig(a)) })),
  offentliga: underlag.offentliga
    .filter((o) => o.namn.length > MAX_NAMN)
    .map((o) => ({ text: `Alla ${o.plural.toLowerCase()} i ${plats.namn}`, href: url(`/organisationer?typ=${o.slag}&kommun=${plats.kod}`) })),
  kontroll: [{ text: 'Metod och status', href: url('/metod') }],
};
// Kommunens namn står utan ordet kommun: det böjs olika för olika kommuner (Stockholms, Falu, Umeå).
const beskrivning = `${antal(n, 'organisation', 'organisationer')} som bygger AI med säte i ${plats.namn}, ${plats.lan_namn}. Med källa och datum på varje uppgift.`;
const samling = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: rubrik,
  description: beskrivning,
  url: absolutUrl(`/plats/${plats.slug}`),
  about: { '@type': 'City', name: plats.namn, containedInPlace: { '@type': 'AdministrativeArea', name: plats.lan_namn } },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: n,
    itemListElement: plats.organisationer.slice(0, 50).map((o, i) => ({ '@type': 'ListItem', position: i + 1, url: absolutUrl(`/organisation/${o.id}`), name: o.name.value })),
  },
};
const jsonLd = [
  samling,
  faqSchema([vilka, ...fragor]),
  brodsmulor([
    ['Platser', absolutUrl('/plats')],
    ...(plats.lan_slug ? ([[plats.lan_namn, absolutUrl(`/lan/${plats.lan_slug}`)]] as [string, string][]) : []),
    [plats.namn, absolutUrl(`/plats/${plats.slug}`)],
  ]),
];
---

<Bas titel={titel} beskrivning={beskrivning} stig={`/plats/${plats.slug}`} jsonLd={jsonLd}>
  <section class="ram sektion">
    <nav class="meta" aria-label="Du är här">
      <a href={url('/plats')}>Platser</a> › {plats.lan_slug && <a href={url(`/lan/${plats.lan_slug}`)}>{plats.lan_namn}</a>} › <span>{plats.namn}</span>
    </nav>
    <p class="kicker mt-2">Kommun · {plats.lan_namn}</p>
    <h1>{rubrik}</h1>
    <p class="ingress">{vilka.svar} Kartan visar kommunen, aldrig en gatuadress.</p>
    <p class="rad">
      <a class="knapp knapp--liten" href={url(`/?kommun=${plats.kod}`)}>Visa på kartan</a>
      <a class="knapp knapp--ghost knapp--liten" href={url(`/organisationer?lan=${plats.lan_kod}`)}>Hela {plats.lan_namn}</a>
    </p>
    <Platsfragor fragor={fragor} lankar={lankar} />
    <h2 id="organisationer">Organisationer</h2>
    <div class="rutnat">
      {plats.organisationer.map((o) => <OrgKort org={o} visaPlats={false} />)}
    </div>
    <p class="meta mt-3">Saknas någon? <a href={url('/bidra')}>Lägg till en organisation.</a> Alla data: <a href={url('/data')}>CC BY 4.0</a>.</p>
  </section>
</Bas>

<style>
  .ingress {
    font-size: 18px;
    max-width: 62ch;
  }
</style>
