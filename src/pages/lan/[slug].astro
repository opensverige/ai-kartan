---
import Bas from '../../layouts/Bas.astro';
import OrgKort from '../../components/OrgKort.astro';
import Platsfragor from '../../components/Platsfragor.astro';
import Lankarta from '../../components/Lankarta.astro';
import { hamtaData, hamtaPlatsamnen, amnesstig, platsfragedata, url, absolutUrl } from '../../lib/data';
import { MAX_NAMN, faqSchema, platsfragor } from '../../lib/platsamne';
import { brodsmulor } from '../../lib/meta';
import { antal } from '../../lib/text';
import { lanritning } from '../../lib/delningsbild';
import { SIDKARTA, lanunderlag } from '../../lib/lanunderlag';
import { bildtext, hittillsBelagda, lancitat, tipsfraga } from '../../lib/lantext';
import type { Plats } from '../../lib/data';

export function getStaticPaths() {
  return hamtaData().platser.lan.map((p) => ({ params: { slug: p.slug }, props: { plats: p } }));
}
interface Props {
  plats: Plats;
}
const { plats } = Astro.props;
const d = hamtaData();
const n = plats.organisationer.length;
const kommuner = d.platser.kommuner.filter((k) => k.lan_kod === plats.kod);
const rubrik = `AI i ${plats.namn}`;
// Titeln följer hur folk söker. Finns inga bolag i länet lovar den inga.
const titel = plats.organisationer.some((o) => o.type.value === 'bolag') ? `AI-bolag och organisationer i ${plats.namn}` : `Organisationer som bygger AI i ${plats.namn}`;
const underlag = platsfragedata(plats);
// Första frågan besvaras av ingressen. De andra står under den, var och en med sin rubrik.
const [vilka, ...fragor] = platsfragor(underlag);
const lankar = {
  omraden: hamtaPlatsamnen()
    .lan.filter((a) => a.plats === plats)
    .sort((a, b) => b.organisationer.length - a.organisationer.length)
    .map((a) => ({ text: `${d.etikett.omraden.get(a.omrade)?.label ?? a.omrade} · ${a.organisationer.length}`, href: url(amnesstig(a)) })),
  offentliga: underlag.offentliga
    .filter((o) => o.namn.length > MAX_NAMN)
    .map((o) => ({ text: `Alla ${o.plural.toLowerCase()} i ${plats.namn}`, href: url(`/organisationer?typ=${o.slag}&lan=${plats.kod}`) })),
  kontroll: [{ text: 'Metod och status', href: url('/metod') }],
};
const underlagKarta = lanunderlag(plats);
const karta = lanritning(plats.kod, underlagKarta.prickar, SIDKARTA);
const bild = `/bild/lan/${plats.slug}.png`;
const bildAlt = bildtext(n, plats.namn, karta.prickar, underlagKarta.lage);
const citat = lancitat(n, plats.namn, underlagKarta.lage, absolutUrl(`/lan/${plats.slug}`));
const beskrivning = `${antal(n, 'organisation', 'organisationer')} som bygger AI i ${plats.namn}${kommuner.length > 1 ? `, fördelade på ${kommuner.length} kommuner` : ''}. Med källa och datum på varje uppgift.`;
const samling = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: rubrik,
  description: beskrivning,
  url: absolutUrl(`/lan/${plats.slug}`),
  about: { '@type': 'AdministrativeArea', name: plats.namn, containedInPlace: { '@type': 'Country', name: 'Sverige' } },
};
const jsonLd = [
  samling,
  faqSchema([vilka, ...fragor]),
  brodsmulor([
    ['Platser', absolutUrl('/plats')],
    [plats.namn, absolutUrl(`/lan/${plats.slug}`)],
  ]),
];
---

<Bas titel={titel} beskrivning={beskrivning} stig={`/lan/${plats.slug}`} jsonLd={jsonLd} bild={bild} bildAlt={bildAlt} bildNyckel={underlagKarta.bildnyckel}>
  <section class="ram sektion">
    <nav class="meta" aria-label="Du är här"><a href={url('/plats')}>Platser</a> › <span>{plats.namn}</span></nav>
    <div class="lanhuvud">
      <div>
        <p class="kicker mt-2">Län</p>
        <h1>{rubrik}</h1>
        <p class="ingress">{vilka.svar} De finns i {antal(kommuner.length, 'kommun', 'kommuner')}.</p>
        <p class="rad">
          <a class="knapp knapp--liten" href={url(`/?lan=${plats.kod}`)}>Visa på kartan</a>
          <a class="knapp knapp--ghost knapp--liten" href={url(`/organisationer?lan=${plats.kod}`)}>Filtrera listan</a>
        </p>
      </div>
      <figure class="lanhuvud__karta">
        <Lankarta karta={karta} namn={plats.namn} />
        <figcaption>
          <p class="lanhuvud__antal">{hittillsBelagda(n)}. Läget {underlagKarta.lage}.</p>
          <p class="meta">En prick per kommun, ingen adress. {tipsfraga(plats.namn)} <a class="lanhuvud__tips" href={url('/bidra')}>Tipsa oss</a></p>
        </figcaption>
      </figure>
    </div>
    <Platsfragor fragor={fragor} lankar={lankar} />
    <section class="citera" aria-labelledby="citera">
      <h2 id="citera">Citera och dela</h2>
      <p class="lasbredd">För en artikel, en rapport eller en lektion. Antalet gäller dagen i citatet. Datan får användas fritt med källan utskriven, enligt CC BY 4.0.</p>
      <pre class="citat">{citat}</pre>
      <p class="rad">
        <button type="button" class="knapp knapp--ghost knapp--liten ej-utskrift" id="kopiera" data-text={citat}>Kopiera citatet</button>
        <a class="knapp knapp--ghost knapp--liten" href={url(bild)} download={`ai-i-${plats.slug}.png`}>Ladda ner bilden</a>
      </p>
    </section>
    <h2 id="kommuner">Kommuner</h2>
    <ul class="rad kommunlista">
      {kommuner.map((k) => (
        <li><a class="tagg" href={url(`/plats/${k.slug}`)}>{k.namn} · {k.organisationer.length}</a></li>
      ))}
    </ul>
    <h2 id="organisationer">Organisationer</h2>
    <div class="rutnat">
      {plats.organisationer.map((o) => <OrgKort org={o} />)}
    </div>
  </section>
</Bas>

<script>
  const knapp = document.getElementById('kopiera') as HTMLButtonElement | null;
  knapp?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(knapp.dataset.text || '');
      knapp.textContent = 'Kopierat';
      setTimeout(() => (knapp.textContent = 'Kopiera citatet'), 1800);
    } catch {
      /* utan clipboard-API får användaren markera texten själv */
    }
  });
</script>

<style>
  /* Rubriken till vänster och kartan till höger. I telefon står kartan under knapparna. */
  .lanhuvud {
    display: grid;
    gap: 24px 48px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .lanhuvud {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 400px);
    }
  }
  .lanhuvud__karta {
    margin: 0;
  }
  .lanhuvud__karta figcaption {
    margin-top: 12px;
  }
  .lanhuvud__karta figcaption p {
    margin: 0 0 4px;
  }
  .lanhuvud__antal {
    font-weight: 600;
  }
  .lanhuvud__tips {
    white-space: nowrap;
  }
  .citera {
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid hsl(var(--rule-soft));
  }
  .citat {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .ingress {
    font-size: 18px;
    max-width: 62ch;
  }
  .kommunlista {
    list-style: none;
    padding: 0;
  }
</style>
