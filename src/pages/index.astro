---
import Bas from '../layouts/Bas.astro';
import KartApp from '../components/KartApp.astro';
import { hamtaData, SAJT, url, formateraDatum } from '../lib/data';

const d = hamtaData();
const s = d.statistik;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Tech Embassy – Sveriges öppna AI-karta',
  description: 'Öppen, oberoende karta över organisationer som bygger AI i Sverige. Varje uppgift har källa, datum och verifieringsstatus.',
  url: import.meta.env.SITE,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  creator: { '@type': 'Organization', name: 'OpenSverige', url: SAJT.opensverige },
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${import.meta.env.SITE}${url('/api/data.json')}` },
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `${import.meta.env.SITE}${url('/api/data.csv')}` },
    { '@type': 'DataDownload', encodingFormat: 'application/geo+json', contentUrl: `${import.meta.env.SITE}${url('/api/data.geojson')}` },
  ],
};
---

<Bas titel={`${SAJT.titel} | ${SAJT.namn}`} helTitel beskrivning={`${SAJT.tagline} ${s.antal} organisationer med källa och datum på varje uppgift. Ingen rankning, inga betalplatser.`} stig="/" bred jsonLd={jsonLd}>
  <section class="hero">
    <div class="ram ram--bred">
      <p class="kicker">Tech Embassy · oberoende, inte statlig · <a href={url('/metod')}>källa och datum på varje uppgift</a></p>
      <h1>Alla som bygger <em>AI</em> i Sverige.</h1>
      <p class="hero__lead">
        Inte bara de som en kommitté har godkänt. Soloutvecklaren, föreningen, kommunen och lärosätet syns bredvid bolagen.
        Inget rankas och ingen kan köpa en plats. <a href={url('/bidra')}>Lägg till dig själv med en pull request.</a>
      </p>
      <dl class="nyckeltal">
        <div><dt>Organisationer</dt><dd>{s.antal}</dd></div>
        <div><dt>Med minst ett bekräftat fält</dt><dd>{s.andel_med_bekraftat} %</dd></div>
        <div><dt>Kommuner</dt><dd>{d.platser.kommuner.length}</dd></div>
        <div><dt>Senast verifierad</dt><dd>{formateraDatum(s.senast_verifierad)}</dd></div>
      </dl>
    </div>
  </section>

  <section class="ram ram--bred">
    <KartApp lage="karta" />
  </section>

  <section class="ram sektion">
    <div class="tre">
      <div>
        <h2 class="mt-0">Tre kriterier, inga undantag</h2>
        <p>Svensk koppling, något byggt med AI bakom en publik länk, och att organisationen finns på riktigt. Inga krav på storlek, ålder, bolagsform eller finansiering. <a href={url('/kriterier')}>Läs kriterierna.</a></p>
      </div>
      <div>
        <h2 class="mt-0">Varje uppgift bär bevis</h2>
        <p>Bekräftad, egen uppgift, planerad eller okänd. Källan och datumet står bredvid värdet, och varje ändring loggas öppet. <a href={url('/metod')}>Så arbetar vi.</a></p>
      </div>
      <div>
        <h2 class="mt-0">Öppen kod, öppen data</h2>
        <p>Hela datasetet som JSON, CSV och GeoJSON under CC BY 4.0. Koden under AGPL-3.0. Forka, bygg vidare, citera. <a href={url('/data')}>Ladda ner.</a></p>
      </div>
    </div>
  </section>
</Bas>

<style>
  .hero {
    padding: 36px 0 22px;
  }
  .hero h1 {
    font-size: clamp(40px, 7.5vw, 84px);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 14ch;
    margin: 10px 0 14px;
  }
  .hero h1 em {
    font-style: normal;
    color: hsl(var(--moss));
  }
  .hero__lead {
    font-size: 18px;
    max-width: 62ch;
  }
  .nyckeltal {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin: 18px 0 0;
  }
  .nyckeltal div {
    display: flex;
    flex-direction: column-reverse;
  }
  .nyckeltal dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: hsl(var(--ink-mute));
  }
  .nyckeltal dd {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    color: hsl(var(--ink));
    letter-spacing: -0.02em;
  }
  .tre {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .tre h2 {
    font-size: 20px;
  }
  @media (max-width: 860px) {
    .tre {
      grid-template-columns: 1fr;
    }
  }
</style>
