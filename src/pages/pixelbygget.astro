---
// Pixelbygget: pixelstäderna ritas ruta för ruta av frivilliga med eget grafikkort. Sidan visar
// vilka rutor som är byggda, vilka som byggs och vilka som är lediga, och hur man tar en.
// Rutnätet kommer från rut-tjänsten, bilderna från bildtjänsten. Se src/lib/pixelbygget/.
import Bas from '../layouts/Bas.astro';

const TJANST = import.meta.env.PUBLIC_PIXELBYGGET_URL || 'https://pixelbygget.gustaf-garnow.workers.dev';
const BILDER = import.meta.env.PUBLIC_PIXELKARTA_URL || '';
const REPO = 'https://github.com/opensverige/karta.opensverige-3d';
---

<Bas
  titel="Pixelbygget"
  beskrivning="Pixelstäderna på AI-kartan ritas ruta för ruta av frivilliga med eget grafikkort. Se vilka rutor som är byggda och ta en ledig."
  stig="/pixelbygget"
  app
  hoppaFilter={false}
>
  <div class="bygge" data-bygge data-tjanst={TJANST} data-bilder={BILDER}>
    <div class="bygge__karta" data-karta aria-label="Pixelstaden med rutnät. Klicka på en ruta."></div>
    <canvas class="bygge__rutnat" data-rutnat aria-hidden="true"></canvas>

    <section class="bygge__panel" aria-label="Pixelbygget">
      <p class="kicker">Pixelbygget</p>
      <h1>Bygg staden</h1>
      <p class="bygge__ingress">Städerna ritas ruta för ruta, av frivilliga. Ta en ledig ruta.</p>
      <div class="bygge__stader" data-stader></div>
      <div data-rakning></div>
      <button class="knapp knapp--liten" type="button" data-nasta>Visa en ledig ruta →</button>
      <ul class="bygge__forklaring">
        <li><span class="bygge__prov bygge__prov--live" aria-hidden="true"></span><span><b>Tänd.</b> På kartan, med byggarens namn.</span></li>
        <li><span class="bygge__prov bygge__prov--vantar" aria-hidden="true"></span><span><b>Väntar.</b> Uppladdad, granskas av en människa.</span></li>
        <li><span class="bygge__prov bygge__prov--last" aria-hidden="true"></span><span><b>Låst.</b> Någon bygger den just nu.</span></li>
        <li><span class="bygge__prov bygge__prov--fri" aria-hidden="true"></span><span><b>Ledig.</b> Klicka för att ta den.</span></li>
      </ul>
      <div data-topplista></div>
      <p class="bygge__kallor">
        Göteborg ritas från Göteborgs Stads flygfoto och höjdmodell (CC0) och
        <a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap</a> (ODbL).
        <a href={`${REPO}#readme`} rel="noopener">Så fungerar bygget</a>.
      </p>
    </section>

    <div class="bygge__zoom">
      <button type="button" data-in aria-label="Zooma in">+</button>
      <button type="button" data-ut aria-label="Zooma ut">−</button>
    </div>

    <p class="bygge__besked" data-besked role="status" hidden></p>
    <section class="bygge__blad" data-ruta aria-label="Vald ruta" aria-live="polite" hidden></section>
  </div>
</Bas>

<script>
  import { startaBygge } from '../lib/pixelbygget/bygge';

  const rot = document.querySelector<HTMLElement>('[data-bygge]');
  if (rot) void startaBygge({ el: rot, tjanst: rot.dataset.tjanst ?? '', bilder: rot.dataset.bilder || undefined });
</script>

<style is:global>
  .bygge {
    position: relative;
    height: 100%;
    background: #f2eee5;
    overflow: hidden;
  }
  .bygge__karta,
  .bygge__rutnat {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bygge__rutnat {
    pointer-events: none;
  }
  .bygge__panel,
  .bygge__blad {
    position: absolute;
    top: 16px;
    width: 340px;
    max-height: calc(100% - 32px);
    overflow-y: auto;
    box-sizing: border-box;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: hsl(var(--yta-kort));
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-kort);
    box-shadow: var(--skugga-flyt);
  }
  .bygge__panel {
    left: 16px;
  }
  .bygge__blad {
    right: 16px;
    width: 360px;
  }
  .bygge__blad[hidden] {
    display: none;
  }
  .bygge p,
  .bygge h1,
  .bygge h2,
  .bygge h3,
  .bygge ul,
  .bygge ol {
    margin: 0;
  }
  .bygge h1 {
    font-size: 28px;
    line-height: 1.1;
  }
  .bygge__ingress {
    font-size: 15px;
    color: hsl(var(--ink-soft));
  }
  .bygge__stader {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .bygge__stad {
    padding: 8px 14px;
    border-radius: var(--r-pill);
    background: hsl(var(--yta-chip));
    color: hsl(var(--ink-soft));
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .bygge__stad[aria-current] {
    background: hsl(var(--ink));
    color: #fff;
    font-weight: 600;
  }
  .bygge__tal {
    font-size: 15px;
    color: hsl(var(--ink-soft));
  }
  .bygge__tal strong {
    font-size: 36px;
    line-height: 1;
    color: hsl(var(--moss));
    margin-right: 6px;
  }
  .bygge__matare {
    height: 8px;
    margin-top: 8px;
    border-radius: var(--r-pill);
    background: hsl(var(--yta-chip));
    overflow: hidden;
  }
  .bygge__matare div {
    height: 100%;
    background: hsl(var(--moss));
  }
  .bygge__nu {
    margin-top: 8px !important;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: hsl(var(--ink-mute));
  }
  .bygge [data-nasta] {
    align-self: flex-start;
    min-height: 44px;
  }
  .bygge__forklaring,
  .bygge__topp {
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    color: hsl(var(--ink-soft));
  }
  .bygge__forklaring li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .bygge__forklaring b {
    color: hsl(var(--ink));
    font-weight: 600;
  }
  .bygge__prov {
    flex: none;
    width: 20px;
    height: 20px;
    box-sizing: border-box;
  }
  .bygge__prov--live {
    border: 2px solid hsl(var(--moss));
    background: hsl(120 30% 45%);
  }
  .bygge__prov--vantar {
    border: 2px solid hsl(var(--amber));
    background: repeating-linear-gradient(45deg, hsl(var(--amber) / 0.55) 0 4px, hsl(var(--yta-kort)) 4px 8px);
  }
  .bygge__prov--last {
    border: 2px dashed hsl(var(--rust));
    background: hsl(var(--rust) / 0.16);
  }
  .bygge__prov--fri {
    border: 1px solid hsl(var(--ink) / 0.4);
    background: #e9e5db;
  }
  .bygge__rubrik {
    font-size: 15px;
    font-weight: 600;
  }
  .bygge__topp {
    margin-top: 8px !important;
  }
  .bygge__topp li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .bygge__namn {
    font-family: var(--font-mono);
    font-size: 13px;
    color: hsl(var(--ink));
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bygge__antal {
    flex: none;
    color: hsl(var(--ink-mute));
  }
  .bygge__tomt,
  .bygge__kallor,
  .bygge__fot,
  .bygge__sjalv {
    font-size: 13px;
    line-height: 1.45;
    color: hsl(var(--ink-mute));
  }
  .bygge__zoom {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bygge__zoom button,
  .bygge__stang {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-btn);
    background: hsl(var(--yta-kort));
    color: hsl(var(--ink));
    font: 600 18px/1 var(--font-sans);
    cursor: pointer;
    box-shadow: var(--skugga-flyt);
  }
  .bygge__stang {
    padding: 0 12px;
    font-size: 13.5px;
    box-shadow: none;
  }
  .bygge__besked {
    position: absolute;
    left: 50%;
    bottom: 16px;
    transform: translateX(-50%);
    max-width: min(90%, 460px);
    padding: 10px 16px;
    border-radius: var(--r-btn);
    background: hsl(var(--ink));
    color: #fff;
    font-size: 14px;
  }
  .bygge__bladhuvud {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .bygge__bladhuvud > div {
    flex: 1;
  }
  .bygge__rutnamn {
    font-size: 24px;
    line-height: 1.15;
  }
  .bygge__lage {
    padding: 6px 12px;
    border-radius: var(--r-pill);
    border: 1.5px solid hsl(var(--ink-mute));
    font-size: 13px;
    font-weight: 600;
    color: hsl(var(--ink-soft));
  }
  .bygge__lage--fri,
  .bygge__lage--live,
  .bygge__lage--godkand {
    border-color: hsl(var(--moss));
    color: hsl(var(--moss));
  }
  .bygge__lage--live {
    background: hsl(var(--moss));
    color: #fff;
  }
  .bygge__lage--vantar {
    border-color: hsl(var(--amber));
    color: hsl(var(--amber));
  }
  .bygge__lage--last {
    border-color: hsl(var(--rust));
    color: hsl(var(--rust));
  }
  .bygge__mening,
  .bygge__vem {
    font-size: 15px;
    color: hsl(var(--ink-soft));
  }
  .bygge__krav {
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    color: hsl(var(--ink-soft));
  }
  .bygge__kod {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border-radius: var(--r-ruta);
    background: hsl(var(--ink));
    color: hsl(var(--yta));
  }
  .bygge code {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  .bygge__sjalv code {
    font-size: 12px;
    color: hsl(var(--ink));
  }
  .bygge__kopiera {
    align-self: flex-start;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--r-btn);
    border: 1px solid hsl(var(--yta) / 0.5);
    background: transparent;
    color: hsl(var(--yta));
    font: 600 14px/1 var(--font-sans);
    cursor: pointer;
  }
  .bygge__repo {
    justify-content: center;
    min-height: 48px;
    font-size: 16px;
  }
  .bygge :is(button, a):focus-visible {
    outline: 3px solid hsl(var(--link));
    outline-offset: 2px;
  }

  /* Smal skärm: panelen blir en rad överst, och bladet för en vald ruta kommer nerifrån. */
  @media (max-width: 900px) {
    .bygge__panel {
      top: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: none;
      padding: 12px 14px;
      gap: 8px;
    }
    .bygge__panel h1 {
      font-size: 20px;
    }
    .bygge__panel .kicker,
    .bygge__ingress,
    .bygge__forklaring,
    .bygge__kallor,
    .bygge [data-topplista] {
      display: none;
    }
    .bygge__tal strong {
      font-size: 22px;
    }
    .bygge__blad {
      top: auto;
      right: 0;
      left: 0;
      bottom: 0;
      width: auto;
      max-height: 62%;
      border-radius: var(--r-kort) var(--r-kort) 0 0;
    }
    .bygge__zoom {
      display: none;
    }
  }
</style>
