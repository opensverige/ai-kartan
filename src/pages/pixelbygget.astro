---
// Rita kartan: sajtens karta över Sverige, med pixelstäderna och rutnätet ovanpå. Frivilliga
// ritar det som saknas, ruta för ruta, var som helst i Sverige. Rutnätet kommer från rut-tjänsten,
// bilderna från bildtjänsten. Se src/lib/pixelbygget/.
import 'maplibre-gl/dist/maplibre-gl.css';
import Bas from '../layouts/Bas.astro';
import { url } from '../lib/data';

const TJANST = import.meta.env.PUBLIC_PIXELBYGGET_URL || 'https://pixelbygget.gustaf-garnow.workers.dev';
const BILDER = import.meta.env.PUBLIC_PIXELKARTA_URL || '';
const REPO = 'https://github.com/opensverige/karta.opensverige-3d';
---

<Bas
  titel="Rita kartan"
  beskrivning="Pixelkartan ritas ruta för ruta av frivilliga med eget grafikkort. Hitta din ort, välj en ledig ruta och låt din AI-agent rita den."
  stig="/pixelbygget"
  app
  hoppaFilter={false}
>
  <div class="byggkarta" data-byggkarta data-tjanst={TJANST} data-bilder={BILDER} data-worker={url('/vendor/maplibre/maplibre-gl-worker.mjs')}>
    <div class="byggkarta__karta" data-karta aria-label="Karta över Sverige med pixelstäderna och rutnätet. Klicka på en ruta."></div>

    <section class="byggkarta__panel" aria-label="Rita kartan">
      <p class="kicker">Tech Embassy Pixel</p>
      <h1>Rita kartan</h1>
      <p class="byggkarta__ingress">Frivilliga ritar det som saknas, ruta för ruta. Var som helst i Sverige.</p>
      <form class="byggkarta__sok" data-sok role="search">
        <label for="byggkarta-sokfalt">Hitta din ort</label>
        <div class="byggkarta__sokrad">
          <input id="byggkarta-sokfalt" data-sokfalt type="search" placeholder="Till exempel Eslöv" autocomplete="off" />
          <button type="submit">Hitta →</button>
        </div>
      </form>
      <p class="byggkarta__zoomtips" data-zoomtips>Zooma in, så syns rutorna. Klicka på en ledig ruta.</p>
      <ul class="byggkarta__forklaring">
        <li><span class="byggkarta__prov byggkarta__prov--live" aria-hidden="true"></span><span><b>Ritad.</b> Finns på kartan, med byggarens namn.</span></li>
        <li><span class="byggkarta__prov byggkarta__prov--godkand" aria-hidden="true"></span><span><b>Godkänd.</b> Syns vid nästa uppdatering.</span></li>
        <li><span class="byggkarta__prov byggkarta__prov--vantar" aria-hidden="true"></span><span><b>Granskas.</b> En människa tittar på den.</span></li>
        <li><span class="byggkarta__prov byggkarta__prov--last" aria-hidden="true"></span><span><b>Upptagen.</b> Någon ritar den just nu.</span></li>
        <li><span class="byggkarta__prov byggkarta__prov--fri" aria-hidden="true"></span><span><b>Ledig.</b> Klicka för att ta den.</span></li>
      </ul>
      <p class="byggkarta__kallor">
        Göteborg ritas från Göteborgs Stads flygfoto (CC0), resten från Googles 3D-bilder genom byggarens eget Cesium-konto.
        Orter hittas med <a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap</a>.
      </p>
      <p class="byggkarta__kallor">
        <a href={`${REPO}#what-you-need`} rel="noopener">Vad som krävs för att rita</a>.
        <a href={`${REPO}/blob/main/AGENTS.md`} rel="noopener">Så gör agenten</a>.
      </p>
    </section>

    <section class="byggkarta__ruta" data-ruta aria-label="Vald ruta" aria-live="polite" hidden></section>
    <p class="byggkarta__besked" data-besked role="status" hidden></p>
  </div>
</Bas>

<script>
  import { startaByggkarta } from '../lib/pixelbygget/byggkarta';

  const rot = document.querySelector<HTMLElement>('[data-byggkarta]');
  if (rot) {
    void startaByggkarta({
      el: rot,
      tjanst: rot.dataset.tjanst ?? '',
      bilder: rot.dataset.bilder || undefined,
      worker: rot.dataset.worker || undefined,
    });
  }
</script>

<style is:global>
  .byggkarta {
    position: relative;
    height: 100%;
    background: #f2eee5;
    overflow: hidden;
  }
  .byggkarta__karta {
    position: absolute;
    inset: 0;
  }
  /* Märket i kartans hörn leder hit. Här, på sidan det leder till, behövs det inte. */
  .byggkarta .skaparmarke {
    display: none !important;
  }
  .byggkarta__panel,
  .byggkarta__ruta {
    position: absolute;
    top: 16px;
    z-index: 4;
    box-sizing: border-box;
    width: 340px;
    max-height: calc(100% - 32px);
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: hsl(var(--yta-kort));
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-kort);
    box-shadow: var(--skugga-flyt);
  }
  .byggkarta__panel {
    left: 16px;
  }
  .byggkarta__ruta {
    right: 16px;
    width: 360px;
  }
  .byggkarta__ruta[hidden] {
    display: none;
  }
  .byggkarta p {
    margin: 0;
  }
  .byggkarta h1 {
    font-size: 28px;
    line-height: 1.1;
    margin: 0;
  }
  .byggkarta h2 {
    font-size: 22px;
    line-height: 1.15;
    margin: 2px 0 0;
  }
  .byggkarta__ingress {
    font-size: 15px;
    color: hsl(var(--ink-soft));
  }
  .byggkarta__sok {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .byggkarta__sok label {
    font-size: 13px;
    font-weight: 600;
  }
  .byggkarta__sokrad {
    display: flex;
    gap: 6px;
  }
  .byggkarta__sokrad input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-btn);
    background: hsl(var(--yta));
    color: hsl(var(--ink));
    font: 15px var(--font-sans);
  }
  .byggkarta__sokrad button,
  .byggkarta__kopiera {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid hsl(var(--moss));
    border-radius: var(--r-btn);
    background: hsl(var(--moss));
    color: #fff;
    font: 600 14px var(--font-sans);
    cursor: pointer;
  }
  .byggkarta__kopiera {
    align-self: flex-start;
  }
  .byggkarta__zoomtips {
    font-size: 14px;
    color: hsl(var(--ink-mute));
  }
  .byggkarta__zoomtips[hidden] {
    display: none;
  }
  .byggkarta__forklaring {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13.5px;
  }
  .byggkarta__forklaring li {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .byggkarta__prov {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1.5px solid hsl(45 17% 20% / 0.45);
  }
  .byggkarta__prov--live {
    background: hsl(120 24% 35% / 0.35);
    border-color: hsl(120 24% 35% / 0.6);
  }
  .byggkarta__prov--godkand {
    background: hsl(170 40% 30% / 0.45);
  }
  .byggkarta__prov--vantar {
    background: hsl(38 74% 40% / 0.5);
  }
  .byggkarta__prov--last {
    background: hsl(25 60% 45% / 0.55);
  }
  .byggkarta__kallor {
    font-size: 12.5px;
    color: hsl(var(--ink-mute));
  }
  .byggkarta__rutahuvud {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .byggkarta__stang {
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid hsl(var(--kant));
    border-radius: var(--r-btn);
    background: hsl(var(--yta-kort));
    color: hsl(var(--ink));
    font: 600 13.5px var(--font-sans);
    cursor: pointer;
  }
  .byggkarta__lage {
    font-size: 15px;
  }
  .byggkarta__byggare,
  .byggkarta__not {
    font-size: 13.5px;
    color: hsl(var(--ink-mute));
  }
  .byggkarta__agentrad {
    padding: 10px 12px;
    border-radius: var(--r-btn);
    background: hsl(var(--yta-chip));
    font: 12.5px/1.45 var(--font-mono);
    overflow-wrap: anywhere;
  }
  .byggkarta__byggare a {
    color: hsl(var(--ink));
    font-weight: 600;
  }
  .byggkarta__fler {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid hsl(var(--kant));
  }
  .byggkarta__fler[open] {
    gap: 10px;
  }
  .byggkarta__fler summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    min-height: 32px;
    display: flex;
    align-items: center;
    list-style: none;
  }
  .byggkarta__fler summary::-webkit-details-marker {
    display: none;
  }
  .byggkarta__fler summary::after {
    content: ' →';
    margin-left: 4px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .byggkarta__fler[open] summary::after {
    transform: rotate(90deg);
  }
  .byggkarta__fler > :not(summary) {
    margin-top: 8px;
  }
  .byggkarta__underrubrik {
    font-size: 13px;
    font-weight: 600;
    margin-top: 4px !important;
  }
  .byggkarta__krav {
    margin: 0;
    padding-left: 1.1em;
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 13.5px;
    color: hsl(var(--ink-soft));
  }
  .byggkarta__besked {
    position: absolute;
    left: 50%;
    bottom: 16px;
    z-index: 5;
    transform: translateX(-50%);
    max-width: min(90%, 460px);
    padding: 10px 16px;
    border-radius: var(--r-btn);
    background: hsl(var(--ink));
    color: #fff;
    font-size: 14px;
  }
  .byggkarta :is(button, a, input):focus-visible {
    outline: 2px solid hsl(var(--rust));
    outline-offset: 2px;
  }
  @media (max-width: 760px) {
    .byggkarta__panel {
      top: 8px;
      left: 8px;
      right: 8px;
      width: auto;
      max-height: 46%;
      padding: 12px 14px;
      gap: 8px;
    }
    .byggkarta__panel .kicker,
    .byggkarta__ingress,
    .byggkarta__forklaring,
    .byggkarta__kallor {
      display: none;
    }
    .byggkarta h1 {
      font-size: 20px;
    }
    .byggkarta__ruta {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      max-height: 62%;
      border-radius: var(--r-kort) var(--r-kort) 0 0;
    }
  }
</style>
